        def on_api_key(self, _b):
            acc = self.acc
            if not acc:
                return
            d = Gtk.Dialog(title=f'Own Google client ID — {acc}', transient_for=self, modal=True)
            d.set_default_size(560, -1)
            box = d.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            box.add(Gtk.Label(use_markup=True, xalign=0, wrap=True, label=(
                'Without its own key, this account uses rclone\'s <b>shared</b> Google key. '
                'All rclone users share its request limit (syncs stop with “quota exceeded”), '
                'and Google is retiring it during 2026.\n\n'
                '<b>Make your own (free, ~5 min)</b> — an <b>OAuth client ID</b>, not an “API key”:\n'
                '1. Open the Google Cloud console (button below), create a project, e.g. '
                '“zorro-drive”, and select it.\n'
                '2. APIs &amp; Services → Library → <b>Google Drive API</b> → Enable.\n'
                '3. Google Auth Platform → Get started: app name, your email, audience '
                '<b>Internal</b> (Workspace) or External + yourself as test user.\n'
                '4. Google Auth Platform → Clients → Create client → <b>Desktop app</b>.\n'
                '5. Paste the client ID and secret here. Firefox then asks you to sign in once '
                'more.')))
            link = Gtk.LinkButton(uri='https://console.cloud.google.com/apis/credentials',
                                  label='Open Google Cloud console', halign=Gtk.Align.START)
            box.add(link)
            cid = Gtk.Entry(placeholder_text='Client ID  (…apps.googleusercontent.com)')
            sec = Gtk.Entry(placeholder_text='Client secret', visibility=False)
            box.add(cid)
            box.add(sec)
            msg = Gtk.Label(xalign=0, wrap=True, selectable=True)
            box.add(msg)
            d.add_button('Cancel', Gtk.ResponseType.CANCEL)
            ok = d.add_button('Save and sign in', Gtk.ResponseType.OK)
            ok.get_style_context().add_class('suggested-action')
            d.show_all()
            proc = None
            resp = d.run()
            while resp == Gtk.ResponseType.OK:
                c, k = cid.get_text().strip(), sec.get_text().strip()
                if not c.endswith('.apps.googleusercontent.com') or not k:
                    msg.set_text('The client ID ends in .apps.googleusercontent.com, '
                                 'and the secret is needed too.')
                else:
                    ok.set_sensitive(False)
                    msg.set_text('Waiting for Google sign-in in Firefox…')
                    # new key = new sign-in; rclone opens the browser (config_refresh_token)
                    proc = subprocess.Popen(['rclone', 'config', 'update', acc,
                                             f'client_id={c}', f'client_secret={k}',
                                             'config_refresh_token=true'],
                                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                            text=True)

                    def done(out, err, proc=proc):
                        if proc.returncode:
                            msg.set_text('Failed: ' + (out or '').strip()[-300:])
                            ok.set_sensitive(True)
                            return
                        d.response(Gtk.ResponseType.CLOSE)
                    in_thread(lambda proc=proc: proc.communicate()[0], done)
                resp = d.run()
            if proc and proc.poll() is None:
                proc.terminate()
            d.destroy()
            if resp == Gtk.ResponseType.CLOSE:
                systemctl('try-restart', f'zorro-drive-mount@{acc}.service')
                self.update_key_warning()

        def update_key_warning(self):
            acc = self.acc
            self.key_btn.set_sensitive(bool(acc))
            shared = bool(acc) and not rclone_value(acc, 'client_id')
            self.key_warn.set_markup('<small>⚠ This account uses rclone\'s shared Google key: '
                                     'set your own to avoid “quota exceeded”.</small>'
                                     if shared else '')

        def on_add_account(self, _b):
            dlg = AddAccount(self)
            proc = None
            resp = dlg.run()
            while resp == Gtk.ResponseType.OK:
                name = dlg.name.get_text().strip()
                if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,30}', name):
                    dlg.msg.set_text('Use letters, digits, - or _ (no spaces).')
                elif any(a['name'] == name for a in load()['accounts']):
                    dlg.msg.set_text('That name is already used.')
                else:
                    dlg.ok.set_sensitive(False)
                    dlg.msg.set_text('Waiting for Google sign-in in Firefox…')
                    # rclone opens the browser and waits for Google's answer on localhost
                    proc = subprocess.Popen(['rclone', 'config', 'create', name, 'drive', 'scope=drive'],
                                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

                    def done(out, err, dlg=dlg, name=name, proc=proc):
                        if proc.returncode:
                            dlg.msg.set_text('Sign-in failed: ' + (out or '').strip()[-300:])
                            dlg.ok.set_sensitive(True)
                            return
                        cfg = load()
                        cfg['accounts'].append({'name': name})
                        save(cfg)
                        dlg.response(Gtk.ResponseType.CLOSE)
                    in_thread(lambda proc=proc: proc.communicate()[0], done)
                resp = dlg.run()
            if proc and proc.poll() is None:
                proc.terminate()            # cancelled while waiting for Google
            dlg.destroy()
            if resp == Gtk.ResponseType.CLOSE:
                self.reload_accounts(select=load()['accounts'][-1]['name'])

        def remove_account(self, acc):
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  buttons=Gtk.ButtonsType.OK_CANCEL,
                                  text=f'Remove account "{acc}"?',
                                  secondary_text='Its folders stop syncing. Files on this laptop and '
                                                 'on Drive stay where they are.')
            if d.run() == Gtk.ResponseType.OK:
                systemctl('disable', '--now', f'zorro-drive-mount@{acc}.service')
                cfg = load()
                cfg['accounts'] = [a for a in cfg['accounts'] if a['name'] != acc]
                cfg['folders'] = [f for f in cfg['folders'] if f['account'] != acc]
                save(cfg)
                subprocess.run(['rclone', 'config', 'delete', acc], capture_output=True)
                self.reload_accounts()
            d.destroy()

