        def remove_folder(self, f):
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  buttons=Gtk.ButtonsType.OK_CANCEL,
                                  text=f'Stop syncing {folder_title(f)}?',
                                  secondary_text=f"The files stay on Drive and in {f['local']}.")
            if d.run() == Gtk.ResponseType.OK:
                cfg = load()
                cfg['folders'] = [x for x in cfg['folders'] if x['id'] != f['id']]
                save(cfg)
                shutil.rmtree(STATE / f['id'], ignore_errors=True)
                self.show_folders(self.acc)
            d.destroy()

        def on_add_folder(self, _b):
            mine = self.folders_of(self.acc)
            dlg = ChooseFolders(self, self.acc, mine)
            while dlg.run() == Gtk.ResponseType.OK:
                cfg = load()
                keep = [f for f in mine if (f.get('drive') or '', f['path']) in dlg.checked]
                drop = [f for f in mine if f not in keep]
                have = {(f.get('drive') or '', f['path']) for f in keep}
                add = [{'id': uuid.uuid4().hex[:8], 'account': self.acc, 'drive': d or None,
                        'drive_name': n or None, 'path': p,
                        'local': dlg.new_local(d, n, p), 'enabled': True}
                       for (d, p), n in sorted(dlg.checked.items()) if (d, p) not in have]
                others = [f for f in cfg['folders'] if f['account'] != self.acc] + keep
                problem = None
                for f in add:
                    lp = local_path(f).resolve()
                    clash = next((x for x in others + [y for y in add if y is not f]
                                  if lp == local_path(x).resolve()
                                  or lp in local_path(x).resolve().parents
                                  or local_path(x).resolve() in lp.parents), None)
                    if not str(lp).startswith(str(HOME) + '/'):
                        problem = 'Choose a place inside your home folder.'
                    elif clash and clash not in drop:
                        problem = (f"{folder_title(f)} would go in {f['local']}, which overlaps "
                                   f"with {clash['local']}. Pick another place.")
                    elif any((DRIVE_ROOT / a['name'] / 'Online') in [lp, *lp.parents]
                             for a in cfg['accounts']):
                        problem = f"{f['local']} is inside an online mount. Pick another place."
                    if problem:
                        break
                if problem:
                    dlg.update_msg(problem)
                    continue
                if drop and not self.confirm(
                        f"Stop syncing {len(drop)} folder{'s' if len(drop) > 1 else ''}?",
                        '\n'.join(folder_title(f) for f in drop)
                        + '\n\nThe files stay on Drive and on this laptop.'):
                    continue
                cfg['folders'] = [f for f in cfg['folders'] if f['account'] != self.acc] + keep + add
                save(cfg)
                for f in drop:
                    shutil.rmtree(STATE / f['id'], ignore_errors=True)
                start_sync_detached([f['id'] for f in add])   # first sync merges both sides
                break
            dlg.destroy()
            self.show_folders(self.acc)

        def confirm(self, text, secondary):
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                  buttons=Gtk.ButtonsType.OK_CANCEL, text=text,
                                  secondary_text=secondary)
            ok = d.run() == Gtk.ResponseType.OK
            d.destroy()
            return ok

        def refresh_status(self):
            titles = {f['id']: folder_title(f) for f in load()['folders']}
            for fid, (lbl, bar, cur) in list(self.status_labels.items()):
                st = read_status(fid)
                s = st.get('state')
                frac, line2 = None, ''
                if s == 'syncing':
                    frac, txt, line2 = progress_text(st.get('progress') or {})
                elif s == 'queued':
                    txt = 'Waiting for the other folders to finish…'
                elif s == 'ok':
                    txt = f"✓ synced {ago(st.get('last_ok'))}"
                elif s == 'rate_limited':
                    left = max(0, int((st.get('retry_at') or 0) - time.time()))
                    txt = (f"⏸ Google's request limit was reached — retrying "
                           + (f'in {left // 60 + 1} min' if left else 'soon'))
                elif s == 'needs_resync':
                    txt = '⚠ needs Resync — ' + st.get('message', '')
                elif s == 'error':
                    txt = f"⚠ error {ago(st.get('last_error'))}: {st.get('message', '')}"
                    if st.get('last_ok'):
                        txt += f"  (last good sync {ago(st['last_ok'])})"
                    if (st.get('retry_at') or 0) > time.time():
                        txt += '  · next try ' + time.strftime('%H:%M', time.localtime(st['retry_at']))
                else:
                    txt = 'not synced yet'
                lbl.set_text(txt)
                if s == 'syncing':
                    bar.show()
                    if frac is None:
                        bar.pulse()
                    else:
                        bar.set_fraction(frac)
                else:
                    bar.hide()
                cur.set_text(line2)
                cur.set_visible(bool(line2))
            self.refresh_activity(titles)
            return True

        def refresh_activity(self, titles):
            try:
                m = ACTIVITY.stat().st_mtime
            except OSError:
                m = None
            if m == self.act_mtime:
                return
            self.act_mtime = m
            self.act_store.clear()
            words = {('new', 'up'): '↑ uploaded', ('updated', 'up'): '↑ updated',
                     ('new', 'down'): '↓ downloaded', ('updated', 'down'): '↓ updated',
                     ('deleted', 'up'): '✕ deleted on Drive',
                     ('deleted', 'down'): '✕ deleted here'}
            for e in read_activity(300):
                self.act_store.append([time.strftime('%d %b %H:%M', time.localtime(e['t'])),
                                       titles.get(e['folder'], '?'),
                                       words.get((e['what'], e.get('dir')), e['what']), e['file']])

    if not shutil.which('rclone'):
        Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.CLOSE,
                          text='rclone is not installed (run update-extras.sh)').run()
        return
    Window()
    Gtk.main()


def main():
    ap = argparse.ArgumentParser(prog='zorro-drive')
    sub = ap.add_subparsers(dest='cmd')
    s = sub.add_parser('sync')
    s.add_argument('--folder', action='append')
    s.add_argument('--all', action='store_true')
    s.add_argument('--resync', action='store_true')
    sub.add_parser('watch')
    sub.add_parser('status')
    args = ap.parse_args()
    if args.cmd == 'sync':
        sys.exit(cmd_sync(args))
    if args.cmd == 'watch':
        cmd_watch(args)
    elif args.cmd == 'status':
        cmd_status(args)
    else:
        run_app()


if __name__ == '__main__':
    main()
