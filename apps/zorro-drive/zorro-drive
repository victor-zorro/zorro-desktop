#!/usr/bin/python3
"""zorro-drive: Google Drive accounts and synced folders (rclone underneath).

  zorro-drive                     the app: accounts, folders, Sync buttons
  zorro-drive sync --folder ID..  sync folders (two-way, rclone bisync; repeat --folder)
  zorro-drive sync --all          sync every folder (zorro-drive-sync.timer, on AC only)
  zorro-drive sync --folder ID --resync   rebuild the sync baseline
  zorro-drive watch               upload local saves: sync a folder ~30 s after
                                  its last change (zorro-drive-watch.service)
  zorro-drive status              print folders and their state

Settings: ~/.config/zorro-drive/config.json (accounts = rclone remotes, folders).
State:    ~/.local/state/zorro-drive/<folder id>/ (status, last log, bisync files).
Tokens live in rclone's own ~/.config/rclone/rclone.conf, never in the repo.
Online mount per account: systemd unit zorro-drive-mount@<account> -> ~/Drive/<account>/Online
"""
import argparse
import fcntl
import json
import os
import re
import select
import shutil
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path

HOME = Path.home()
CONF_DIR = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config')) / 'zorro-drive'
CONF = CONF_DIR / 'config.json'
STATE = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state')) / 'zorro-drive'
DRIVE_ROOT = HOME / 'Drive'
DEBOUNCE = 30          # seconds after the last local change before uploading
SELF = os.path.realpath(__file__)


# ---- config & state ------------------------------------------------------------

def load():
    try:
        cfg = json.loads(CONF.read_text())
    except (FileNotFoundError, ValueError):
        cfg = {}
    cfg.setdefault('accounts', [])
    cfg.setdefault('folders', [])
    return cfg


def save(cfg):
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix('.tmp')
    tmp.write_text(json.dumps(cfg, indent=2) + '\n')
    tmp.replace(CONF)


def local_path(f):
    return Path(os.path.expanduser(f['local']))


def remote_spec(f):
    """rclone path; a shared drive is selected with a connection-string override."""
    base = f"{f['account']},team_drive={f['drive']}:" if f.get('drive') else f"{f['account']}:"
    return base + f['path']


def folder_title(f):
    root = f.get('drive_name') or 'My Drive'
    return f"{root}/{f['path']}" if f['path'] else root


def state_dir(fid):
    d = STATE / fid
    d.mkdir(parents=True, exist_ok=True)
    return d


def read_status(fid):
    try:
        st = json.loads((STATE / fid / 'status.json').read_text())
    except (FileNotFoundError, ValueError):
        st = {'state': 'new'}
    if st.get('state') == 'queued' and pid_alive(st.get('pid')):
        return st                       # waiting in a batch, not started yet
    if st.get('state') in ('syncing', 'queued') and not is_locked(fid):
        st['state'] = 'error'           # the syncing process died
        st['message'] = 'sync was interrupted'
    return st


def write_status(fid, **st):
    p = state_dir(fid) / 'status.json'
    old = {}
    try:
        old = json.loads(p.read_text())
    except (FileNotFoundError, ValueError):
        pass
    old.update(st)
    tmp = p.with_suffix('.tmp')
    tmp.write_text(json.dumps(old))
    tmp.replace(p)


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (TypeError, ValueError, ProcessLookupError):
        return False
    except PermissionError:
        return True


def is_locked(fid):
    try:
        with open(state_dir(fid) / 'lock', 'w') as fh:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
    except BlockingIOError:
        return True


def notify(title, body, urgency='normal'):
    try:
        subprocess.run(['notify-send', '-a', 'Drive', '-u', urgency, title, body],
                       timeout=5, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


# ---- syncing ---------------------------------------------------------------------

QUEUE_LOCK = STATE / 'queue.lock'      # one rclone sync at a time (Google rate limits)
ACTIVITY = STATE / 'activity.jsonl'    # recent file changes, shown in the app
RETRY_AFTER = 15 * 60                  # seconds to wait after Google's rate limit
BACKOFF = (30 * 60, 12 * 3600)         # after a failed sync: 30 min, doubling, at most 12 h
PHASES = (('Building Path1 and Path2 listings', 'listing'),
          ('checking for diffs', 'comparing'),
          ('Applying changes', 'transferring'),
          ('Resync is copying files', 'transferring'),
          ('Updating listings', 'finishing'),
          ('Resync updating listings', 'finishing'))
FILE_EVENTS = {'Copied (new)': 'new', 'Copied (replaced existing)': 'updated',
               'Deleted': 'deleted', 'Moved (server-side)': 'moved'}


def log_activity(entries):
    if not entries:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    with open(ACTIVITY, 'a') as fh:
        for e in entries:
            fh.write(json.dumps(e) + '\n')
    try:                                # keep the last 500 lines
        lines = ACTIVITY.read_text().splitlines()
        if len(lines) > 600:
            tmp = ACTIVITY.with_suffix('.tmp')
            tmp.write_text('\n'.join(lines[-500:]) + '\n')
            tmp.replace(ACTIVITY)
    except OSError:
        pass


def read_activity(n=200):
    try:
        lines = ACTIVITY.read_text().splitlines()[-n:]
    except OSError:
        return []
    out = []
    for ln in reversed(lines):
        try:
            out.append(json.loads(ln))
        except ValueError:
            pass
    return out


def sync_folder(f, resync=False):
    """Two-way sync of one folder. Returns 'ok', 'busy', 'needs_resync', 'rate_limited'
    or 'error'. Waits for other folders first (one sync at a time) and writes live
    progress to status.json while rclone runs."""
    fid = f['id']
    d = state_dir(fid)
    lock = open(d / 'lock', 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 'busy'
    queue = open(QUEUE_LOCK, 'w')
    try:
        try:
            fcntl.flock(queue, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            write_status(fid, state='queued', pid=os.getpid(), message='', progress=None)
            fcntl.flock(queue, fcntl.LOCK_EX)
        local = local_path(f)
        local.mkdir(parents=True, exist_ok=True)
        first = not (d / 'baseline').exists()
        before = read_status(fid)           # for the back-off and to notify only on news
        write_status(fid, state='syncing', started=time.time(), message='',
                     progress={'phase': 'starting'}, retry_at=None)
        cmd = ['rclone', 'bisync', remote_spec(f), str(local),
               '--workdir', str(d / 'bisync'), '--create-empty-src-dirs',
               '--drive-skip-gdocs', '--drive-skip-dangling-shortcuts', '--resilient', '--recover', '--max-lock', '2m',
               '--conflict-resolve', 'newer', '--conflict-loser', 'num',
               '--tpslimit', '8', '--color', 'NEVER', '--use-json-log',
               '--stats', '2s', '--stats-log-level', 'NOTICE', '-v']
        if first or resync:
            cmd.append('--resync')
        p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        log, prog, events, last_write = [], {'phase': 'starting'}, [], 0
        direction = ''      # Path1 = Drive, Path2 = this laptop
        for line in p.stderr:
            try:
                e = json.loads(line)
            except ValueError:
                log.append(line.rstrip())
                continue
            msg = e.get('msg', '')
            if 'stats' in e:
                st = e['stats']
                prog.update({k: st.get(k) for k in (
                    'bytes', 'totalBytes', 'speed', 'eta', 'transfers', 'totalTransfers',
                    'checks', 'totalChecks', 'listed', 'deletes', 'errors')})
                prog['current'] = [{'name': t.get('name'), 'pct': t.get('percentage'),
                                    'size': t.get('size')} for t in st.get('transferring') or []][:4]
            else:
                log.append(f"{e.get('time', '')[11:19]} {e.get('level', '')}: {msg}"
                           + (f" ({e['object']})" if e.get('object') else ''))
                if 'queued copies to' in msg or 'Resync is copying files to' in msg:
                    direction = 'up' if msg.rstrip().endswith('Path1') else 'down'
                for key, ph in PHASES:
                    if key in msg:
                        prog['phase'] = ph
                if e.get('object') and msg in FILE_EVENTS:
                    events.append({'t': time.time(), 'folder': fid, 'what': FILE_EVENTS[msg],
                                   'dir': direction, 'file': e['object']})
            if time.monotonic() - last_write > 1:
                write_status(fid, progress=prog)
                log_activity(events)
                events, last_write = [], time.monotonic()
        p.wait()
        log_activity(events)
        (d / 'last.log').write_text('\n'.join(log) + '\n')
        text = '\n'.join(log)
        if p.returncode == 0:
            (d / 'baseline').touch()
            write_status(fid, state='ok', last_ok=time.time(), message='', progress=None,
                         fails=0, notified='')
            return 'ok'
        if re.search(r'rateLimitExceeded|Quota exceeded|userRateLimit|Error 429', text):
            write_status(fid, state='rate_limited', last_error=time.time(), progress=None,
                         retry_at=time.time() + RETRY_AFTER,
                         message='Google\'s request limit was reached; retrying automatically')
            return 'rate_limited'
        # a first sync that failed simply starts over (it is a resync anyway)
        needs = not first and 'must run --resync' in text.lower()
        msg = next((ln.split(': ', 1)[-1] for ln in reversed(log)
                    if ' error: ' in ln and 'Bisync aborted' not in ln), f'rclone exit {p.returncode}')
        state = 'needs_resync' if needs else 'error'
        fails = (before.get('fails') or 0) + 1
        wait = min(BACKOFF[1], BACKOFF[0] * 2 ** (fails - 1))
        write_status(fid, state=state, last_error=time.time(), message=msg[:300], progress=None,
                     fails=fails, retry_at=time.time() + wait)
        if msg[:300] != before.get('notified'):     # the same error again: no new alarm
            write_status(fid, notified=msg[:300])
            notify('Drive sync failed', f"{folder_title(f)}: "
                   + ('open Drive and choose Resync' if needs else msg[:120]), 'critical')
        return state
    finally:
        queue.close()
        lock.close()


def start_sync_detached(fids, resync=False):
    """Run 'zorro-drive sync' in its own process, so closing the app doesn't stop it.
    Several folders are synced one after the other."""
    fids = [fids] if isinstance(fids, str) else list(fids)
    if not fids:
        return
    cmd = [sys.executable, SELF, 'sync'] + [a for fid in fids for a in ('--folder', fid)]
    cmd += ['--resync'] if resync else []
    subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_sync(args):
    cfg = load()
    folders = [f for f in cfg['folders'] if f.get('enabled', True)]
    if args.folder:
        folders = [f for f in cfg['folders'] if f['id'] in args.folder]
        if not folders:
            sys.exit(f"zorro-drive: no folder {', '.join(args.folder)}")
    elif not args.all:
        sys.exit('zorro-drive sync: --folder ID or --all')
    if args.all:                        # the timer: leave failing folders alone for a while
        now = time.time()
        for f in list(folders):
            st = read_status(f['id'])
            if st.get('state') in ('error', 'needs_resync', 'rate_limited') \
                    and (st.get('retry_at') or 0) > now:
                print(f"{folder_title(f)}: skipped after an error, next try "
                      + time.strftime('%H:%M', time.localtime(st['retry_at'])))
                folders.remove(f)
    rc = 0
    for f in folders[1:]:               # show the rest of the batch as waiting
        if not is_locked(f['id']):
            write_status(f['id'], state='queued', pid=os.getpid(), progress=None)
    for f in folders:
        r = sync_folder(f, args.resync)
        print(f"{folder_title(f)}: {r}")
        rc |= r in ('error', 'needs_resync', 'rate_limited')
        if r == 'rate_limited':         # Google says stop: the others would hit it too
            for g in folders[folders.index(f) + 1:]:
                if read_status(g['id']).get('state') == 'queued':
                    write_status(g['id'], state='rate_limited', progress=None,
                                 retry_at=time.time() + RETRY_AFTER,
                                 message='Google\'s request limit was reached; retrying automatically')
            break
    return rc


def cmd_status(_args):
    cfg = load()
    for f in cfg['folders']:
        st = read_status(f['id'])
        print(f"{f['id']}  {f['account']:10}  {folder_title(f):40}  {f['local']:35}  {st['state']}"
              + (f"  {st.get('message')}" if st.get('message') else ''))


# ---- watcher: upload local saves ---------------------------------------------------

IGNORE = re.compile(r'(\.partial$|\.tmp$|~$|\.swp$|\.swx$|/\.~lock\.|\.part$)')


def cmd_watch(_args):
    if not shutil.which('inotifywait'):
        sys.exit('zorro-drive watch: needs inotify-tools')
    while True:
        cfg = load()
        roots = {}
        for f in cfg['folders']:
            if f.get('enabled', True):
                p = local_path(f)
                p.mkdir(parents=True, exist_ok=True)
                roots[str(p.resolve())] = f
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        mtime = CONF.stat().st_mtime if CONF.exists() else 0
        if not roots:
            while (CONF.stat().st_mtime if CONF.exists() else 0) == mtime:
                time.sleep(10)
            continue
        proc = subprocess.Popen(
            ['inotifywait', '-m', '-r', '-q', '--format', '%e %w%f',
             '-e', 'close_write,moved_to,moved_from,create,delete', *roots, str(CONF_DIR)],
            stdout=subprocess.PIPE)                 # the config folder too: no polling for it
        fd, buf = proc.stdout.fileno(), b''
        pending, running, dirty = {}, {}, set()
        next_check = 0

        def work(f):
            try:
                sync_folder(f)
            except Exception as e:      # noqa: BLE001 - never leave the folder marked running
                print(f"zorro-drive watch: {folder_title(f)}: {e}", file=sys.stderr)
            finally:
                running.pop(f['id'], None)
                if f['id'] in dirty:    # saved while it synced: once more, after the debounce
                    dirty.discard(f['id'])
                    pending[f['id']] = time.monotonic() + DEBOUNCE
        try:
            while True:
                # sleep until an event, the next due sync or the next minute check; a little
                # sooner while syncs run (their end can queue a follow-up)
                wake = [next_check, *pending.values()] + ([time.monotonic() + 5] if running or dirty else [])
                r, _, _ = select.select([fd], [], [], max(0.05, min(wake) - time.monotonic()))
                if r:
                    # the raw pipe, split here: a buffered readline() would keep lines that came
                    # together in its buffer, where select() does not see them
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        break                   # inotifywait died: restart it
                    buf += chunk
                    *lines, buf = buf.split(b'\n')
                    if any(ln.decode(errors='replace').partition(' ')[2] == str(CONF) for ln in lines):
                        break                   # folders changed: rewatch
                    for ln in lines:
                        events, _, path = ln.decode(errors='replace').partition(' ')
                        if IGNORE.search(path):
                            continue
                        for root, f in roots.items():
                            if (path + '/').startswith(root + '/'):
                                if f['id'] not in running and not is_locked(f['id']):
                                    pending[f['id']] = time.monotonic() + DEBOUNCE
                                elif 'CLOSE_WRITE' in events:
                                    # during a sync: rclone writes *.partial and renames it, so
                                    # a file written in place is a save of yours: sync again after
                                    dirty.add(f['id'])
                                break
                now = time.monotonic()
                if now >= next_check:
                    # resume syncs cut off by a reboot, retry after Google's rate limit
                    next_check = now + 60
                    for f in roots.values():
                        st = read_status(f['id'])
                        if ((st.get('state') == 'rate_limited'
                             and (st.get('retry_at') or 0) <= time.time())
                                or st.get('message') == 'sync was interrupted'):
                            pending.setdefault(f['id'], now)
                for fid in [x for x in dirty if x not in running and not is_locked(x)]:
                    dirty.discard(fid)          # the timer's sync (another process) ended
                    pending[fid] = now + DEBOUNCE
                for fid, due in list(pending.items()):
                    if now >= due and fid not in running:
                        del pending[fid]
                        f = next(x for x in roots.values() if x['id'] == fid)
                        t = threading.Thread(target=work, args=(f,))
                        running[fid] = t
                        t.start()
        finally:
            proc.terminate()
            for t in list(running.values()):
                t.join()


# ---- the app -------------------------------------------------------------------------

def human_bytes(n):
    n = float(n or 0)
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1000 or unit == 'TB':
            return f'{n:.0f} {unit}' if unit in ('B', 'KB') else f'{n:.1f} {unit}'
        n /= 1000


def human_eta(sec):
    if sec is None:
        return None
    sec = int(sec)
    if sec < 60:
        return 'less than a minute left'
    if sec < 3600:
        return f'about {sec // 60 + 1} min left'
    return f'about {sec // 3600} h {sec % 3600 // 60} min left'


def progress_text(prog):
    """(fraction or None, line 1, line 2) for a folder that is syncing"""
    phase = prog.get('phase', 'starting')
    total, done = prog.get('totalBytes') or 0, prog.get('bytes') or 0
    tt, td = prog.get('totalTransfers') or 0, prog.get('transfers') or 0
    if phase in ('starting', 'listing') and not tt:
        listed = prog.get('listed')
        return None, f"Loading file lists from Drive and this laptop… ({listed or 0} files listed)", ''
    if phase == 'comparing' and not tt:
        return None, 'Comparing both sides…', ''
    if phase == 'finishing':
        return 1.0, 'Saving the sync state…', ''
    if not tt:
        return None, 'Checking…', ''
    eta = prog.get('eta')
    if eta is None and prog.get('speed') and total > done:
        eta = (total - done) / prog['speed']
    parts = [f'{td} of {tt} files', f'{human_bytes(done)} of {human_bytes(total)}']
    if prog.get('speed'):
        parts.append(f"{human_bytes(prog['speed'])}/s")
    if human_eta(eta) and total > done:
        parts.append(human_eta(eta))
    cur = prog.get('current') or []
    line2 = '  ·  '.join(f"{os.path.basename(c['name'] or '')} {c.get('pct') or 0}%" for c in cur[:2])
    frac = done / total if total else td / tt
    return min(max(frac, 0.0), 1.0), '  ·  '.join(parts), line2


def ago(ts):
    if not ts:
        return 'never'
    s = int(time.time() - ts)
    if s < 60:
        return 'just now'
    if s < 3600:
        return f'{s // 60} min ago'
    if s < 86400:
        return f'{s // 3600} h ago'
    return time.strftime('%d %b %H:%M', time.localtime(ts))


def run_app():
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import GLib, Gtk, Pango

    def rclone_json(args):
        p = subprocess.run(['rclone', *args], capture_output=True, text=True)
        if p.returncode:
            raise RuntimeError(p.stderr.strip().splitlines()[-1] if p.stderr.strip() else 'rclone failed')
        return json.loads(p.stdout or '[]')

    def in_thread(work, done):
        def run():
            try:
                res, err = work(), None
            except Exception as e:      # shown to the user
                res, err = None, str(e)
            GLib.idle_add(lambda: done(res, err) and False)
        threading.Thread(target=run, daemon=True).start()

    def rclone_value(acc, key):
        p = subprocess.run(['rclone', 'config', 'dump'], capture_output=True, text=True)
        try:
            return json.loads(p.stdout).get(acc, {}).get(key, '')
        except ValueError:
            return ''

    def systemctl(*a):
        return subprocess.run(['systemctl', '--user', *a], capture_output=True, text=True)

    def mount_active(acc):
        return systemctl('is-active', f'zorro-drive-mount@{acc}.service').stdout.strip() == 'active'

    class AddAccount(Gtk.Dialog):
        def __init__(self, parent):
            super().__init__(title='Add Google account', transient_for=parent, modal=True)
            self.set_default_size(460, -1)
            box = self.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            box.add(Gtk.Label(label='A short name for this account, e.g. "work" or "personal".\n'
                              'Firefox opens Google\'s sign-in page; come back here afterwards.',
                              xalign=0, wrap=True))
            self.name = Gtk.Entry(placeholder_text='name')
            box.add(self.name)
            self.msg = Gtk.Label(xalign=0, wrap=True, selectable=True)
            box.add(self.msg)
            self.add_button('Cancel', Gtk.ResponseType.CANCEL)
            self.ok = self.add_button('Sign in', Gtk.ResponseType.OK)
            self.ok.get_style_context().add_class('suggested-action')
            self.show_all()

    class ChooseFolders(Gtk.Dialog):
        """Drive folder tree (My Drive + shared drives) with a checkbox per folder.
        Every checked folder becomes its own synced folder in the list."""

        # store columns
        NAME, DRIVE, DNAME, PATH, LOADED, REAL = range(6)

        def __init__(self, parent, acc, current):
            super().__init__(title=f'Choose folders to sync — {acc}', transient_for=parent, modal=True)
            self.acc = acc
            # (drive id or '', path) -> drive name, for every checked folder
            self.checked = {(f.get('drive') or '', f['path']): f.get('drive_name') or ''
                            for f in current}
            self.set_default_size(640, 600)
            box = self.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            box.add(Gtk.Label(label='Tick the folders to keep on this laptop. Each ticked folder '
                                    'gets its own Sync button. Ticking a folder includes '
                                    'everything inside it.', xalign=0, wrap=True))
            self.store = Gtk.TreeStore(str, str, str, str, bool, bool)
            self.tree = Gtk.TreeView(model=self.store, headers_visible=False)
            col = Gtk.TreeViewColumn('Folder')
            tick = Gtk.CellRendererToggle()
            tick.connect('toggled', self.on_toggle)
            col.pack_start(tick, False)
            col.set_cell_data_func(tick, self.tick_data)
            col.pack_start(Gtk.CellRendererText(), True)
            col.add_attribute(col.get_cells()[1], 'text', self.NAME)
            self.tree.append_column(col)
            self.tree.connect('row-expanded', self.on_expand)
            self.tree.connect('row-activated', self.on_activated)
            sw = Gtk.ScrolledWindow(vexpand=True)
            sw.add(self.tree)
            box.add(sw)
            row = Gtk.Box(spacing=6)
            row.add(Gtk.Label(label='New folders go in'))
            self.root = Gtk.Entry(hexpand=True,
                                  text=str(DRIVE_ROOT / acc).replace(str(HOME), '~', 1))
            row.add(self.root)
            pick = Gtk.Button(label='Choose…')
            pick.connect('clicked', self.on_pick)
            row.add(pick)
            box.add(row)
            self.msg = Gtk.Label(xalign=0, wrap=True)
            box.add(self.msg)
            self.add_button('Cancel', Gtk.ResponseType.CANCEL)
            self.ok = self.add_button('Save', Gtk.ResponseType.OK)
            self.ok.get_style_context().add_class('suggested-action')
            self.add_root('My Drive', '', '')
            self.msg.set_text('Loading shared drives…')
            in_thread(lambda: rclone_json(['backend', 'drives', f'{acc}:']), self.got_drives)
            self.show_all()
            self.update_msg()

        # -- tree
        def add_root(self, name, drive, drive_name):
            it = self.store.append(None, [name, drive, drive_name, '', False, True])
            self.store.append(it, ['loading…', '', '', '', True, False])

        def got_drives(self, drives, err):
            for d in drives or []:
                self.add_root(f"Shared: {d.get('name')}", d.get('id', ''), d.get('name', ''))
            self.update_msg(f'Could not list shared drives: {err}' if err else None)

        def on_expand(self, tree, it, path):
            if self.store[it][self.LOADED]:
                return
            self.store[it][self.LOADED] = True
            drive, dname, rpath = (self.store[it][c] for c in (self.DRIVE, self.DNAME, self.PATH))
            spec = (f'{self.acc},team_drive={drive}:' if drive else f'{self.acc}:') + rpath
            ref = Gtk.TreeRowReference.new(self.store, path)

            def done(items, err):
                if not ref.valid():
                    return
                it = self.store.get_iter(ref.get_path())
                child = self.store.iter_children(it)
                if err:
                    self.store[child][self.NAME] = f'⚠ {err}'
                    return
                self.store.remove(child)
                for e in sorted(items, key=lambda e: e['Name'].lower()):
                    sub = f"{rpath}/{e['Name']}" if rpath else e['Name']
                    c = self.store.append(it, [e['Name'], drive, dname, sub, False, True])
                    self.store.append(c, ['loading…', '', '', '', True, False])
                if not items:
                    self.store.append(it, ['(no subfolders)', '', '', '', True, False])
            in_thread(lambda: rclone_json(['lsjson', '--dirs-only', spec]), done)

        # -- ticks
        @staticmethod
        def inside(a, b):
            """path a is inside path b (b == '' is the drive root)"""
            return b == '' and a != '' or a.startswith(b + '/')

        def covered_by(self, drive, path):
            """the checked ancestor that already includes this folder, if any"""
            return next((p for (d, p) in self.checked if d == drive and self.inside(path, p)), None)

        def tick_data(self, col, cell, model, it, _data):
            real = model[it][self.REAL]
            cell.set_visible(real)
            if not real:
                return
            key = (model[it][self.DRIVE], model[it][self.PATH])
            parent = self.covered_by(*key)
            has_sub = any(d == key[0] and self.inside(p, key[1]) for (d, p) in self.checked)
            cell.set_property('active', key in self.checked or parent is not None)
            cell.set_property('inconsistent', key not in self.checked and parent is None and has_sub)
            cell.set_property('sensitive', parent is None)
            cell.set_property('activatable', parent is None)

        def on_toggle(self, _cell, path):
            it = self.store.get_iter(path)
            if not self.store[it][self.REAL]:
                return
            drive, dname, rpath = (self.store[it][c] for c in (self.DRIVE, self.DNAME, self.PATH))
            key = (drive, rpath)
            if self.covered_by(*key) is not None:
                return
            if key in self.checked:
                del self.checked[key]
            else:
                # a ticked folder includes its subfolders: they stop being separate entries
                for k in [k for k in self.checked if k[0] == drive and self.inside(k[1], rpath)]:
                    del self.checked[k]
                self.checked[key] = dname
            self.tree.queue_draw()
            self.update_msg()

        def on_activated(self, tree, path, _col):
            if tree.row_expanded(path):
                tree.collapse_row(path)
            else:
                tree.expand_row(path, False)

        def update_msg(self, extra=None):
            n = len(self.checked)
            txt = f"{n} folder{'s' if n != 1 else ''} ticked."
            self.msg.set_text(f'{extra}\n{txt}' if extra else txt)

        def on_pick(self, _b):
            fc = Gtk.FileChooserNative(title='Where new folders go', transient_for=self,
                                       action=Gtk.FileChooserAction.SELECT_FOLDER)
            if fc.run() == Gtk.ResponseType.ACCEPT:
                self.root.set_text(fc.get_filename().replace(str(HOME), '~', 1))

        def new_local(self, drive, dname, rpath):
            parts = ([dname] if drive else []) + ([rpath] if rpath else [])
            root = Path(os.path.expanduser(self.root.get_text().strip()))
            if not parts:
                parts = ['My Drive']
            return str(root.joinpath(*parts)).replace(str(HOME), '~', 1)

