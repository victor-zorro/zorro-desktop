[Unit]
Description=Google Drive account %i online at ~/Drive/%i/Online (rclone mount)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/Drive/%i/Online
# Files are fetched when opened; Drive changes are checked every 5 min (cheap, one request)
ExecStart=/usr/bin/rclone mount %i: %h/Drive/%i/Online \
  --vfs-cache-mode full --vfs-cache-max-age 72h --vfs-cache-max-size 20G \
  --dir-cache-time 30m --poll-interval 5m --drive-skip-gdocs
ExecStop=/bin/fusermount3 -u %h/Drive/%i/Online
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
