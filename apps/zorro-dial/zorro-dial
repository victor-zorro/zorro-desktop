#!/usr/bin/python3
"""zorro-dial: the Dialer, the app launcher and hub around a clock (Super / Super+Space).

  zorro-dial            show the dial (or close it); signals the daemon when that runs
  zorro-dial --daemon   stay loaded in the background (autostart): Super shows it at once

The code is the package next to this file (dial/); see README.md.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)
from dial.running import signal_daemon  # noqa: E402

if __name__ == '__main__' and sys.argv[1:] != ['--daemon'] and signal_daemon():
    sys.exit(0)                         # the daemon shows it: GTK is never loaded here

# the Zorro app's Dialer page loads this file and uses these names
from dial.applist import apps  # noqa: E402,F401
from dial.config import CONF, DEFAULTS, load_conf, save_keys  # noqa: E402,F401
from dial.usage import USAGE  # noqa: E402,F401

if __name__ == '__main__':
    from dial import cli
    cli.main()
