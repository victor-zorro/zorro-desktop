def load_conf():
    c = json.loads(json.dumps(DEFAULTS))
    try:
        user = json.loads(CONF.read_text())
        c.update({k: v for k, v in user.items() if k in DEFAULTS and k != 'assign'})
        c['assign'].update(user.get('assign', {}))
    except (OSError, ValueError):
        pass
    return c


def save_arrangement(order, assign):
    """write the dragged order (and slice moves) into the config, keeping everything else"""
    try:
        user = json.loads(CONF.read_text())
    except (OSError, ValueError):
        user = {}
    user['order'] = order
    user['assign'] = {**user.get('assign', {}), **assign}
    CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix('.tmp')
    tmp.write_text(json.dumps(user, indent=2))
    tmp.replace(CONF)


def load_usage():
    try:
        u = json.loads(USAGE.read_text())
        return u if isinstance(u, dict) else {}
    except (OSError, ValueError):
        return {}


def record(app_id):
    u = load_usage()
    e = u.get(app_id, {'n': 0, 'last': 0})
    e['n'] = e.get('n', 0) + 1
    e['last'] = time.time()
    u[app_id] = e
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = USAGE.with_suffix('.tmp')
    tmp.write_text(json.dumps(u))
    tmp.replace(USAGE)


def score(u, app_id):
    """starts, with recent ones counting more (half-life two weeks)"""
    e = u.get(app_id)
    if not e:
        return 0.0
    age_days = (time.time() - e.get('last', 0)) / 86400
    return e.get('n', 0) * 0.5 ** (age_days / 14)


def apps():
    """installed apps: [{id, name, icon, cats, path}] from the .desktop files"""
    dirs = [HOME / '.local/share/applications'] + [
        Path(d) / 'applications' for d in
        os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share').split(':')]
    seen, out = set(), []
    for d in dirs:
        for f in sorted(d.glob('*.desktop')) if d.is_dir() else []:
            if f.name in seen:
                continue
            seen.add(f.name)
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(f, encoding='utf-8')
                e = cp['Desktop Entry']
            except (configparser.Error, KeyError, UnicodeDecodeError):
                continue
            if e.get('Type') != 'Application' or e.get('NoDisplay', 'false') == 'true' \
                    or e.get('Hidden', 'false') == 'true' or not e.get('Exec'):
                continue
            out.append({'id': f.name, 'name': e.get('Name', f.stem), 'icon': e.get('Icon', ''),
                        'cats': [c for c in e.get('Categories', '').split(';') if c],
                        'path': str(f), 'keywords': e.get('Keywords', '')})
    return out


ORB_CONF = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config')) / 'zorro-orb' / 'config.json'


def orb_conf():
    """where the info circle is (its size, corner and margin)"""
    c = {'size': 240, 'corner': 'bottom-right', 'margin': 28}
    try:
        user = json.loads(ORB_CONF.read_text())
        c.update({k: user[k] for k in c if k in user})
    except (OSError, ValueError):
        pass
    return c


def load_orb():
    """the info circle's code (apps/zorro-orb): its zones and their information"""
    import importlib.machinery
    import importlib.util
    p = Path(os.path.realpath(__file__)).parent.parent / 'zorro-orb' / 'zorro-orb'
    try:
        spec = importlib.util.spec_from_loader('zorro_orb', importlib.machinery.SourceFileLoader('zorro_orb', str(p)))
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        return m
    except (OSError, SyntaxError, ImportError):
        return None


def toggle_running():
    """already open: close it and stop (Super pressed again)"""
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, signal.SIGTERM)
        return True
    except (OSError, ValueError):
        return False


class Dial(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.conf = load_conf()
        self.usage = load_usage()
        self.all = apps()
        self.filter = ''
        self.hover = None
        self.slots = []                 # (x, y, r, app, slice, position) placed this frame
        self.press = None               # (app, x, y) while the mouse button is down on an app
        self.drag = None                # (app, x, y) while an app is being dragged
        self.expanded = None            # a full slice shown across the dial ("+N" clicked)
        # the hub works like the info circle: four hidden zones (battery, network, ...)
        self.orb = load_orb()
        self.zones = self.orb.load_conf().get('zones', {}) if self.orb else {}
        self.hub_zone = None            # 'tl' 'tr' 'bl' 'br' while the mouse is on one
        self.zone_info = {}             # item -> (title, big, lines), fetched in the background
        if self.orb:
            threading.Thread(target=self.fetch_zones, daemon=True).start()
        self.theme = Gtk.IconTheme.get_default()
        self.icons = {}
        disp = Gdk.Display.get_default()
        if self.conf.get('anchor') == 'orb':       # the info circle lives on the primary screen
            mon = disp.get_primary_monitor() or disp.get_monitor(0)
        else:
            mon = disp.get_monitor_at_point(*self.pointer()) or disp.get_primary_monitor() or disp.get_monitor(0)
        g = mon.get_geometry()
        self.geo = g
        scr = self.get_screen()
        self.composited = bool(scr.is_composited() and scr.get_rgba_visual())
        if self.composited:
            self.set_visual(scr.get_rgba_visual())
            self.backdrop = None
        else:                           # no compositor: a still image of the screen behind
            root = Gdk.get_default_root_window()
            self.backdrop = Gdk.pixbuf_get_from_window(root, g.x, g.y, g.width, g.height)
        self.set_app_paintable(True)
        self.move(g.x, g.y)
        self.resize(g.width, g.height)
        self.connect('draw', self.paint_back)     # 1. the screen behind, dimmed
        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.BUTTON_RELEASE_MASK)
        if zorro_fx:                    # 2. particles from the overlay look, around the dial
            self.snow = zorro_fx.Snow(self.area, radius=0, profile='overlay', fps=20, max_parts=900)
            self.snow.paint_edge = lambda *a: None
            self.snow.paint_box = lambda *a: None
        self.area.connect('draw', self.on_draw)   # 3. the dial
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('button-press-event', self.on_click)
        self.area.connect('button-release-event', self.on_release)
        self.add(self.area)
        self.connect('key-press-event', self.on_key)
        self.layout_apps()
        self.show_all()
        GLib.idle_add(self.grab)
        GLib.timeout_add_seconds(1, lambda: self.area.queue_draw() or True)

    def fetch_zones(self):
        for item in set(self.zones.values()):
            fn = self.orb.ITEMS.get(item, (None, None))[1]
            if fn:
                try:
                    self.zone_info[item] = fn()
                except Exception:       # noqa: BLE001 - one broken item must not stop the dial
                    self.zone_info[item] = (item, '?', [])
        GLib.idle_add(self.area.queue_draw)

    def hub_zone_at(self, x, y):
        cx, cy, hub, *_ = self.fan()
        dx, dy = x - cx, y - cy
        if dx * dx + dy * dy > (hub - 4) ** 2:
            return None
        z = ('t' if dy < 0 else 'b') + ('l' if dx < 0 else 'r')
        return z if self.zones.get(z, 'none') != 'none' else None

    @staticmethod
    def pointer():
        try:
            _, x, y = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()[0:3]
            return x, y
        except (AttributeError, TypeError):
            return 0, 0

    def grab(self):
        seat = Gdk.Display.get_default().get_default_seat()
        for _ in range(20):             # Openbox may still hold the key that started us
            if seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True,
                         None, None, None) == Gdk.GrabStatus.SUCCESS:
                break
            time.sleep(0.05)
        return False

    # -- which app goes where
    def layout_apps(self):
        """per slice: its apps by usage; the first ring_slots[0] on the inner ring, …"""
        slices = self.conf['slices'][:6]
        names = [s['name'] for s in slices]
        groups = [[] for _ in slices]
        hidden = set(self.conf.get('hide', []))
        if any(a['id'] == 'nemo.desktop' for a in self.all):
            hidden.add('thunar.desktop')        # one file manager in the slices: Nemo
        for a in self.all:
            if a['id'] in hidden:
                continue
            pick = self.conf.get('assign', {}).get(a['id'])
            if pick in names:
                idx = names.index(pick)
            else:
                idx = next((i for i, s in enumerate(slices)
                            if any(c in s['categories'] for c in a['cats'])), len(slices) - 1)
            groups[idx].append(a)
        # your dragged order first, then the rest by usage (most used inward)
        self.groups = []
        for s, g in zip(slices, groups):
            pinned = self.conf.get('order', {}).get(s['name'], [])
            byid = {a['id']: a for a in g}
            first = [byid[i] for i in pinned if i in byid]
            rest = sorted((a for a in g if a['id'] not in pinned),
                          key=lambda a: (-score(self.usage, a['id']), a['name'].lower()))
            self.groups.append(first + rest)

    def matches(self):
        f = self.filter.lower()
        found = [a for a in self.all if f in a['name'].lower() or f in a['keywords'].lower()
                 or f in a['id'].lower()]
        return sorted(found, key=lambda a: (not a['name'].lower().startswith(f),
                                            -score(self.usage, a['id']), a['name'].lower()))

    def icon(self, a, size):
        key = (a['icon'], size)
        if key not in self.icons:
            pb = None
            try:
                if os.path.isabs(a['icon']):
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(a['icon'], size, size)
                elif a['icon']:
                    pb = self.theme.load_icon(a['icon'], size, Gtk.IconLookupFlags.FORCE_SIZE)
            except GLib.Error:
                pb = None
            if pb is None:
                try:
                    pb = self.theme.load_icon('application-x-executable', size,
                                              Gtk.IconLookupFlags.FORCE_SIZE)
                except GLib.Error:
                    pb = None
            self.icons[key] = pb
        return self.icons[key]

    # -- drawing
    def text(self, cr, s, x, y, size, bold=True, alpha=1.0, split=1.4):
        lay = PangoCairo.create_layout(cr)
        lay.set_font_description(Pango.FontDescription.from_string(
            f'DejaVu Sans {"Bold" if bold else ""} {size}'))
        lay.set_text(s, -1)
        _, ext = lay.get_pixel_extents()
        x0, y0 = x - ext.width / 2, y - ext.height / 2
        for col, dx in ((RED, -split), (CYAN, split)):
            cr.move_to(x0 + dx, y0)
            cr.set_source_rgba(*col, 0.5 * alpha)
            PangoCairo.show_layout(cr, lay)
        cr.move_to(x0, y0)
        cr.set_source_rgba(*FG, alpha)
        PangoCairo.show_layout(cr, lay)

    def chroma_circle(self, cr, cx, cy, r, alpha=0.9, split=1.5):
        for col, dx in ((RED, -split), (CYAN, split)):
            cr.new_path()
            cr.arc(cx + dx, cy, r, 0, 2 * math.pi)
            cr.set_source_rgba(*col, 0.7 * alpha)
            cr.set_line_width(1.2)
            cr.stroke()
        cr.new_path()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.2 * alpha)
        cr.set_line_width(1)
        cr.stroke()

    def paint_back(self, _w, cr):
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        if self.backdrop is not None:
            Gdk.cairo_set_source_pixbuf(cr, self.backdrop, 0, 0)
            cr.paint()
            cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_rgba(0, 0, 0, 0.55)
        cr.paint()
        cr.restore()
        return False

    def fan(self):
        """(cx, cy, hub radius, first angle, last angle, rings) in window coordinates.
        orb: the hub is the info circle's clock and the rings fan out from its corner into
        the screen (120 degrees); centre: full circle in the middle of the screen."""
        W, H = self.geo.width, self.geo.height
        if self.conf.get('anchor') == 'orb':
            orb = orb_conf()
            d, m, corner = orb['size'], orb['margin'], orb['corner']
            cx = m + d / 2 if 'left' in corner else W - m - d / 2
            cy = m + d / 2 if 'top' in corner else H - m - d / 2
            mid = {'bottom-right': 225, 'bottom-left': 315, 'top-right': 135, 'top-left': 45}.get(corner, 225)
            hub = d / 2
            a0, a1 = mid - 60, mid + 60
        else:
            cx, cy, hub, a0, a1 = W / 2, H / 2, 86, -90, 270
        rings = [(hub + 12, hub + 96), (hub + 96, hub + 180), (hub + 180, hub + 270)]
        return cx, cy, hub, a0, a1, rings

    def on_draw(self, w, cr):
        cx, cy, hub, a0, a1, rings = self.fan()
        self.slots = []
        if self.filter:
            self.draw_search(cr, cx, cy, rings, a0, a1)
        elif self.expanded is not None:
            self.draw_search(cr, cx, cy, rings, a0, a1, self.groups[self.expanded])
        else:
            self.draw_slices(cr, cx, cy, rings, a0, a1)
        outer = rings[-1][1]
        cr.new_path()
        cr.arc(cx, cy, outer, math.radians(a0), math.radians(a1))
        for col, dx in ((RED, -1.5), (CYAN, 1.5)):          # chromatic outer rim
            cr.save()
            cr.translate(dx, 0)
            cr.new_path()
            cr.arc(cx, cy, outer, math.radians(a0), math.radians(a1))
            cr.set_source_rgba(*col, 0.6)
            cr.set_line_width(1.2)
            cr.stroke()
            cr.restore()
        # the hub: the clock (over the info circle), or the hovered app's name
        cr.new_path()
        cr.arc(cx, cy, hub - 4, 0, 2 * math.pi)
        cr.set_source_rgba(0, 0, 0, 0.8)
        cr.fill()
        self.chroma_circle(cr, cx, cy, hub - 4)
        k = hub / 120
        item = self.zones.get(self.hub_zone) if self.hub_zone and not self.hover else None
        if item:
            self.draw_zone(cr, cx, cy, hub, k, item)
        else:
            self.text(cr, time.strftime('%H:%M'), cx, cy - 10 * k, max(14, 26 * k), split=2)
            label = self.hover['name'] if self.hover else (f'“{self.filter}”' if self.filter else
                                                       self.conf['slices'][self.expanded]['name']
                                                       if self.expanded is not None else
                                                           time.strftime('%A %-d %B'))
            self.text(cr, label[:22], cx, cy + 24 * k, max(8, 10 * k), bold=False, alpha=0.9, split=1)
        am = math.radians((a0 + a1) / 2)
        if self.drag:
            a, x, y = self.drag
            pb = self.icon(a, 44)
            cr.new_path()
            cr.arc(x, y, 40, 0, 2 * math.pi)
            cr.set_source_rgba(*CYAN, 0.12)
            cr.fill()
            self.chroma_circle(cr, x, y, 40)
            if pb:
                Gdk.cairo_set_source_pixbuf(cr, pb, x - pb.get_width() / 2, y - pb.get_height() / 2)
                cr.paint()
        self.text(cr, 'type to search · drag to rearrange · Enter starts · Esc closes',
                  cx + math.cos(am) * (outer + 70), cy + math.sin(am) * (outer + 70), 9,
                  bold=False, alpha=0.5, split=0)
        return False

    def draw_zone(self, cr, cx, cy, hub, k, item):
        """a hub zone's information, laid out like the info circle; the zone's quarter of
        the rim lights up"""
        q = {'tr': -90, 'br': 0, 'bl': 90, 'tl': 180}[self.hub_zone]
        for col, dr in ((RED, -1.2), (CYAN, 1.2)):
            cr.new_path()
            cr.arc(cx, cy, hub - 4 + dr, math.radians(q + 6), math.radians(q + 84))
            cr.set_source_rgba(*col, 0.8)
            cr.set_line_width(2)
            cr.stroke()
        title, big, lines = self.zone_info.get(item) or (item, '…', [])
        parts = []
        if title:
            parts.append((title.upper(), max(7, 8 * k), True, 0.55, 1))
        parts.append((big, (30 if len(big) <= 5 else 20 if len(big) <= 9 else 15) * k, True, 1.0, 2))
        parts += [(ln[:26], max(8, 9.5 * k), False, 0.8, 1) for ln in lines[:3] if ln]
        heights = [size * 1.7 for _, size, _, _, _ in parts]
        y = cy - sum(heights) / 2
        for (s, size, bold, a, split), h in zip(parts, heights):
            self.text(cr, s, cx, y + h / 2, size, bold=bold, alpha=a, split=split)
            y += h

    @staticmethod
    def fits(rm, span_deg, size):
        """how many icons of this size fit on an arc"""
        return max(1, int(rm * math.radians(span_deg) / (size * 1.45)))

    def draw_slices(self, cr, cx, cy, rings, a0, a1):
        slices = self.conf['slices'][:6]
        n = len(slices)
        span = (a1 - a0) / n
        for i, s in enumerate(slices):
            start = a0 + i * span
            for k, (ri, ro) in enumerate(rings):
                b0, b1 = math.radians(start + 0.6), math.radians(start + span - 0.6)
                cr.new_path()
                cr.arc(cx, cy, ro - 2, b0, b1)
                cr.arc_negative(cx, cy, ri + 2, b1, b0)
                cr.close_path()
                cr.set_source_rgba(0.03, 0.03, 0.05, 0.55)
                cr.fill_preserve()
                cr.set_source_rgba(1, 1, 1, 0.07)
                cr.set_line_width(1)
                cr.stroke()
            am = math.radians(start + span / 2)
            r_lab = rings[-1][1] + 20
            self.text(cr, s['name'].upper(), cx + math.cos(am) * r_lab, cy + math.sin(am) * r_lab,
                      9, split=1.4)
            group = list(self.groups[i])
            caps = []
            for k, (ri, ro) in enumerate(rings):
                size = (44, 36, 30)[k]
                rm = (ri + ro) / 2
                caps.append(min(self.conf['ring_slots'][k], self.fits(rm, span, size))
                            if self.conf.get('anchor') != 'orb' else self.fits(rm, span, size))
            if len(group) > sum(caps):           # never drop apps silently: "+N" shows them all
                extra = len(group) - sum(caps) + 1
                group = group[:sum(caps) - 1] + [{'id': f'__more__{i}', 'name': f'{extra} more',
                                                  'icon': '', 'more': i, 'extra': extra}]
            pos = 0
            for k, (ri, ro) in enumerate(rings):
                size = (44, 36, 30)[k]
                rm = (ri + ro) / 2
                cnt = min(self.conf['ring_slots'][k], self.fits(rm, span, size)) \
                    if self.conf.get('anchor') != 'orb' else self.fits(rm, span, size)
                row, group = group[:cnt], group[cnt:]
                self.place(cr, cx, cy, row, rm, start, span, size, where=(i, pos))
                pos += len(row)

    def draw_search(self, cr, cx, cy, rings, a0, a1, items=None):
        found = list(items) if items is not None else self.matches()
        for k, (ri, ro) in enumerate(rings):
            size = (44, 36, 30)[k]
            rm = (ri + ro) / 2
            cnt = self.fits(rm, a1 - a0, size)
            row, found = found[:cnt], found[cnt:]
            if row:
                self.place(cr, cx, cy, row, rm, a0, a1 - a0, size, full=cnt)

    def place(self, cr, cx, cy, row, rm, start, span, size, full=None, where=None):
        cnt = full or len(row)
        for j, a in enumerate(row):
            am = math.radians(start + span * ((j + 0.5) / cnt if full else (j + 1) / (len(row) + 1)))
            x, y = cx + math.cos(am) * rm, cy + math.sin(am) * rm
            self.slots.append((x, y, size * 0.75, a) + ((where[0], where[1] + j) if where else (None, None)))
            if self.drag and self.drag[0] is a:              # its place, while it is dragged
                cr.new_path()
                cr.arc(x, y, size * 0.6, 0, 2 * math.pi)
                cr.set_source_rgba(1, 1, 1, 0.12)
                cr.set_line_width(1)
                cr.stroke()
                continue
            if self.hover is a:
                cr.new_path()
                cr.arc(x, y, size * 0.9, 0, 2 * math.pi)
                cr.set_source_rgba(*CYAN, 0.16)
                cr.fill()
                self.chroma_circle(cr, x, y, size * 0.9)
            if 'more' in a:
                cr.new_path()
                cr.arc(x, y, size * 0.55, 0, 2 * math.pi)
                cr.set_source_rgba(1, 1, 1, 0.08)
                cr.fill()
                self.chroma_circle(cr, x, y, size * 0.55, alpha=0.6, split=1)
                self.text(cr, f'+{a["extra"]}', x, y, max(8, size / 4), split=1)
                continue
            pb = self.icon(a, size)
            if pb:
                Gdk.cairo_set_source_pixbuf(cr, pb, x - pb.get_width() / 2, y - pb.get_height() / 2)
                cr.paint()

    # -- input
    def hit(self, x, y, slot=False):
        s = next((s for s in self.slots if (x - s[0]) ** 2 + (y - s[1]) ** 2 <= s[2] * s[2]), None)
        return s if slot else (s[3] if s else None)

    def slice_at(self, x, y):
        """index of the slice under (x, y), or None outside the fan"""
        cx, cy, hub, a0, a1, rings = self.fan()
        dx, dy = x - cx, y - cy
        if not hub ** 2 <= dx * dx + dy * dy <= (rings[-1][1] + 30) ** 2:
            return None
        rel = (math.degrees(math.atan2(dy, dx)) - a0) % 360
        n = len(self.conf['slices'][:6])
        return int(rel / ((a1 - a0) / n)) if rel <= a1 - a0 else None

    def on_motion(self, _w, ev):
        if self.press and not self.drag and not self.filter and self.expanded is None \
                and 'more' not in self.press[0]:
            a, px, py = self.press
            if (ev.x - px) ** 2 + (ev.y - py) ** 2 > 12 ** 2:
                self.drag = (a, ev.x, ev.y)
        if self.drag:
            self.drag = (self.drag[0], ev.x, ev.y)
            target = self.hit(ev.x, ev.y)
            self.hover = target if target is not self.drag[0] else None
            self.area.queue_draw()
            return
        h = self.hit(ev.x, ev.y)
        z = self.hub_zone_at(ev.x, ev.y)
        if h is not self.hover or z != self.hub_zone:
            self.hover, self.hub_zone = h, z
            self.area.queue_draw()

    def on_release(self, _w, ev):
        press, drag = self.press, self.drag
        self.press = self.drag = None
        if ev.button != 1 or not press:
            return
        if not drag:                        # a click: start the app
            if self.hit(ev.x, ev.y) is press[0]:
                if 'more' in press[0]:
                    self.expanded = press[0]['more']
                    self.hover = None
                    self.area.queue_draw()
                else:
                    self.launch(press[0])
            return
        self.drop(drag[0], ev.x, ev.y)
        self.area.queue_draw()

    def drop(self, a, x, y):
        """put the dragged app before the app it was dropped on, or at the end of the slice"""
        slot = self.hit(x, y, slot=True)
        if slot and slot[4] is not None:
            gi, pos = slot[4], slot[5]
        else:
            gi = self.slice_at(x, y)
            if gi is None:
                return                      # dropped outside: nothing changes
            pos = len(self.groups[gi])
        src = next(i for i, g in enumerate(self.groups) if a in g)
        old = self.groups[src].index(a)
        self.groups[src].remove(a)
        if src == gi and old < pos:
            pos -= 1
        self.groups[gi].insert(pos, a)
        names = [s['name'] for s in self.conf['slices'][:6]]
        order = dict(self.conf.get('order', {}))
        for i in {src, gi}:
            order[names[i]] = [b['id'] for b in self.groups[i]]
        assign = {a['id']: names[gi]} if gi != src else {}
        self.conf['order'] = order
        self.conf['assign'].update(assign)
        save_arrangement(order, assign)

    def on_click(self, _w, ev):
        a = self.hit(ev.x, ev.y)
        z = self.hub_zone_at(ev.x, ev.y)
        if a and ev.button == 1:
            self.press = (a, ev.x, ev.y)    # start on release; moving it drags instead
        elif z and ev.button == 1:          # a hub zone: open what the info circle opens
            cmd = self.orb.CLICK.get(self.zones.get(z))
            if cmd:
                try:
                    subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except OSError:
                    pass
                self.close_dial()
        elif not a:
            cx, cy, hub, a0, a1, rings = self.fan()
            dx, dy = ev.x - cx, ev.y - cy
            ang = math.degrees(math.atan2(dy, dx)) % 360
            inside_angle = any(a0 <= ang + k <= a1 for k in (0, 360, -360))
            if dx * dx + dy * dy > rings[-1][1] ** 2 or not inside_angle:
                self.close_dial()           # outside the dial: close

    def on_key(self, _w, ev):
        k = Gdk.keyval_name(ev.keyval) or ''
        if k == 'Escape':
            if self.expanded is not None and not self.filter:
                self.expanded = None
                self.area.queue_draw()
            elif self.filter:
                self.filter = ''
                self.area.queue_draw()
            else:
                self.close_dial()
        elif k in ('Return', 'KP_Enter'):
            a = self.hover or (self.matches()[0] if self.filter and self.matches() else None)
            if a:
                self.launch(a)
        elif k == 'BackSpace':
            self.filter = self.filter[:-1]
            self.hover = None
            self.area.queue_draw()
        else:
            ch = chr(Gdk.keyval_to_unicode(ev.keyval)) if Gdk.keyval_to_unicode(ev.keyval) else ''
            if ch.isprintable() and ch and not (ev.state & Gdk.ModifierType.CONTROL_MASK):
                self.filter += ch
                self.hover = None
                self.area.queue_draw()
        return True

    def launch(self, a):
        if 'more' in a:                     # Enter on "+N": show the whole slice
            self.expanded, self.hover = a['more'], None
            self.area.queue_draw()
            return
        record(a['id'])
        try:
            info = Gio.DesktopAppInfo.new_from_filename(a['path'])
            if info:
                info.launch([], None)
        except GLib.Error as e:
            print(f'zorro-dial: {a["name"]}: {e.message}', file=sys.stderr)
        self.close_dial()

    def close_dial(self):
        Gdk.Display.get_default().get_default_seat().ungrab()
        Gtk.main_quit()


def main():
    if toggle_running():
        return
    PIDFILE.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *a: GLib.idle_add(Gtk.main_quit))
    try:
        Dial()
        Gtk.main()
    finally:
        try:
            if PIDFILE.read_text() == str(os.getpid()):
                PIDFILE.unlink()
        except OSError:
            pass


if __name__ == '__main__':
    main()
