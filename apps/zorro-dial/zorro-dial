def load_conf():
    c = json.loads(json.dumps(DEFAULTS))
    try:
        user = json.loads(CONF.read_text())
        c.update({k: v for k, v in user.items() if k in DEFAULTS and k != 'assign'})
        c['assign'].update(user.get('assign', {}))
    except (OSError, ValueError):
        pass
    return c


def save_arrangement(order, assign):
    """write the dragged order (and slice moves) into the config, keeping everything else"""
    try:
        user = json.loads(CONF.read_text())
    except (OSError, ValueError):
        user = {}
    user['order'] = order
    user['assign'] = {**user.get('assign', {}), **assign}
    CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix('.tmp')
    tmp.write_text(json.dumps(user, indent=2))
    tmp.replace(CONF)


def load_usage():
    try:
        u = json.loads(USAGE.read_text())
        return u if isinstance(u, dict) else {}
    except (OSError, ValueError):
        return {}


def record(app_id):
    u = load_usage()
    e = u.get(app_id, {'n': 0, 'last': 0})
    e['n'] = e.get('n', 0) + 1
    e['last'] = time.time()
    u[app_id] = e
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = USAGE.with_suffix('.tmp')
    tmp.write_text(json.dumps(u))
    tmp.replace(USAGE)


def score(u, app_id):
    """starts, with recent ones counting more (half-life two weeks)"""
    e = u.get(app_id)
    if not e:
        return 0.0
    age_days = (time.time() - e.get('last', 0)) / 86400
    return e.get('n', 0) * 0.5 ** (age_days / 14)


def apps():
    """installed apps: [{id, name, icon, cats, path}] from the .desktop files"""
    dirs = [HOME / '.local/share/applications'] + [
        Path(d) / 'applications' for d in
        os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share').split(':')]
    seen, out = set(), []
    for d in dirs:
        for f in sorted(d.glob('*.desktop')) if d.is_dir() else []:
            if f.name in seen:
                continue
            seen.add(f.name)
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(f, encoding='utf-8')
                e = cp['Desktop Entry']
            except (configparser.Error, KeyError, UnicodeDecodeError):
                continue
            if e.get('Type') != 'Application' or e.get('NoDisplay', 'false') == 'true' \
                    or e.get('Hidden', 'false') == 'true' or not e.get('Exec'):
                continue
            out.append({'id': f.name, 'name': e.get('Name', f.stem), 'icon': e.get('Icon', ''),
                        'cats': [c for c in e.get('Categories', '').split(';') if c],
                        'path': str(f), 'keywords': e.get('Keywords', '')})
    return out


ORB_CONF = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config')) / 'zorro-orb' / 'config.json'


def orb_conf():
    """where the info circle is (its size, corner and margin)"""
    c = {'size': 240, 'corner': 'bottom-right', 'margin': 28}
    try:
        user = json.loads(ORB_CONF.read_text())
        c.update({k: user[k] for k in c if k in user})
    except (OSError, ValueError):
        pass
    return c


def same(a, b):
    """the same button? Tiles are made new on every redraw, so compare what they are"""
    if a is b:
        return True
    if not a or not b:
        return False
    key = lambda x: (x.get('id'), x.get('name'), x.get('icon'), x.get('more'), x.get('gear'))
    return key(a) == key(b)


def toggle_running():
    """already open: close it and stop (Super pressed again)"""
    try:
        pid = int(PIDFILE.read_text())
        # a pid file left by a Dialer that died: that number may belong to anything now
        argv = [os.path.basename(x) for x in Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')]
        if not (argv[:1] == [b'zorro-dial'] or
                (argv[0].startswith(b'python') and argv[1:2] == [b'zorro-dial'])):
            return False
        os.kill(pid, signal.SIGTERM)
        return True
    except (OSError, ValueError):
        return False


class Dial(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.conf = load_conf()
        self.usage = load_usage()
        self.all = apps()
        self.filter = ''
        self.hover = None
        self.slots = []                 # (x, y, r, app, slice, position) placed this frame
        self.press = None               # (app, x, y) while the mouse button is down on an app
        self.drag = None                # (app, x, y) while an app is being dragged
        self.expanded = None            # a full slice shown across the dial ("+N" clicked)
        # the hub: six parts. Hover one: its preview; click: it stays and fills the fan
        self.mode = 'apps'              # Super always opens on the apps
        self.hub_hover = None           # a part's key, 'centre', or None
        self.armed = None               # (tile name, time): a confirm tile clicked once
        self.parts = dialmodes.PARTS
        self.path = {}                  # per tree part: the unfolded nodes, level by level
        self.kids = {}                  # node id -> its children (None while loading)
        self.dwell = None               # (node, level, since): resting on something that unfolds
        self.dwell_id = None
        self.hub_key = None             # a player button in the hub centre (music)
        self.preview = None             # the file whose preview is shown
        self.previews = {}              # file -> preview data (None while it is made)
        self.preview_pb = {}            # image file -> scaled picture
        self.fetching = set()           # parts whose data is being read (after the first frame)
        self.theme = Gtk.IconTheme.get_default()
        self.icons = {}
        disp = Gdk.Display.get_default()
        if self.conf.get('anchor') == 'orb':       # the info circle lives on the primary screen
            mon = disp.get_primary_monitor() or disp.get_monitor(0)
        else:
            mon = disp.get_monitor_at_point(*self.pointer()) or disp.get_primary_monitor() or disp.get_monitor(0)
        g = mon.get_geometry()
        self.geo = g
        scr = self.get_screen()
        self.composited = bool(scr.is_composited() and scr.get_rgba_visual())
        if self.composited:
            self.set_visual(scr.get_rgba_visual())
            self.backdrop = None
        else:                           # no compositor: a still image of the screen behind
            root = Gdk.get_default_root_window()
            self.backdrop = Gdk.pixbuf_get_from_window(root, g.x, g.y, g.width, g.height)
        self.set_app_paintable(True)
        self.move(g.x, g.y)
        self.resize(g.width, g.height)
        self.connect('draw', self.paint_back)     # 1. the screen behind, dimmed
        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK
                             | Gdk.EventMask.BUTTON_RELEASE_MASK)
        if zorro_fx:                    # 2. particles from the overlay look, around the dial
            self.snow = zorro_fx.Snow(self.area, radius=0, profile='overlay', fps=20, max_parts=900)
            self.snow.paint_edge = lambda *a: None
            self.snow.paint_box = lambda *a: None
        self.area.connect('draw', self.on_draw)   # 3. the dial
        self.area.connect('motion-notify-event', self.on_motion)
        self.area.connect('button-press-event', self.on_click)
        self.area.connect('button-release-event', self.on_release)
        self.add(self.area)
        self.connect('key-press-event', self.on_key)
        self.layout_apps()
        self.show_all()
        GLib.idle_add(self.grab)
        GLib.timeout_add_seconds(1, lambda: self.area.queue_draw() or True)
        # the parts' data (notes, messages, system state…) is read once the dial is on screen,
        # so it does not hold up the first frame; hovering a part reads it at once
        GLib.timeout_add(150, lambda: [self.start_fetch(p) for p in self.parts.values()] and False)

    def start_fetch(self, part):
        if part.key not in self.fetching:
            self.fetching.add(part.key)
            threading.Thread(target=self.fetch_part, args=(part,), daemon=True).start()

    def fetch_part(self, part):
        try:
            part.fetch()
        except Exception as e:          # noqa: BLE001 - one broken part must not stop the dial
            print(f'zorro-dial: {part.key}: {e}', file=sys.stderr)
        # the window may not be built yet when a quick part is done: redraw once it is
        GLib.idle_add(lambda: hasattr(self, 'area') and self.area.queue_draw() and False)

    def hub_at(self, x, y):
        """which part of the hub is under (x, y): a part's key, 'centre', or None"""
        cx, cy, hub, *_ = self.fan()
        dx, dy = x - cx, y - cy
        d2 = dx * dx + dy * dy
        if d2 > (hub - 4) ** 2:
            return None
        if d2 < (hub * 0.5) ** 2:
            return 'centre'
        ang = (math.degrees(math.atan2(dy, dx)) + 120) % 360      # part 0 is centred on top
        return dialmodes.MODES[int(ang // 60)][0]

    @staticmethod
    def pointer():
        try:
            _, x, y = Gdk.Display.get_default().get_default_seat().get_pointer().get_position()[0:3]
            return x, y
        except (AttributeError, TypeError):
            return 0, 0

    def grab(self):
        seat = Gdk.Display.get_default().get_default_seat()
        for _ in range(20):             # Openbox may still hold the key that started us
            if seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True,
                         None, None, None) == Gdk.GrabStatus.SUCCESS:
                break
            time.sleep(0.05)
        return False

    # -- which app goes where
    def layout_apps(self):
        """per slice: its apps by usage; the first ring_slots[0] on the inner ring, …"""
        slices = self.conf['slices'][:6]
        names = [s['name'] for s in slices]
        groups = [[] for _ in slices]
        hidden = set(self.conf.get('hide', []))
        if any(a['id'] == 'nemo.desktop' for a in self.all):
            hidden.add('thunar.desktop')        # one file manager in the slices: Nemo
        self.settings = []
        for a in self.all:
            if a['id'] != 'zorro-settings.desktop' and SETTINGS_CATS & set(a['cats']):
                self.settings.append(a)         # all settings apps: behind the gear
                continue
            if a['id'] in hidden:
                continue
            pick = self.conf.get('assign', {}).get(a['id'])
            if pick in names:
                idx = names.index(pick)
            else:
                idx = next((i for i, s in enumerate(slices)
                            if any(c in s['categories'] for c in a['cats'])), len(slices) - 1)
            groups[idx].append(a)
        # your dragged order first, then the rest by usage (most used inward)
        self.groups = []
        for s, g in zip(slices, groups):
            pinned = self.conf.get('order', {}).get(s['name'], [])
            byid = {a['id']: a for a in g}
            first = [byid[i] for i in pinned if i in byid]
            rest = sorted((a for a in g if a['id'] not in pinned),
                          key=lambda a: (-score(self.usage, a['id']), a['name'].lower()))
            self.groups.append(first + rest)
        zorro = next((a for a in self.all if a['id'] == 'zorro-settings.desktop'), None)
        self.settings.sort(key=lambda a: a['name'].lower())
        if zorro:
            self.settings.insert(0, zorro)
        if self.settings and self.groups:
            self.groups[-1].insert(0, {'id': '__gear__', 'name': 'Settings', 'icon': 'lucide:settings',
                                       'gear': True})

    def matches(self):
        f = self.filter.lower()
        found = [a for a in self.all if f in a['name'].lower() or f in a['keywords'].lower()
                 or f in a['id'].lower()]
        return sorted(found, key=lambda a: (not a['name'].lower().startswith(f),
                                            -score(self.usage, a['id']), a['name'].lower()))

    def lucide(self, name, size, alpha=0.75):
        key = ('lucide:' + name, size, alpha)
        if key not in self.icons:
            try:
                svg = (LUCIDE / f'{name}.svg').read_text()
                svg = svg.replace('stroke="currentColor"', f'stroke="#ffffff" stroke-opacity="{alpha}"')
                loader = GdkPixbuf.PixbufLoader.new_with_type('svg')
                loader.set_size(size, size)
                loader.write(svg.encode())
                loader.close()
                self.icons[key] = loader.get_pixbuf()
            except (OSError, GLib.Error):
                self.icons[key] = None
        return self.icons[key]

    def icon(self, a, size):
        if a.get('icon', '').startswith('lucide:'):
            return self.lucide(a['icon'][7:], int(size * 0.8))
        key = (a['icon'], size)
        if key not in self.icons:
            pb = None
            try:
                if os.path.isabs(a['icon']):
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(a['icon'], size, size)
                elif a['icon']:
                    pb = self.theme.load_icon(a['icon'], size, Gtk.IconLookupFlags.FORCE_SIZE)
            except GLib.Error:
                pb = None
            if pb is None:
                try:
                    pb = self.theme.load_icon('application-x-executable', size,
                                              Gtk.IconLookupFlags.FORCE_SIZE)
                except GLib.Error:
                    pb = None
            self.icons[key] = pb
        return self.icons[key]

    # -- drawing
    def text(self, cr, s, x, y, size, bold=True, alpha=1.0, split=1.4):
        # layouts are kept between frames (20 a second, dozens of labels each)
        cache = self.__dict__.setdefault('_layouts', {})
        key = (s, size, bold)
        hit = cache.get(key)
        if hit:
            lay, ext = hit
            PangoCairo.update_layout(cr, lay)
        else:
            lay = PangoCairo.create_layout(cr)
            lay.set_font_description(Pango.FontDescription.from_string(
                f'DejaVu Sans {"Bold" if bold else ""} {size}'))
            lay.set_text(s, -1)
            _, ext = lay.get_pixel_extents()
            if len(cache) > 400:
                cache.clear()
            cache[key] = (lay, ext)
        x0, y0 = x - ext.width / 2, y - ext.height / 2
        for col, dx in ((RED, -split), (CYAN, split)):
            cr.move_to(x0 + dx, y0)
            cr.set_source_rgba(*col, 0.5 * alpha)
            PangoCairo.show_layout(cr, lay)
        cr.move_to(x0, y0)
        cr.set_source_rgba(*FG, alpha)
        PangoCairo.show_layout(cr, lay)

    def chroma_circle(self, cr, cx, cy, r, alpha=0.9, split=1.5):
        for col, dx in ((RED, -split), (CYAN, split)):
            cr.new_path()
            cr.arc(cx + dx, cy, r, 0, 2 * math.pi)
            cr.set_source_rgba(*col, 0.7 * alpha)
            cr.set_line_width(1.2)
            cr.stroke()
        cr.new_path()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.2 * alpha)
        cr.set_line_width(1)
        cr.stroke()

    def paint_back(self, _w, cr):
        cr.save()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        if self.backdrop is not None:
            Gdk.cairo_set_source_pixbuf(cr, self.backdrop, 0, 0)
            cr.paint()
            cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_rgba(0, 0, 0, 0.55)
        cr.paint()
        cr.restore()
        return False

    def fan(self):
        """(cx, cy, hub radius, first angle, last angle, rings) in window coordinates.
        orb: the hub is the info circle's clock and the rings fan out from its corner into
        the screen (120 degrees); centre: full circle in the middle of the screen."""
        W, H = self.geo.width, self.geo.height
        if self.conf.get('anchor') == 'orb':
            if not hasattr(self, '_orb'):
                self._orb = orb_conf()      # read once: fan() runs on every draw and mouse move
            orb = self._orb
            d, m, corner = orb['size'], orb['margin'], orb['corner']
            cx = m + d / 2 if 'left' in corner else W - m - d / 2
            cy = m + d / 2 if 'top' in corner else H - m - d / 2
            mid = {'bottom-right': 225, 'bottom-left': 315, 'top-right': 135, 'top-left': 45}.get(corner, 225)
            hub = d / 2
            a0, a1 = mid - 60, mid + 60
        else:
            cx, cy, hub, a0, a1 = W / 2, H / 2, 86, -90, 270
        rings = [(hub + 12, hub + 96), (hub + 96, hub + 180), (hub + 180, hub + 270)]
        return cx, cy, hub, a0, a1, rings

    def on_draw(self, w, cr):
        cx, cy, hub, a0, a1, rings = self.fan()
        self.slots = []
        if self.filter and self.mode == 'notes':
            found = self.parts['notes'].search_tiles(self.filter)
            rows = [found[:6], found[6:15], found[15:27]] if found else \
                [[], [dialmodes.tile('lucide:search', 'No note has that', self.filter[:24], None)], []]
            self.draw_tiles(cr, cx, cy, rings, a0, a1, rows)
        elif self.filter and self.mode == 'music':
            self.draw_tiles(cr, cx, cy, rings, a0, a1, [[], [dialmodes.tile(
                'lucide:search', f'SoundCloud: {self.filter}'[:30], 'Enter: play', None)], []])
        elif self.filter:
            self.draw_search(cr, cx, cy, rings, a0, a1)
        elif self.mode != 'apps' and getattr(self.parts[self.mode], 'tree', False):
            part = self.parts[self.mode]
            if hasattr(part, 'draw_rim'):
                part.draw_rim(self, cr, cx, cy, rings, a0, a1)
            self.draw_tree(cr, cx, cy, rings, a0, a1, part)
        elif self.mode != 'apps':
            part = self.parts[self.mode]
            if hasattr(part, 'draw'):
                part.draw(self, cr, cx, cy, rings, a0, a1)
            self.draw_tiles(cr, cx, cy, rings, a0, a1, part.rings())
        elif self.expanded == 'gear':
            self.draw_search(cr, cx, cy, rings, a0, a1, self.settings)
        elif self.expanded is not None:
            self.draw_search(cr, cx, cy, rings, a0, a1, self.groups[self.expanded])
        else:
            self.draw_slices(cr, cx, cy, rings, a0, a1)
        outer = rings[-1][1]
        cr.new_path()
        cr.arc(cx, cy, outer, math.radians(a0), math.radians(a1))
        for col, dx in ((RED, -1.5), (CYAN, 1.5)):          # chromatic outer rim
            cr.save()
            cr.translate(dx, 0)
            cr.new_path()
            cr.arc(cx, cy, outer, math.radians(a0), math.radians(a1))
            cr.set_source_rgba(*col, 0.6)
            cr.set_line_width(1.2)
            cr.stroke()
            cr.restore()
        self.draw_hub(cr, cx, cy, hub)
        if self.mode == 'music' and not self.filter:
            self.music_keys(cr, cx, cy, hub)
        self.draw_preview(cr)
        am = math.radians((a0 + a1) / 2)
        if self.drag:
            a, x, y = self.drag
            pb = self.icon(a, 44)
            cr.new_path()
            cr.arc(x, y, 40, 0, 2 * math.pi)
            cr.set_source_rgba(*CYAN, 0.12)
            cr.fill()
            self.chroma_circle(cr, x, y, 40)
            if pb:
                Gdk.cairo_set_source_pixbuf(cr, pb, x - pb.get_width() / 2, y - pb.get_height() / 2)
                cr.paint()
        self.text(cr, 'type to search · drag to rearrange · Enter starts · Esc closes'
                  if self.mode == 'apps' else
                  'rest on something: it opens in the next ring · hold Super: at once · Esc: one back'
                  if getattr(self.parts.get(self.mode), 'tree', False) else
                  'click a part of the circle: it stays · Esc: back to apps',
                  cx + math.cos(am) * (outer + 115), cy + math.sin(am) * (outer + 115), 9,
                  bold=False, alpha=0.5, split=0)
        return False

    def draw_hub(self, cr, cx, cy, hub):
        """the middle circle in six parts: icons on the rim, the kept part lit; the centre
        shows the hovered app or tile, the hovered part's preview, or the kept part's"""
        cr.new_path()
        cr.arc(cx, cy, hub - 4, 0, 2 * math.pi)
        cr.set_source_rgba(0, 0, 0, 0.85)
        cr.fill()
        self.chroma_circle(cr, cx, cy, hub - 4)
        for i, (key, title, icon) in enumerate(dialmodes.MODES):
            a0 = -120 + i * 60
            lit = key == self.mode
            hov = key == self.hub_hover
            if lit or hov:
                cr.new_path()
                cr.move_to(cx, cy)
                cr.arc(cx, cy, hub - 6, math.radians(a0 + 1), math.radians(a0 + 59))
                cr.close_path()
                g = cairo.RadialGradient(cx, cy, hub * 0.45, cx, cy, hub)
                g.add_color_stop_rgba(0, *CYAN, 0)
                g.add_color_stop_rgba(1, *CYAN, 0.15 if lit else 0.07)
                cr.set_source(g)
                cr.fill()
                if lit:
                    for col, dr in ((RED, -1.2), (CYAN, 1.2)):
                        cr.new_path()
                        cr.arc(cx, cy, hub - 4 + dr, math.radians(a0 + 4), math.radians(a0 + 56))
                        cr.set_source_rgba(*col, 0.9)
                        cr.set_line_width(2.2)
                        cr.stroke()
            x1, y1 = cx + math.cos(math.radians(a0)) * hub * 0.74, cy + math.sin(math.radians(a0)) * hub * 0.74
            x2, y2 = cx + math.cos(math.radians(a0)) * (hub - 6), cy + math.sin(math.radians(a0)) * (hub - 6)
            cr.move_to(x1, y1)
            cr.line_to(x2, y2)
            cr.set_source_rgba(1, 1, 1, 0.1)
            cr.set_line_width(1)
            cr.stroke()
            am = math.radians(a0 + 30)
            pb = self.lucide(icon, max(14, int(hub / 6.5)), 0.95 if (lit or hov) else 0.4)
            if pb:
                ix, iy = cx + math.cos(am) * hub * 0.83, cy + math.sin(am) * hub * 0.83
                Gdk.cairo_set_source_pixbuf(cr, pb, ix - pb.get_width() / 2, iy - pb.get_height() / 2)
                cr.paint()
        k = hub / 120
        if self.hover:                                  # an app or a tile under the mouse
            armed = self.armed and self.armed[0] == self.hover.get('name') and time.time() - self.armed[1] < 3
            lines = [('click again' if armed else self.hover.get('sub', ''), 9 * k, False, 0.8)]
            self.text_block(cr, cx, cy, [(self.hover['name'][:24], 12 * k, True, 1)] + lines)
            return
        show = self.hub_hover if self.hub_hover in self.parts else (
            self.mode if self.mode != 'apps' and self.hub_hover != 'apps' else None)
        tree_path = self.path.get(show) if show == self.mode else None
        if show and not self.filter and tree_path:
            names = [n['name'] for n in tree_path]
            crumbs = ' › '.join(names[-3:])
            self.text_block(cr, cx, cy, [(self.parts[show].title.upper(), 8 * k, True, 0.55),
                                         (names[-1][:20], 13 * k, True, 1), (crumbs[-30:], 8 * k, False, 0.7),
                                         ('click: open · Esc: back', 8 * k, False,
                                          0.9 if self.hub_hover == 'centre' else 0.5)])
            return
        if show and not self.filter:
            title, big, lines = self.parts[show].preview()
            block = [(title, 8 * k, True, 0.55), (big, (28 if len(big) <= 5 else 15 if len(big) <= 11 else 11) * k, True, 1)]
            block += [(ln[:26], 9 * k, False, 0.8) for ln in lines[:2] if ln]
            c = self.parts[show].centre() if show == self.mode else None
            if c:
                block.append((f'click: {c[0]}', 8 * k, False, 0.9 if self.hub_hover == 'centre' else 0.5))
            self.text_block(cr, cx, cy, block)
            return
        label = (f'“{self.filter}”' if self.filter else 'Settings' if self.expanded == 'gear' else
                 self.conf['slices'][self.expanded]['name'] if self.expanded is not None else
                 time.strftime('%A %-d %B'))
        self.text_block(cr, cx, cy, [(time.strftime('%H:%M'), max(14, 26 * k), True, 1),
                                     (label[:22], max(8, 10 * k), False, 0.9)])

    MUSIC_KEYS = (('skip-back', 'prev', -42), ('play', 'toggle', -14), ('square', 'stop', 14),
                  ('skip-forward', 'next', 42))

    def music_keys(self, cr, cx, cy, hub):
        """previous / play-pause / stop / next in the centre of the circle"""
        np = getattr(self.parts['music'], 'np', None)
        y = cy + hub * 0.33
        for icon, what, dx in self.MUSIC_KEYS:
            if what == 'toggle' and np and np.get('playing'):
                icon = 'pause'
            hov = self.hub_key == what
            if hov:
                cr.new_path()
                cr.arc(cx + dx, y, 12, 0, 2 * math.pi)
                cr.set_source_rgba(*CYAN, 0.18)
                cr.fill()
            pb = self.lucide(icon, 16, 0.95 if hov else 0.6)
            if pb:
                Gdk.cairo_set_source_pixbuf(cr, pb, cx + dx - 8, y - 8)
                cr.paint()

    def music_key_at(self, x, y):
        if self.mode != 'music':
            return None
        cx, cy, hub, *_ = self.fan()
        return next((w for _, w, dx in self.MUSIC_KEYS
                     if (x - cx - dx) ** 2 + (y - cy - hub * 0.33) ** 2 <= 13 ** 2), None)

    def text_block(self, cr, cx, cy, block):
        heights = [size * 1.8 for _, size, _, _ in block]
        if self.mode == 'music' and not self.filter:
            cy -= 14                    # room for the player buttons underneath
        y = cy - sum(heights) / 2
        for (s, size, bold, a), h in zip(block, heights):
            self.text(cr, s, cx, y + h / 2, max(7, size), bold=bold, alpha=a, split=1.6 if bold else 0.8)
            y += h

    # -- trees: each level in the next ring, unfolding where the mouse rests
    DWELL = 0.4

    def node_key(self, n):
        return n.get('id') or n.get('name')

    def tree_levels(self, part):
        levels = [part.roots()]
        for n in self.path.get(part.key, []):
            kids = self.kids.get(self.node_key(n))
            levels.append([dialmodes.tile('lucide:ellipsis', 'opening…', '', None, id='__loading')]
                          if kids is None else kids)
        return levels

    def expand(self, node, level):
        """unfold node: its children (read in a thread) show in the next ring"""
        path = self.path.setdefault(self.mode, [])
        del path[level:]
        path.append(node)
        key = self.node_key(node)
        if key not in self.kids:
            self.kids[key] = None

            def work():
                try:
                    kids = node['kids']()
                except Exception:       # noqa: BLE001 - an unreadable folder: just empty
                    kids = []
                self.kids[key] = kids
                GLib.idle_add(lambda: self.area.queue_draw() and False)
            threading.Thread(target=work, daemon=True).start()
        self.dwell = None
        self.area.queue_draw()

    def unfold(self, node, level):
        """a folder opens in the next ring; a file shows its preview"""
        if node.get('kids'):
            self.expand(node, level)
        elif node.get('preview'):
            self.show_preview(node)

    def show_preview(self, node):
        self.preview, self.dwell = node, None
        key = self.node_key(node)
        if key not in self.previews:
            self.previews[key] = None

            def work():
                try:
                    data = node['preview']()
                except Exception as e:  # noqa: BLE001 - a broken file: say so
                    data = {'title': node['name'], 'meta': '', 'image': None, 'lines': [str(e)[:70]]}
                self.previews[key] = data
                GLib.idle_add(lambda: self.area.queue_draw() and False)
            threading.Thread(target=work, daemon=True).start()
        self.area.queue_draw()

    def draw_preview(self, cr):
        """the panel beside the dial: picture or first lines, name, size and date"""
        if not self.preview:
            return
        data = self.previews.get(self.node_key(self.preview))
        cx, cy, hub, a0, a1, rings = self.fan()
        outer = rings[-1][1]
        sw, sh = self.geo.width, self.geo.height
        try:
            W = int(self.conf.get('preview_size', 460))
        except (TypeError, ValueError):
            W = 460
        W = max(280, min(W, sw - 32))
        H = min(int(W * 0.78), sh - 32)
        x = cx - outer - W - 40 if cx > sw / 2 else cx + outer + 40
        x = max(16, min(sw - W - 16, x))
        y = max(16, min(sh - H - 16, cy - H + 40 if cy > sh / 2 else cy - 40))
        r = 14
        cr.new_path()
        cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
        cr.arc(x + W - r, y + r, r, 1.5 * math.pi, 0)
        cr.arc(x + W - r, y + H - r, r, 0, 0.5 * math.pi)
        cr.arc(x + r, y + H - r, r, 0.5 * math.pi, math.pi)
        cr.close_path()
        cr.set_source_rgba(0.02, 0.02, 0.04, 0.93)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.1)
        cr.set_line_width(1)
        cr.stroke()
        for col, dx in ((RED, -1.2), (CYAN, 1.2)):           # chromatic top edge
            cr.move_to(x + r + dx, y + 0.5)
            cr.line_to(x + W - r + dx, y + 0.5)
            cr.set_source_rgba(*col, 0.6)
            cr.stroke()
        if data is None:
            self.text(cr, 'making the preview…', x + W / 2, y + H / 2, 10, bold=False, alpha=0.6, split=0)
            return
        area_h = H - 70
        if data.get('image'):
            pb = self.preview_pb.get(data['image'])
            if pb is None:
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(data['image'], W - 28, area_h - 10, True)
                except GLib.Error:
                    pb = False
                self.preview_pb[data['image']] = pb
            if pb:
                Gdk.cairo_set_source_pixbuf(cr, pb, x + (W - pb.get_width()) / 2, y + 14 + (area_h - 10 - pb.get_height()) / 2)
                cr.paint()
        elif data.get('lines'):
            lay = PangoCairo.create_layout(cr)
            lay.set_font_description(Pango.FontDescription.from_string(f'DejaVu Sans Mono {max(8, min(12, round(W / 52)))}'))
            lay.set_width(int((W - 28) * Pango.SCALE))
            lay.set_ellipsize(Pango.EllipsizeMode.END)
            lay.set_text('\n'.join(data['lines']), -1)
            cr.save()
            cr.rectangle(x + 14, y + 14, W - 28, area_h - 8)
            cr.clip()
            cr.move_to(x + 14, y + 14)
            cr.set_source_rgba(*FG, 0.85)
            PangoCairo.show_layout(cr, lay)
            cr.restore()
        cr.move_to(x + 14, y + H - 50)
        cr.line_to(x + W - 14, y + H - 50)
        cr.set_source_rgba(1, 1, 1, 0.08)
        cr.stroke()
        lay = PangoCairo.create_layout(cr)
        lay.set_font_description(Pango.FontDescription.from_string('DejaVu Sans Bold 10'))
        lay.set_width(int((W - 28) * Pango.SCALE))
        lay.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        lay.set_text(data.get('title', ''), -1)
        cr.move_to(x + 14, y + H - 42)
        cr.set_source_rgba(*FG, 1)
        PangoCairo.show_layout(cr, lay)
        lay = PangoCairo.create_layout(cr)
        lay.set_font_description(Pango.FontDescription.from_string('DejaVu Sans 8'))
        lay.set_text(data.get('meta', ''), -1)
        cr.move_to(x + 14, y + H - 22)
        cr.set_source_rgba(*FG, 0.6)
        PangoCairo.show_layout(cr, lay)

    def dwell_tick(self):
        if not self.dwell or not same(self.hover, self.dwell[0]):
            self.dwell, self.dwell_id = None, None
            self.area.queue_draw()
            return False
        if time.time() - self.dwell[2] >= self.DWELL:
            self.dwell_id = None
            self.unfold(self.dwell[0], self.dwell[1])
            return False
        self.area.queue_draw()
        return True

    def draw_tree(self, cr, cx, cy, rings, a0, a1, part):
        levels = self.tree_levels(part)
        path = self.path.get(part.key, [])
        start = max(0, len(levels) - 3)           # deeper than three: the tree moves inward
        parent_angle, parent_r = None, None
        for k, items in enumerate(levels[start:start + 3]):
            lv = start + k
            ri, ro = rings[k]
            rm = (ri + ro) / 2
            size = (30, 27, 25)[k]
            # room per item: the first ring is icons only (a name on hover), the others have names
            step = math.degrees((44 if k == 0 else 74) / rm)
            cap = max(2, int((a1 - a0 - 4) / step))
            items = list(items)
            if len(items) > cap:                   # never dropped silently: "N more" unfolds the rest
                parent = path[lv - 1] if lv > 0 else None
                rest = items[cap - 1:]
                where = self.node_key(parent) if parent else part.key
                items = items[:cap - 1] + [dialmodes.tile(
                    'lucide:ellipsis', f'{len(rest)} more', 'rest here: the others',
                    parent and parent.get('act'), id=f'__more{lv}:{where}:{len(rest)}',
                    kids=lambda r=rest: r)]
            n = max(1, len(items))
            if parent_angle is None:
                s0, s1 = a0, a1
            else:
                w = min(a1 - a0 - 4, n * step)
                s0 = max(a0 + 2, min(a1 - 2 - w, parent_angle - w / 2))
                s1 = s0 + w
                cr.new_path()                      # the band the children sit in
                cr.arc(cx, cy, ro - 2, math.radians(s0 - 2), math.radians(s1 + 2))
                cr.arc_negative(cx, cy, ri + 2, math.radians(s1 + 2), math.radians(s0 - 2))
                cr.close_path()
                cr.set_source_rgba(0.03, 0.03, 0.05, 0.62)
                cr.fill_preserve()
                cr.set_source_rgba(1, 1, 1, 0.07)
                cr.set_line_width(1)
                cr.stroke()
                pa = math.radians(parent_angle)    # a thin chromatic line from parent to children
                for col, dx in ((RED, -0.8), (CYAN, 0.8)):
                    cr.move_to(cx + math.cos(pa) * (parent_r + 26) + dx, cy + math.sin(pa) * (parent_r + 26))
                    cr.line_to(cx + math.cos(pa) * (ri + 4) + dx, cy + math.sin(pa) * (ri + 4))
                    cr.set_source_rgba(*col, 0.35)
                    cr.set_line_width(1)
                    cr.stroke()
            next_angle = None
            for j, t in enumerate(items):
                a = s0 + (s1 - s0) * (j + 0.5) / n
                x, y = cx + math.cos(math.radians(a)) * rm, cy + math.sin(math.radians(a)) * rm
                self.slots.append((x, y, size * 0.9, t, lv, None))
                is_open = lv < len(path) and same(path[lv], t)
                if is_open:
                    next_angle = a
                hov = same(self.hover, t)
                if is_open or hov:
                    cr.new_path()
                    cr.arc(x, y, size * 0.85, 0, 2 * math.pi)
                    cr.set_source_rgba(*CYAN, 0.16 if is_open else 0.09)
                    cr.fill()
                    self.chroma_circle(cr, x, y, size * 0.85, alpha=0.8 if is_open else 0.5)
                if self.dwell and same(self.dwell[0], t):          # the unfold timer
                    f = min(1.0, (time.time() - self.dwell[2]) / self.DWELL)
                    for col, dx in ((RED, -1), (CYAN, 1)):
                        cr.new_path()
                        cr.arc(x + dx, y, size * 0.85 + 5, -math.pi / 2, -math.pi / 2 + 2 * math.pi * f)
                        cr.set_source_rgba(*col, 0.9)
                        cr.set_line_width(2.2)
                        cr.stroke()
                pb = self.icon(t, size)
                if pb:
                    Gdk.cairo_set_source_pixbuf(cr, pb, x - pb.get_width() / 2, y - pb.get_height() / 2 - 3)
                    cr.paint()
                if t.get('kids'):              # a chevron: it unfolds (files show a preview instead)
                    ch = self.lucide('chevron-right', 10, 0.4)
                    if ch:
                        Gdk.cairo_set_source_pixbuf(cr, ch, x + size * 0.55, y - size * 0.75)
                        cr.paint()
                if k > 0 or is_open or hov:
                    name = t['name'] if (is_open or hov) else (t['name'][:13] + '…' if len(t['name']) > 14 else t['name'])
                    self.text(cr, name[:22], x, y + size * 0.7 + 8, 8, bold=is_open or hov,
                              alpha=0.9, split=0.8 if is_open else 0)
            parent_angle, parent_r = next_angle, rm

    def draw_tiles(self, cr, cx, cy, rings, a0, a1, rows):
        """a part's three rings of tiles: icon, label, and an optional value ring"""
        for k, ((ri, ro), row) in enumerate(zip(rings, rows)):
            rm = (ri + ro) / 2
            size = (40, 34, 30)[k]
            for j, t in enumerate(row):
                am = math.radians(a0 + (a1 - a0) * (j + 0.5) / len(row))
                x, y = cx + math.cos(am) * rm, cy + math.sin(am) * rm
                self.slots.append((x, y, size * 0.85, t, None, None))
                armed = self.armed and self.armed[0] == t['name'] and time.time() - self.armed[1] < 3
                if t.get('lit') or same(self.hover, t) or armed:
                    cr.new_path()
                    cr.arc(x, y, size * 0.75, 0, 2 * math.pi)
                    cr.set_source_rgba(*((1, .2, .3) if armed else CYAN), 0.18 if t.get('lit') or armed else 0.1)
                    cr.fill()
                    self.chroma_circle(cr, x, y, size * 0.75, alpha=0.8 if t.get('lit') else 0.5)
                if t.get('value') is not None:
                    cr.new_path()
                    cr.arc(x, y, size * 0.75, 0, 2 * math.pi)
                    cr.set_source_rgba(1, 1, 1, 0.08)
                    cr.set_line_width(3)
                    cr.stroke()
                    for col, dx in ((RED, -1), (CYAN, 1)):
                        cr.new_path()
                        cr.arc(x + dx, y, size * 0.75, -math.pi / 2, -math.pi / 2 + 2 * math.pi * max(0, min(1, t['value'])))
                        cr.set_source_rgba(*col, 0.85)
                        cr.set_line_width(2.5)
                        cr.stroke()
                pb = self.icon(t, size)
                if pb:
                    Gdk.cairo_set_source_pixbuf(cr, pb, x - pb.get_width() / 2, y - pb.get_height() / 2)
                    cr.paint()
                self.text(cr, t['name'][:18], x, y + size * 0.75 + 10, 8, bold=False, alpha=0.85, split=0)

    @staticmethod
    def fits(rm, span_deg, size):
        """how many icons of this size fit on an arc"""
        return max(1, int(rm * math.radians(span_deg) / (size * 1.45)))

    def draw_slices(self, cr, cx, cy, rings, a0, a1):
        slices = self.conf['slices'][:6]
        n = len(slices)
        span = (a1 - a0) / n
        for i, s in enumerate(slices):
            start = a0 + i * span
            for k, (ri, ro) in enumerate(rings):
                b0, b1 = math.radians(start + 0.6), math.radians(start + span - 0.6)
                cr.new_path()
                cr.arc(cx, cy, ro - 2, b0, b1)
                cr.arc_negative(cx, cy, ri + 2, b1, b0)
                cr.close_path()
                cr.set_source_rgba(0.03, 0.03, 0.05, 0.55)
                cr.fill_preserve()
                cr.set_source_rgba(1, 1, 1, 0.07)
                cr.set_line_width(1)
                cr.stroke()
            am = math.radians(start + span / 2)
            r_lab = rings[-1][1] + 20
            self.text(cr, s['name'].upper(), cx + math.cos(am) * r_lab, cy + math.sin(am) * r_lab,
                      9, split=1.4)
            group = list(self.groups[i])
            caps = []
            for k, (ri, ro) in enumerate(rings):
                size = (44, 36, 30)[k]
                rm = (ri + ro) / 2
                caps.append(min(self.conf['ring_slots'][k], self.fits(rm, span, size))
                            if self.conf.get('anchor') != 'orb' else self.fits(rm, span, size))
            if len(group) > sum(caps):           # never drop apps silently: "+N" shows them all
                extra = len(group) - sum(caps) + 1
                group = group[:sum(caps) - 1] + [{'id': f'__more__{i}', 'name': f'{extra} more',
                                                  'icon': '', 'more': i, 'extra': extra}]
            pos = 0
            for k, (ri, ro) in enumerate(rings):
                size = (44, 36, 30)[k]
                rm = (ri + ro) / 2
                cnt = min(self.conf['ring_slots'][k], self.fits(rm, span, size)) \
                    if self.conf.get('anchor') != 'orb' else self.fits(rm, span, size)
                row, group = group[:cnt], group[cnt:]
                self.place(cr, cx, cy, row, rm, start, span, size, where=(i, pos))
                pos += len(row)

    def draw_search(self, cr, cx, cy, rings, a0, a1, items=None):
        found = list(items) if items is not None else self.matches()
        for k, (ri, ro) in enumerate(rings):
            size = (44, 36, 30)[k]
            rm = (ri + ro) / 2
            cnt = self.fits(rm, a1 - a0, size)
            row, found = found[:cnt], found[cnt:]
            if row:
                self.place(cr, cx, cy, row, rm, a0, a1 - a0, size, full=cnt)

    def place(self, cr, cx, cy, row, rm, start, span, size, full=None, where=None):
        cnt = full or len(row)
        for j, a in enumerate(row):
            am = math.radians(start + span * ((j + 0.5) / cnt if full else (j + 1) / (len(row) + 1)))
            x, y = cx + math.cos(am) * rm, cy + math.sin(am) * rm
            self.slots.append((x, y, size * 0.75, a) + ((where[0], where[1] + j) if where else (None, None)))
            if self.drag and self.drag[0] is a:              # its place, while it is dragged
                cr.new_path()
                cr.arc(x, y, size * 0.6, 0, 2 * math.pi)
                cr.set_source_rgba(1, 1, 1, 0.12)
                cr.set_line_width(1)
                cr.stroke()
                continue
            if same(self.hover, a):
                cr.new_path()
                cr.arc(x, y, size * 0.9, 0, 2 * math.pi)
                cr.set_source_rgba(*CYAN, 0.16)
                cr.fill()
                self.chroma_circle(cr, x, y, size * 0.9)
            if 'more' in a:
                cr.new_path()
                cr.arc(x, y, size * 0.55, 0, 2 * math.pi)
                cr.set_source_rgba(1, 1, 1, 0.08)
                cr.fill()
                self.chroma_circle(cr, x, y, size * 0.55, alpha=0.6, split=1)
                self.text(cr, f'+{a["extra"]}', x, y, max(8, size / 4), split=1)
                continue
            pb = self.icon(a, size)
            if pb:
                Gdk.cairo_set_source_pixbuf(cr, pb, x - pb.get_width() / 2, y - pb.get_height() / 2)
                cr.paint()

    # -- input
    def hit(self, x, y, slot=False):
        s = next((s for s in self.slots if (x - s[0]) ** 2 + (y - s[1]) ** 2 <= s[2] * s[2]), None)
        return s if slot else (s[3] if s else None)

    def slice_at(self, x, y):
        """index of the slice under (x, y), or None outside the fan"""
        cx, cy, hub, a0, a1, rings = self.fan()
        dx, dy = x - cx, y - cy
        if not hub ** 2 <= dx * dx + dy * dy <= (rings[-1][1] + 30) ** 2:
            return None
        rel = (math.degrees(math.atan2(dy, dx)) - a0) % 360
        n = len(self.conf['slices'][:6])
        return int(rel / ((a1 - a0) / n)) if rel <= a1 - a0 else None

    def on_motion(self, _w, ev):
        if self.press and not self.drag and not self.filter and self.expanded is None \
                and self.mode == 'apps' and 'more' not in self.press[0] \
                and not self.press[0].get('gear'):
            a, px, py = self.press
            if (ev.x - px) ** 2 + (ev.y - py) ** 2 > 12 ** 2:
                self.drag = (a, ev.x, ev.y)
        if self.drag:
            self.drag = (self.drag[0], ev.x, ev.y)
            target = self.hit(ev.x, ev.y)
            self.hover = target if target is not self.drag[0] else None
            self.area.queue_draw()
            return
        slot = self.hit(ev.x, ev.y, slot=True)
        h = slot[3] if slot else None
        z = self.hub_at(ev.x, ev.y)
        key = self.music_key_at(ev.x, ev.y)
        if not same(h, self.hover) or z != self.hub_hover or key != self.hub_key:
            self.hover, self.hub_hover, self.hub_key = h, z, key
            if z in self.parts:
                self.start_fetch(self.parts[z])
            self.area.queue_draw()
        part = self.parts.get(self.mode)
        if self.preview and not same(h, self.preview):
            self.preview = None             # moved on: the preview goes
            self.area.queue_draw()
        if h and (h.get('kids') or h.get('preview')) and part is not None and getattr(part, 'tree', False):
            lv = slot[4]
            path = self.path.get(self.mode, [])
            done = same(self.preview, h) if not h.get('kids') else (lv < len(path) and same(path[lv], h))
            if not done:
                if ev.state & Gdk.ModifierType.MOD4_MASK:      # Super held: at once
                    self.unfold(h, lv)
                elif not (self.dwell and same(self.dwell[0], h)):
                    self.dwell = (h, lv, time.time())
                    if not self.dwell_id:
                        self.dwell_id = GLib.timeout_add(30, self.dwell_tick)
        elif self.dwell and not same(h, self.dwell[0]):
            self.dwell = None

    def on_release(self, _w, ev):
        press, drag = self.press, self.drag
        self.press = self.drag = None
        if ev.button != 1 or not press:
            return
        if not drag:                        # a click: start the app
            if same(self.hit(ev.x, ev.y), press[0]):
                self.activate(press[0])
            return
        self.drop(drag[0], ev.x, ev.y)
        self.area.queue_draw()

    def drop(self, a, x, y):
        """put the dragged app before the app it was dropped on, or at the end of the slice"""
        slot = self.hit(x, y, slot=True)
        if slot and slot[4] is not None:
            gi, pos = slot[4], slot[5]
        else:
            gi = self.slice_at(x, y)
            if gi is None:
                return                      # dropped outside: nothing changes
            pos = len(self.groups[gi])
        src = next(i for i, g in enumerate(self.groups) if a in g)
        old = self.groups[src].index(a)
        self.groups[src].remove(a)
        if src == gi and old < pos:
            pos -= 1
        self.groups[gi].insert(pos, a)
        names = [s['name'] for s in self.conf['slices'][:6]]
        order = dict(self.conf.get('order', {}))
        for i in {src, gi}:
            order[names[i]] = [b['id'] for b in self.groups[i]]
        assign = {a['id']: names[gi]} if gi != src else {}
        self.conf['order'] = order
        self.conf['assign'].update(assign)
        save_arrangement(order, assign)

    def on_click(self, _w, ev):
        a = self.hit(ev.x, ev.y)
        z = self.hub_at(ev.x, ev.y)
        if a and ev.button == 3 and a.get('remove'):    # right-click a message: dismiss it
            part = self.parts.get(self.mode)
            threading.Thread(target=lambda: (a['remove'](), part and part.fetch(),
                                             GLib.idle_add(self.area.queue_draw)), daemon=True).start()
        elif a and ev.button == 1:
            self.press = (a, ev.x, ev.y)    # start on release; moving it drags instead
        elif z == 'centre' and ev.button == 1 and self.music_key_at(ev.x, ev.y):
            what = self.music_key_at(ev.x, ev.y)
            threading.Thread(target=lambda: (self.parts['music'].control(what),
                                             GLib.idle_add(self.area.queue_draw)), daemon=True).start()
        elif z and ev.button == 1:
            if z == 'centre' and self.path.get(self.mode) and self.path[self.mode][-1].get('act'):
                self.path[self.mode][-1]['act']()           # open where you are in the tree
                self.close_dial()
            elif z == 'centre':
                c = self.parts[self.mode].centre() if self.mode in self.parts else None
                if c:
                    part = self.parts[self.mode]
                    threading.Thread(target=lambda: (c[1](), GLib.idle_add(self.area.queue_draw)),
                                     daemon=True).start()
                    if part.key in ('notes', 'files'):
                        self.close_dial()
            else:                           # a part of the circle: it stays (again: back to apps)
                self.mode = 'apps' if z == self.mode else z
                self.expanded, self.filter, self.hover = None, '', None
                self.area.queue_draw()
        elif not a:
            cx, cy, hub, a0, a1, rings = self.fan()
            dx, dy = ev.x - cx, ev.y - cy
            ang = math.degrees(math.atan2(dy, dx)) % 360
            inside_angle = any(a0 <= ang + k <= a1 for k in (0, 360, -360))
            if dx * dx + dy * dy > rings[-1][1] ** 2 or not inside_angle:
                self.close_dial()           # outside the dial: close

    def on_key(self, _w, ev):
        k = Gdk.keyval_name(ev.keyval) or ''
        if k.startswith('Super') or ev.state & Gdk.ModifierType.MOD4_MASK:
            return True                     # holding Super unfolds; its xcape Super+Space is not typing
        if k == 'Escape':
            if self.mode != 'apps' and self.path.get(self.mode) and not self.filter:
                self.path[self.mode].pop()  # one level back
                self.area.queue_draw()
            elif self.mode != 'apps' and not self.filter:
                self.mode = 'apps'
                self.area.queue_draw()
            elif self.expanded is not None and not self.filter:
                self.expanded = None
                self.area.queue_draw()
            elif self.filter:
                self.filter = ''
                self.area.queue_draw()
            else:
                self.close_dial()
        elif k in ('Return', 'KP_Enter') and self.mode in ('music', 'notes') and self.filter:
            self.parts[self.mode].search(self.filter)
            if self.mode == 'notes':
                self.close_dial()           # the note opens in Obsidian
                return True
            self.filter = ''
            self.area.queue_draw()
        elif k in ('Return', 'KP_Enter'):
            a = self.hover or (self.matches()[0] if self.filter and self.matches() else None)
            if a:
                self.activate(a)
        elif k == 'BackSpace':
            self.filter = self.filter[:-1]
            self.hover = None
            self.area.queue_draw()
        else:
            ch = chr(Gdk.keyval_to_unicode(ev.keyval)) if Gdk.keyval_to_unicode(ev.keyval) else ''
            if ch.isprintable() and ch and not (ev.state & Gdk.ModifierType.CONTROL_MASK):
                self.filter += ch
                self.hover = None
                self.area.queue_draw()
        return True

    def activate(self, a):
        """a click (or Enter) on something in the fan"""
        if 'more' in a:                     # "+N": the whole slice
            self.expanded, self.hover = a['more'], None
        elif a.get('gear'):                 # the gear: all settings apps
            self.expanded, self.hover = 'gear', None
        elif a.get('tile'):
            if a.get('confirm') and not (self.armed and self.armed[0] == a['name']
                                         and time.time() - self.armed[1] < 3):
                self.armed = (a['name'], time.time())        # dangerous: click once more
                GLib.timeout_add(3100, lambda: self.area.queue_draw() and False)
            elif a.get('act'):
                act = a['act']
                if a.get('keep'):           # a switch: do it, then show the new state
                    path = self.path.get(self.mode) or []
                    part = self.parts.get(self.mode)

                    def work():
                        act()
                        if a.get('refresh') and part:   # the data changed (dismissed, cleared)
                            part.fetch()
                        GLib.idle_add(lambda: done() and False)

                    def done():
                        if a.get('refresh'):
                            del path[max(0, len(path) - a.get('up', 0)):]   # gone: back up the tree
                            self.kids.clear()
                            for i, n in enumerate(list(path)):
                                self.expand(n, i)
                        elif path:          # a tree: read that branch again (Like -> Unlike)
                            self.kids.pop(self.node_key(path[-1]), None)
                            self.expand(path[-1], len(path) - 1)
                        self.area.queue_draw()
                    threading.Thread(target=work, daemon=True).start()
                else:
                    act()
                    self.close_dial()
                    return
            elif a.get('kids'):         # nothing to start ("N more"): a click unfolds it
                lv = next((sl[4] for sl in self.slots if same(sl[3], a)), None)
                if lv is not None:
                    self.unfold(a, lv)
        else:
            self.launch(a)
            return
        self.area.queue_draw()

    def launch(self, a):
        if 'more' in a or a.get('gear') or a.get('tile'):
            self.activate(a)
            return
        record(a['id'])
        try:
            info = Gio.DesktopAppInfo.new_from_filename(a['path'])
            if info:
                info.launch([], None)
        except GLib.Error as e:
            print(f'zorro-dial: {a["name"]}: {e.message}', file=sys.stderr)
        self.close_dial()

    def close_dial(self):
        Gdk.Display.get_default().get_default_seat().ungrab()
        Gtk.main_quit()


def main():
    if toggle_running():
        return
    PIDFILE.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, lambda *a: GLib.idle_add(Gtk.main_quit))
    try:
        Dial()
        Gtk.main()
    finally:
        try:
            if PIDFILE.read_text() == str(os.getpid()):
                PIDFILE.unlink()
        except OSError:
            pass


if __name__ == '__main__':
    main()
