#!/usr/bin/python3
"""zorro-greeter: the zorro login and lock screen (GTK3 + WebKitGTK).

  zorro-greeter            run by zorro-dm (talks over $ZORRO_DM_FD);
                           $ZORRO_MODE=lock + $ZORRO_USER: unlock screen for that user
  zorro-greeter --preview [--look FILE]  in a normal window, password 'test' (theme work)

The theme (index.html + js/login.js) talks to a 'window.lightdm' object, the same
API nody-greeter offers, so it runs unchanged here and there.
"""
import json
import os
import pwd
import socket
import subprocess
import sys

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('WebKit2', '4.1')
from gi.repository import Gdk, GLib, Gtk, WebKit2  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
THEME = next(d for d in (os.environ.get('ZORRO_THEME', ''), os.path.join(HERE, 'theme'),
                         '/usr/share/zorro-dm/theme') if d and os.path.isdir(d))

LOOK_FILE = os.environ.get('ZORRO_LOOK_FILE', '/etc/zorro-dm/look.json')


def look_script():
    """the background look (Zorro app → Look) for the theme's fx.js"""
    try:
        with open(LOOK_FILE) as fh:
            look = json.load(fh)
        if not isinstance(look, dict):
            look = {}
    except (OSError, ValueError):
        look = {}
    try:                                # on battery: a calmer background
        with open('/sys/class/power_supply/AC/online') as fh:
            if fh.read().strip() == '0':
                look['fps'] = min(float(look.get('fps') or 30), 12)
                look['fps_min'] = min(float(look.get('fps_min') or 8), 8)
    except OSError:
        pass
    return 'window.ZORRO_LOOK = ' + json.dumps(look) + ';'


SHIM = r"""
(() => {
  const sig = () => { const f = []; return {
    connect: (fn) => f.push(fn),
    disconnect: (fn) => { const i = f.indexOf(fn); if (i >= 0) f.splice(i, 1); },
    _emit: (...a) => f.forEach((fn) => { try { fn(...a); } catch (e) { console.error(e); } }) }; };
  const post = (m) => window.webkit.messageHandlers.zorro.postMessage(JSON.stringify(m));
  const L = Object.assign(__INFO__, {
    in_authentication: false, is_authenticated: false, authentication_user: null,
    show_prompt: sig(), show_message: sig(), authentication_complete: sig(),
    authenticate(u) { this.in_authentication = true; this.is_authenticated = false;
      this.authentication_user = u || null; post({cmd: 'authenticate', user: u || null}); return true; },
    cancel_authentication() { this.in_authentication = false; post({cmd: 'cancel'}); return true; },
    respond(t) { post({cmd: 'respond', text: String(t)}); return true; },
    start_session(k) { post({cmd: 'start_session', session: k || this.default_session}); return true; },
    suspend() { post({cmd: 'power', action: 'suspend'}); return true; },
    restart() { post({cmd: 'power', action: 'reboot'}); return true; },
    shutdown() { post({cmd: 'power', action: 'poweroff'}); return true; },
    face() { post({cmd: 'face'}); return true; },
  });
  window.lightdm = L;
  window.__zorro = (m) => {
    if (m.type === 'prompt') L.show_prompt._emit(m.text, m.secret ? 1 : 0);
    else if (m.type === 'message') L.show_message._emit(m.text, m.error ? 1 : 0);
    else if (m.type === 'face') window.dispatchEvent(new CustomEvent('zorroface', {detail: m}));
    else if (m.type === 'complete') {
      L.in_authentication = false; L.is_authenticated = !!m.ok;
      L.authentication_complete._emit();
    }
  };
  window.addEventListener('DOMContentLoaded',
    () => setTimeout(() => window.dispatchEvent(new Event('GreeterReady')), 0));
})();
"""


def login_users():
    users = []
    for p in sorted(pwd.getpwall(), key=lambda p: p.pw_uid):
        if 1000 <= p.pw_uid < 60000 and not p.pw_shell.endswith(('nologin', 'false')):
            users.append({'username': p.pw_name,
                          'display_name': p.pw_gecos.split(',')[0] or p.pw_name})
    return users



# ---- backends: who checks the password -------------------------------------------

class DaemonBackend:
    """Login screen: zorro-dm does PAM; we pass messages back and forth."""

    def __init__(self, emit, quit_):
        self.sock = socket.socket(fileno=int(os.environ['ZORRO_DM_FD']))
        self.emit, self.quit, self.buf = emit, quit_, b''
        GLib.io_add_watch(self.sock.fileno(), GLib.PRIORITY_DEFAULT,
                          GLib.IOCondition.IN | GLib.IOCondition.HUP, self.on_data)

    def on_data(self, *_):
        data = self.sock.recv(65536)
        if not data:
            self.quit()
            return False
        self.buf += data
        while b'\n' in self.buf:
            line, self.buf = self.buf.split(b'\n', 1)
            m = json.loads(line)
            if m.get('type') == 'quit':
                self.quit()
                return False
            self.emit(m)
        return True

    def handle(self, m):
        self.sock.sendall((json.dumps(m) + '\n').encode())


class PreviewBackend:
    """--preview: fake login, password 'test'."""

    def __init__(self, emit, quit_):
        self.emit, self.quit = emit, quit_

    def handle(self, m):
        cmd = m.get('cmd')
        if cmd == 'authenticate':
            GLib.timeout_add(60, lambda: self.emit({'type': 'face', 'state': 'available'}) and False)
            GLib.timeout_add(50, lambda: self.emit({'type': 'prompt', 'text': 'Password:',
                                                    'secret': True}) and False)
        elif cmd == 'face':            # preview: pretend to look, then fail
            GLib.timeout_add(1500, lambda: self.emit({'type': 'face', 'state': 'fail'}) and False)
        elif cmd == 'respond':
            ok = m.get('text') == 'test'
            GLib.timeout_add(400, lambda: self.emit({'type': 'complete', 'ok': ok}) and False)
        elif cmd == 'start_session':
            self.quit()
        # 'ready' / 'power': nothing to do in the preview


# ---- windows -----------------------------------------------------------------------

class Greeter:
    def __init__(self, mode):
        self.mode = mode
        self.windows, self.view = [], None
        lock = mode == 'lock'
        if lock:
            users = [{'username': os.environ['ZORRO_USER'],
                      'display_name': os.environ.get('ZORRO_USER_NAME', os.environ['ZORRO_USER'])}]
        elif mode == 'preview':
            me = pwd.getpwuid(os.getuid())
            users = [{'username': me.pw_name, 'display_name': me.pw_gecos.split(',')[0] or me.pw_name}]
        else:
            users = login_users()
        info = {
            'hostname': socket.gethostname(), 'users': users,
            # always Openbox; zorro-dm reads /usr/share/xsessions itself to start it
            'sessions': [{'key': 'openbox', 'name': 'Openbox'}], 'default_session': 'openbox',
            'can_suspend': True,
            'can_restart': not lock, 'can_shutdown': not lock, 'lock_hint': lock,
        }
        self.shim = SHIM.replace('__INFO__', json.dumps(info))
        if mode == 'preview':
            self.backend = PreviewBackend(self.to_js, self.quit)
        else:
            self.backend = DaemonBackend(self.to_js, self.quit)

        display = Gdk.Display.get_default()
        n = display.get_n_monitors()
        primary = next((i for i in range(n) if display.get_monitor(i).is_primary()), 0)
        if mode == 'preview':
            self.add_window('index.html', None, primary=True)
        else:
            for i in range(n):
                self.add_window('index.html' if i == primary else 'secondary.html',
                                display.get_monitor(i), primary=i == primary, index=i)

    def add_window(self, page, monitor, primary, index=0):
        ucm = WebKit2.UserContentManager()
        ucm.add_script(WebKit2.UserScript.new(        # every screen gets the same look
            look_script(), WebKit2.UserContentInjectedFrames.TOP_FRAME,
            WebKit2.UserScriptInjectionTime.START, None, None))
        if primary:
            ucm.connect('script-message-received::zorro', self.from_js)
            ucm.register_script_message_handler('zorro')
            ucm.add_script(WebKit2.UserScript.new(
                self.shim, WebKit2.UserContentInjectedFrames.TOP_FRAME,
                WebKit2.UserScriptInjectionTime.START, None, None))
        view = WebKit2.WebView.new_with_user_content_manager(ucm)
        s = view.get_settings()
        s.set_enable_webgl(True)
        s.set_enable_developer_extras(self.mode == 'preview')
        black = Gdk.RGBA()
        black.parse('black')
        view.set_background_color(black)
        view.connect('context-menu', lambda *a: True)
        # WebKit's render process died: load the page again instead of a dead screen
        view.connect('web-process-terminated', lambda v, reason: GLib.timeout_add(
            500, lambda: v.load_uri('file://' + os.path.join(THEME, page)) and False))
        view.load_uri('file://' + os.path.join(THEME, page))

        win = Gtk.Window(title='zorro')
        win.add(view)
        win.connect('delete-event', lambda *a: self.mode != 'preview')
        if self.mode == 'preview':
            win.set_default_size(1280, 800)
            win.connect('destroy', lambda *a: Gtk.main_quit())
        else:
            g = monitor.get_geometry()
            win.set_decorated(False)
            win.set_keep_above(True)
            win.move(g.x, g.y)
            win.set_default_size(g.width, g.height)
            win.fullscreen_on_monitor(win.get_screen(), index)
        win.show_all()
        if primary:
            self.view = view
            view.grab_focus()
            view.connect('load-changed', self.on_load)
        self.windows.append(win)

    def on_load(self, _view, event):
        """Page loaded: give it a moment to draw, then tell zorro-dm (it holds sleep
        until then, so a suspend never catches a half-drawn lock screen)."""
        if event == WebKit2.LoadEvent.FINISHED:
            GLib.timeout_add(700, lambda: self.backend.handle({'cmd': 'ready'}) and False)

    def from_js(self, _ucm, result):
        v = result.get_js_value() if hasattr(result, 'get_js_value') else result
        try:
            self.backend.handle(json.loads(v.to_string()))
        except Exception as e:
            print('zorro-greeter:', e, file=sys.stderr)

    def to_js(self, m):
        if self.view:
            self.view.evaluate_javascript(f'window.__zorro({json.dumps(m)})', -1,
                                          None, None, None, None, None)

    def quit(self):
        Gtk.main_quit()


def main():
    if sys.argv[1:2] == ['--preview']:
        mode = 'preview'
        if sys.argv[2:3] == ['--look'] and len(sys.argv) > 3:   # try a look before saving it
            global LOOK_FILE
            LOOK_FILE = sys.argv[3]
    elif 'ZORRO_DM_FD' in os.environ:
        mode = 'lock' if os.environ.get('ZORRO_MODE') == 'lock' else 'greeter'
    else:
        sys.exit('zorro-greeter: run by zorro-dm (or use --preview); to lock: zorro-lock')
    if mode != 'preview':
        subprocess.run(['xsetroot', '-cursor_name', 'left_ptr'], check=False)
    Greeter(mode)
    Gtk.main()


if __name__ == '__main__':
    main()
