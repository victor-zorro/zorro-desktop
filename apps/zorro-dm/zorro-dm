#!/usr/bin/python3
"""zorro-dm: a minimal display manager for one seat.

Login:  Xorg :0 on vt7, zorro-greeter (as the unprivileged user _zorro-dm), PAM
        service 'zorro-dm', then the X session via /etc/X11/Xsession.
Lock:   the session runs `zorro-lock` (xss-lock) -> /run/zorro-dm/lock.sock.
        zorro-dm starts a second Xorg :1 on vt8 with the greeter in lock mode,
        switches to it and blocks VT switching (VT_LOCKSWITCH) until the session
        user's password is right (PAM 'zorro-lock'). The session itself is never
        on screen while locked, so a crashing lock screen can't expose it: the
        greeter (and X :1) are simply restarted.

Greeter <-> daemon: JSON lines over a socketpair (fd in $ZORRO_DM_FD).
  greeter -> dm: authenticate{user}, respond{text}, cancel, start_session{session},
                 power{action}
  dm -> greeter: prompt{text,secret}, message{text,error}, complete{ok}, quit
Lock socket: client sends 'lock', gets 'locked' (screen is safe) and 'unlocked'.
"""
import configparser
import fcntl
import glob
import json
import os
import pwd
import queue
import secrets
import select
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import traceback
import warnings

import PAM

# run_session_child() forks while helper threads exist. They only sit in accept()/recv()
# and hold no locks the child uses (it calls PAM and execs), so this is safe here.
warnings.filterwarnings('ignore', 'This process .* is multi-threaded', DeprecationWarning)

SESSION_DISPLAY, SESSION_VT = ':0', 7
LOCK_DISPLAY, LOCK_VT = ':1', 8
RUN = '/run/zorro-dm'
LOCK_SOCK = f'{RUN}/lock.sock'
GREETER_USER = '_zorro-dm'
GREETER = os.environ.get('ZORRO_GREETER', '/usr/local/bin/zorro-greeter')
XSESSION = '/etc/X11/Xsession'
# Like lightdm-session: read /etc/profile and ~/.profile (adds ~/.local/bin to PATH)
PROFILE_WRAP = ['/bin/sh', '-c',
                '[ -f /etc/profile ] && . /etc/profile; '
                '[ -f "$HOME/.profile" ] && . "$HOME/.profile"; exec "$@"',
                'zorro-session']
PATH = '/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games'
POWER = {'suspend', 'hibernate', 'reboot', 'poweroff'}
VT_ACTIVATE, VT_WAITACTIVE, VT_LOCKSWITCH, VT_UNLOCKSWITCH = 0x5606, 0x5607, 0x560B, 0x560C


def log(*a):
    print('zorro-dm:', *a, file=sys.stderr, flush=True)


# ---- VTs -------------------------------------------------------------------------

def vt_ioctl(req, arg=0):
    fd = os.open('/dev/tty0', os.O_RDWR | os.O_NOCTTY)
    try:
        fcntl.ioctl(fd, req, arg)
    finally:
        os.close(fd)


def vt_lock(on):
    try:
        vt_ioctl(VT_LOCKSWITCH if on else VT_UNLOCKSWITCH)
    except OSError as e:
        log('VT lock/unlock failed:', e)


def vt_switch(n):
    vt_ioctl(VT_ACTIVATE, n)
    vt_ioctl(VT_WAITACTIVE, n)


# ---- X server ----------------------------------------------------------------------

def start_x(display, vt):
    os.makedirs(RUN, mode=0o711, exist_ok=True)
    auth = f'{RUN}/xauth{display[1:]}'
    if os.path.exists(auth):
        os.unlink(auth)
    cookie = secrets.token_hex(16)
    subprocess.run(['xauth', '-q', '-f', auth, 'add', display, '.', cookie], check=True,
                   stderr=subprocess.DEVNULL)
    r, w = os.pipe()
    x = subprocess.Popen(
        ['/usr/bin/Xorg', display, '-seat', 'seat0', '-auth', auth, '-nolisten', 'tcp',
         f'vt{vt}', '-novtswitch', '-displayfd', str(w)],
        pass_fds=(w,), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True)
    os.close(w)
    ready, _, _ = select.select([r], [], [], 30)
    ok = ready and os.read(r, 16).strip()
    os.close(r)
    if not ok:
        x.kill()
        raise RuntimeError(f'X server {display} did not start (see /var/log/Xorg.{display[1:]}.log)')
    log('X server ready on', display)
    return x, cookie


def stop_x(x):
    if x.poll() is None:
        x.terminate()
        try:
            x.wait(10)
        except subprocess.TimeoutExpired:
            x.kill()
            x.wait()


def write_xauth(pw, display, cookie):
    """Add the cookie to ~/.Xauthority as the user itself (never as root: symlink attacks)."""
    path = os.path.join(pw.pw_dir, '.Xauthority')
    subprocess.run(['xauth', '-q', '-f', path, 'add', display, '.', cookie],
                   user=pw.pw_uid, group=pw.pw_gid, extra_groups=[], check=True,
                   cwd='/', env={'PATH': PATH, 'HOME': pw.pw_dir}, stderr=subprocess.DEVNULL)
    return path


# ---- sessions (/usr/share/xsessions) ---------------------------------------------

def xsessions():
    out = {}
    for f in sorted(glob.glob('/usr/share/xsessions/*.desktop')):
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        try:
            cp.read(f)
            e = cp['Desktop Entry']
        except Exception:
            continue
        if e.get('hidden', 'false').lower() == 'true' or e.get('exec', 'default') == 'default':
            continue
        key = os.path.basename(f)[:-len('.desktop')]
        out[key] = {'exec': e['exec'], 'desktop': e.get('desktopnames', key).split(';')[0] or key}
    return out


# ---- PAM -----------------------------------------------------------------------------

def pam_env(pam):
    env = pam.getenvlist() or {}
    if isinstance(env, dict):
        return dict(env)
    return dict(kv.split('=', 1) for kv in env if '=' in kv)


def run_session_child(pam, pw, argv, xdg, extra_env, pass_fds=(), log_to_journal=False):
    """Fork a root child that owns the PAM session (it becomes the logind session leader,
    not the daemon), runs argv as the user, and closes the session when argv exits."""
    pid = os.fork()
    if pid:
        return pid
    code = 1
    try:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        for k, v in xdg.items():
            pam.putenv(f'{k}={v}')
        pam.setcred(PAM.PAM_ESTABLISH_CRED)
        pam.open_session()
        try:
            pam.setcred(PAM.PAM_REINITIALIZE_CRED)
        except PAM.error:
            pass
        env = {'HOME': pw.pw_dir, 'USER': pw.pw_name, 'LOGNAME': pw.pw_name,
               'SHELL': pw.pw_shell, 'PATH': PATH, **xdg, **extra_env}
        env.update(pam_env(pam))
        out = None if log_to_journal else subprocess.DEVNULL
        proc = subprocess.Popen(
            argv, env=env, cwd=pw.pw_dir if os.path.isdir(pw.pw_dir) else '/',
            user=pw.pw_uid, group=pw.pw_gid,
            extra_groups=os.getgrouplist(pw.pw_name, pw.pw_gid),
            start_new_session=True, pass_fds=pass_fds,
            stdin=subprocess.DEVNULL, stdout=out, stderr=out)

        def stop(*_):
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        signal.signal(signal.SIGTERM, stop)
        proc.wait()
        stop()
        pam.close_session()
        pam.setcred(PAM.PAM_DELETE_CRED)
        code = 0
    except Exception:
        traceback.print_exc()
    finally:
        os._exit(code)


def wait_child(pid, timeout):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        done, _ = os.waitpid(pid, os.WNOHANG)
        if done:
            return True
        time.sleep(0.1)
    return False


def reap(pid):
    if not wait_child(pid, 5):
        os.kill(pid, signal.SIGTERM)
        if not wait_child(pid, 5):
            os.kill(pid, signal.SIGKILL)
            os.waitpid(pid, 0)


class Login:
    """One PAM conversation, run in a thread; result goes to the daemon's event queue."""

    def __init__(self, dm, rnd, service, username, tty):
        self.dm, self.rnd, self.ok, self.done, self.cancelled = dm, rnd, False, False, False
        self.answers = queue.Queue()
        self.pam = PAM.pam()
        self.pam.start(service)
        if username:
            self.pam.set_item(PAM.PAM_USER, username)
        self.pam.set_item(PAM.PAM_TTY, tty)
        self.pam.set_item(PAM.PAM_CONV, self.conv)
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    def conv(self, _pam, queries, _data):
        replies = []
        for text, kind in queries:
            if kind in (PAM.PAM_PROMPT_ECHO_ON, PAM.PAM_PROMPT_ECHO_OFF):
                self.dm.send(type='prompt', text=text, secret=kind == PAM.PAM_PROMPT_ECHO_OFF)
                answer = self.answers.get()
                if answer is None:
                    raise RuntimeError('cancelled')
                replies.append((answer, 0))
            else:
                self.dm.send(type='message', text=text, error=kind == PAM.PAM_ERROR_MSG)
                replies.append(('', 0))
        return replies

    def run(self):
        try:
            self.pam.authenticate()
            self.pam.acct_mgmt()
            self.ok = True
        except Exception as e:
            if not self.cancelled:
                log('authentication failed:', e)
        self.done = True
        self.dm.events.put(('auth_done', self.rnd, self))

    def cancel(self):
        if not self.done:
            self.cancelled = True
            self.answers.put(None)

    @property
    def user(self):
        return self.pam.get_item(PAM.PAM_USER)


# ---- the display manager ---------------------------------------------------------------

class DM:
    def __init__(self):
        # One queue for everything; events from an old greeter round carry its number
        # and are dropped, so nothing stale leaks into the next round.
        self.events = queue.Queue()
        self.round = 0
        self.sock = None
        self.lock = threading.Lock()

    # -- plumbing
    def send(self, **msg):
        try:
            with self.lock:
                self.sock.sendall((json.dumps(msg) + '\n').encode())
        except (OSError, AttributeError):
            pass

    def reader(self, sock, rnd):
        buf = b''
        while True:
            try:
                data = sock.recv(65536)
            except OSError:
                data = b''
            if not data:
                self.events.put(('eof', rnd, None))
                return
            buf += data
            while b'\n' in buf:
                line, buf = buf.split(b'\n', 1)
                try:
                    self.events.put(('msg', rnd, json.loads(line)))
                except ValueError:
                    log('bad message from greeter')

    def lock_listener(self):
        if os.path.exists(LOCK_SOCK):
            os.unlink(LOCK_SOCK)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(LOCK_SOCK)
        os.chmod(LOCK_SOCK, 0o666)          # anyone may ask; we check who in lock_request()
        srv.listen(8)
        while True:
            conn, _ = srv.accept()
            self.events.put(('lock_req', None, conn))

    @staticmethod
    def peer_uid(conn):
        creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i'))
        return struct.unpack('3i', creds)[1]

    @staticmethod
    def tell(conn, word):
        try:
            conn.sendall(word.encode() + b'\n')
        except OSError:
            pass

    # -- greeter rounds
    def greeter_round(self, display, vt, cookie, mode, session_pw=None, lock_clients=None):
        """Run one greeter until it is done.
        mode 'login': returns (Login, key, session) or None if the greeter went away.
        mode 'lock':  returns True when the session user typed the right password,
                      False if the greeter went away (caller restarts it)."""
        self.round += 1
        rnd = self.round
        gpw = pwd.getpwnam(GREETER_USER)
        gauth = write_xauth(gpw, display, cookie)
        self.sock, child = socket.socketpair()
        gpam = PAM.pam()
        gpam.start('zorro-dm-greeter')
        gpam.set_item(PAM.PAM_USER, GREETER_USER)
        gpam.set_item(PAM.PAM_TTY, display)
        gpam.set_item(PAM.PAM_CONV, lambda *a: [])
        gpam.authenticate()
        gpam.acct_mgmt()
        xdg = {'XDG_SEAT': 'seat0', 'XDG_VTNR': str(vt), 'XDG_SESSION_TYPE': 'x11',
               'XDG_SESSION_CLASS': 'greeter'}
        env = {'DISPLAY': display, 'XAUTHORITY': gauth, 'ZORRO_DM_FD': str(child.fileno()),
               'ZORRO_MODE': mode}
        if session_pw:
            env['ZORRO_USER'] = session_pw.pw_name
            env['ZORRO_USER_NAME'] = session_pw.pw_gecos.split(',')[0] or session_pw.pw_name
        gpid = run_session_child(gpam, gpw, [GREETER], xdg, env,
                                 pass_fds=(child.fileno(),), log_to_journal=True)
        child.close()
        threading.Thread(target=self.reader, args=(self.sock, rnd), daemon=True).start()

        login, result = None, None
        started = time.monotonic()
        told = mode != 'lock'
        while True:
            if not told and time.monotonic() - started > 8:
                told = True                 # never got 'ready': don't hold up sleep forever
                for c in lock_clients:
                    self.tell(c, 'locked')
            try:
                kind, r, m = self.events.get(timeout=1)
            except queue.Empty:
                continue
            if kind == 'lock_req':
                if mode == 'lock':          # already locked: just wait with the others
                    if told:
                        self.tell(m, 'locked')
                    lock_clients.append(m)
                else:                       # nobody logged in, nothing to lock
                    self.tell(m, 'unlocked')
                    m.close()
                continue
            if r != rnd:
                continue
            if kind == 'eof':
                result = None if mode == 'login' else False
                break
            if kind == 'auth_done':
                if m is login:
                    self.send(type='complete', ok=m.ok)
                continue
            cmd = m.get('cmd')
            if cmd == 'ready' and not told:
                told = True                 # lock screen is fully drawn: safe to sleep now
                for c in lock_clients:
                    self.tell(c, 'locked')
            elif cmd == 'authenticate':
                if login:
                    login.cancel()
                if mode == 'login':
                    login = Login(self, rnd, 'zorro-dm', m.get('user'), display)
                else:                       # lock: always the session user, whatever is asked
                    login = Login(self, rnd, 'zorro-lock', session_pw.pw_name, display)
            elif cmd == 'respond' and login and not login.done:
                login.answers.put(str(m.get('text', '')))
            elif cmd == 'cancel' and login:
                login.cancel()
                login = None
            elif cmd == 'start_session' and login and login.done and login.ok:
                if mode == 'lock':
                    if login.user == session_pw.pw_name:
                        result = True
                        break
                    continue
                sessions = xsessions()
                key = m.get('session') if m.get('session') in sessions else 'openbox'
                if key not in sessions:
                    key = next(iter(sessions), None)
                if key:
                    result = (login, key, sessions[key])
                    break
            elif cmd == 'power' and m.get('action') in POWER:
                if mode == 'lock' and m['action'] not in ('suspend', 'hibernate'):
                    continue
                log('power:', m['action'])
                subprocess.Popen(['systemctl', m['action']])

        if result:
            self.send(type='quit')
        elif login:
            login.cancel()
        reap(gpid)
        try:
            self.sock.shutdown(socket.SHUT_RDWR)   # wakes the reader thread
        except OSError:
            pass
        self.sock.close()
        self.sock = None
        if result is None or result is False:
            log('greeter exited')
        return result

    def lock_session(self, pw, first_client):
        log(f'locking session of {pw.pw_name}')
        clients = [first_client]
        x = None
        try:
            while True:
                if x is None or x.poll() is not None:
                    vt_lock(False)              # a new Xorg must be able to take its VT
                    try:
                        x, cookie = start_x(LOCK_DISPLAY, LOCK_VT)
                    except Exception as e:
                        log('lock screen X failed, retrying:', e)
                        time.sleep(2)
                        continue
                    vt_switch(LOCK_VT)
                    vt_lock(True)               # no Ctrl+Alt+F7 back to the session
                # clients hear 'locked' once the greeter says the screen is drawn
                if self.greeter_round(LOCK_DISPLAY, LOCK_VT, cookie, 'lock', pw, clients):
                    break
                log('lock screen crashed, restarting it (session stays hidden)')
                time.sleep(0.5)
            # Stop the lock X first: it must give up the GPU (DRM master) before the
            # session's X takes its VT back, or that X can't set a mode (black screen).
            stop_x(x)
            x = None
            vt_lock(False)
            vt_switch(SESSION_VT)
        finally:
            if x is not None:
                stop_x(x)
            for c in clients:
                self.tell(c, 'unlocked')
                c.close()
        log(f'unlocked session of {pw.pw_name}')

    def session_phase(self, login, key, ses, cookie):
        pw = pwd.getpwnam(login.user)
        log(f'starting session {key} for {pw.pw_name}')
        xauth = write_xauth(pw, SESSION_DISPLAY, cookie)
        xdg = {'XDG_SEAT': 'seat0', 'XDG_VTNR': str(SESSION_VT), 'XDG_SESSION_TYPE': 'x11',
               'XDG_SESSION_CLASS': 'user', 'XDG_SESSION_DESKTOP': key,
               'XDG_CURRENT_DESKTOP': ses['desktop'], 'DESKTOP_SESSION': key}
        pid = run_session_child(login.pam, pw, [*PROFILE_WRAP, XSESSION, ses['exec']], xdg,
                                {'DISPLAY': SESSION_DISPLAY, 'XAUTHORITY': xauth})
        while not os.waitpid(pid, os.WNOHANG)[0]:
            try:
                kind, _, m = self.events.get(timeout=1)
            except queue.Empty:
                continue
            if kind != 'lock_req':
                continue
            uid = self.peer_uid(m)
            if uid in (0, pw.pw_uid):
                self.lock_session(pw, m)
            else:
                m.close()
        log(f'session of {pw.pw_name} ended')

    def run(self):
        threading.Thread(target=self.lock_listener, daemon=True).start()
        while True:
            x, cookie = start_x(SESSION_DISPLAY, SESSION_VT)
            try:
                chosen = self.greeter_round(SESSION_DISPLAY, SESSION_VT, cookie, 'login')
                if chosen:
                    self.session_phase(*chosen, cookie)
            finally:
                stop_x(x)
            time.sleep(0.5)


def main():
    if os.getuid() != 0:
        sys.exit('zorro-dm must run as root')

    def bye(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    vt_lock(False)                      # left over from a crash while locked?
    try:
        DM().run()
    finally:
        vt_lock(False)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        try:
            os.killpg(0, signal.SIGTERM)
        except OSError:
            pass


if __name__ == '__main__':
    main()
