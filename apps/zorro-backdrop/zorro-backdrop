#!/usr/bin/python3
"""zorro-backdrop: moving desktop background in the style of the zorro lock screen:
black deep sea with slowly drifting "marine snow" at different depths.

  zorro-backdrop            run (Openbox autostart starts it)
  zorro-backdrop --fps N    frames per second (default: 24 on the charger, 12 on battery)

Light on the battery: only the few pixels around each particle are redrawn, and drawing
stops completely while windows cover the whole desktop (X VisibilityNotify) or while the
session is not on screen.
"""
import math
import os
import random
import sys
import time
from pathlib import Path

import cairo
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

N_PARTICLES = 220
FLAKE = (0.60, 0.60, 0.63)          # #9a9aa0, as in the lock screen


def on_battery():
    for ps in Path('/sys/class/power_supply').glob('*'):
        try:
            if (ps / 'type').read_text().strip() == 'Mains':
                return (ps / 'online').read_text().strip() != '1'
        except OSError:
            pass
    return False


class Backdrop(Gtk.Window):
    def __init__(self, fps):
        super().__init__(title='zorro-backdrop')
        self.fixed_fps = fps
        self.set_type_hint(Gdk.WindowTypeHint.DESKTOP)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)
        self.set_decorated(False)
        self.stick()
        self.set_app_paintable(True)
        # draw straight onto the window: GTK's double buffer would copy a whole-screen
        # buffer for every frame, even though only a few pixels change
        self.set_double_buffered(False)
        self.add_events(Gdk.EventMask.VISIBILITY_NOTIFY_MASK)
        self.connect('draw', self.on_draw)
        self.connect('visibility-notify-event', self.on_visibility)
        self.connect('configure-event', lambda *a: self.layout())
        self.connect('realize', self.on_realize)
        scr = self.get_screen()
        scr.connect('size-changed', lambda s: self.fit())
        self.visible_now = True
        self.W = self.H = 1
        self.fit()
        self.t0 = time.monotonic()
        self.last = self.t0
        self.parts = [self.new_particle(random.random()) for _ in range(N_PARTICLES)]
        self.timer = None
        self.dirty = None
        self.sway_at = 0
        self.show_all()
        self.schedule()
        GLib.timeout_add_seconds(30, self.check_power)

    def on_realize(self, _w):
        gw = self.get_window()
        gw.lower()                      # under conky's panel, which is also a desktop window

    def fit(self):
        disp = Gdk.Display.get_default()
        rect = Gdk.Rectangle()
        for i in range(disp.get_n_monitors()):          # bounding box of all monitors
            rect = rect.union(disp.get_monitor(i).get_geometry()) if i else \
                disp.get_monitor(i).get_geometry()
        self.move(rect.x, rect.y)
        self.resize(rect.width, rect.height)
        self.layout()

    def layout(self):
        a = self.get_allocation()
        self.W, self.H = max(1, a.width), max(1, a.height)

    @staticmethod
    def new_particle(y=None):
        z = random.random() ** 1.6          # most flakes far away (small, dim, slow)
        return {'x': random.random(), 'y': random.random() if y is None else y, 'z': z,
                's': random.random() * 6.28, 'px': None, 'sx': 0,
                'vy': 0.004 + 0.014 * z,
                'r': 1 if z < 0.35 else 2 if z < 0.7 else 3 if z < 0.9 else 4,
                'a': 0.22 + 0.55 * z}

    # -- timing
    def fps(self):
        if self.fixed_fps:
            return self.fixed_fps
        return 12 if on_battery() else 24

    def schedule(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        if self.visible_now:
            self.last = time.monotonic()
            self.timer = GLib.timeout_add(int(1000 / self.fps()), self.tick)

    def check_power(self):
        self.schedule()                 # pick up charger / battery changes
        return True

    def on_visibility(self, _w, ev):
        vis = ev.state != Gdk.VisibilityState.FULLY_OBSCURED
        if vis != self.visible_now:
            self.visible_now = vis
            self.schedule()
            if vis:
                self.queue_draw()
        return False

    # -- motion
    def tick(self):
        now = time.monotonic()
        dt = min(0.25, now - self.last)
        self.last = now
        t = now - self.t0
        W, H = self.W, self.H
        # the sideways sway moves a few pixels per second: 4 updates a second are plenty
        if now - self.sway_at > 0.25:
            self.sway_at = now
            sin = math.sin
            for p in self.parts:
                p['sx'] = int(((p['x'] + sin(t * 0.1 + p['s']) * 0.01
                                + sin(t * 0.031 + p['s'] * 2) * 0.006) % 1.0) * W)
        dirty = cairo.Region()
        union, Rect = dirty.union, cairo.RectangleInt
        for p in self.parts:
            p['y'] += dt * p['vy']            # sink slowly, nearer flakes faster
            if p['y'] > 1.02:
                p.update(self.new_particle(-0.02))
                p['sx'] = int(p['x'] * W)
            x, y, r = p['sx'], int(p['y'] * H), p['r']
            old = p['px']
            if old and old[0] == x and old[1] == y:
                continue                # moved less than a pixel: nothing to redraw
            p['px'] = (x, y, r)
            h = 3 if r >= 3 else 0      # near flakes get a soft halo
            if old:
                union(Rect(old[0] - h, old[1] - h, r + 2 * h, r + 2 * h))
            union(Rect(x - h, y - h, r + 2 * h, r + 2 * h))
        gw = self.get_window()
        if gw and not dirty.is_empty():
            self.dirty = dirty
            gw.invalidate_region(dirty, False)     # one call for all changed spots
        return True

    def on_draw(self, _w, cr):
        cr.set_source_rgb(0, 0, 0)
        cr.paint()
        dirty, self.dirty = self.dirty, None     # None: a full redraw (expose)
        out = cairo.REGION_OVERLAP_OUT
        for p in self.parts:
            px = p['px']
            if not px:
                continue
            h = 3 if px[2] >= 3 else 0
            if (dirty is not None and dirty.contains_rectangle(
                    cairo.RectangleInt(px[0] - h, px[1] - h, px[2] + 2 * h, px[2] + 2 * h)) == out):
                continue
            if h:
                cr.set_source_rgba(*FLAKE, p['a'] * 0.12)
                cr.rectangle(px[0] - h, px[1] - h, px[2] + 2 * h, px[2] + 2 * h)
                cr.fill()
                cr.set_source_rgba(*FLAKE, p['a'] * 0.2)
                cr.rectangle(px[0] - 1, px[1] - 1, px[2] + 2, px[2] + 2)
                cr.fill()
            cr.set_source_rgba(*FLAKE, p['a'])
            cr.rectangle(*px, px[2])
            cr.fill()
        return True


def main():
    fps = None
    if '--fps' in sys.argv:
        fps = max(1, min(60, int(sys.argv[sys.argv.index('--fps') + 1])))
    Backdrop(fps)
    Gtk.main()


if __name__ == '__main__':
    main()
