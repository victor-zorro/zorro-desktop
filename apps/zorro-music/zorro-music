#!/usr/bin/python3
"""zorro-music: SoundCloud (and any link yt-dlp knows) through one small mpv in the background.

Logged in: your SoundCloud login is borrowed from the Firefox profile where you are signed in
(yt-dlp --cookies-from-browser), so your likes and playlists play, in Go+ quality when your
subscription has it. Not logged in: public free tracks. mpv with mpv-mpris shows up as a
media player (MPRIS): media keys, the Dialer's Music part and the Audio tab see it.

  zorro-music play URL | likes | search TEXT | fav NAME
  zorro-music play | pause | toggle | next | prev | stop
  zorro-music status            JSON: title, artist, playing, position, duration, ...
Settings: ~/.config/zorro-music/config.json
  {"user": "your-soundcloud-name", "favourites": [{"name": "...", "url": "..."}], "volume": 80}
"""
import json
import os
import shutil
import socket
import sqlite3
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
SOCK = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / 'zorro-music.sock'
CONF = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config')) / 'zorro-music' / 'config.json'
YTDLP = shutil.which('yt-dlp', path=f'{HOME}/.local/bin:{os.environ.get("PATH", "")}')


def load_conf():
    try:
        c = json.loads(CONF.read_text())
    except (OSError, ValueError):
        c = {}
    return {'user': c.get('user', ''), 'favourites': c.get('favourites', []),
            'volume': c.get('volume', 80), 'profile': c.get('profile', '')}


def firefox_profile():
    """the Firefox profile where SoundCloud is signed in (only checks that the cookie exists)"""
    dirs = list((HOME / '.mozilla/firefox').glob('*')) + list((HOME / '.local/share').glob('firefox-*'))
    for d in dirs:
        db = d / 'cookies.sqlite'
        if not db.is_file():
            continue
        with tempfile.TemporaryDirectory() as tmp:     # Firefox locks its copy: read a copy
            cp = Path(tmp) / 'c.sqlite'
            shutil.copy(db, cp)
            try:
                n = sqlite3.connect(cp).execute(
                    "select count(*) from moz_cookies where host like '%soundcloud.com' "
                    "and name='oauth_token'").fetchone()[0]
            except sqlite3.Error:
                n = 0
        if n:
            return str(d)
    return ''


def ipc(*command, timeout=2):
    """one command to mpv over its socket; the reply's data, or None"""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(str(SOCK))
            s.sendall((json.dumps({'command': list(command)}) + '\n').encode())
            buf = b''
            while b'\n' not in buf or b'"error"' not in buf:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
            for line in buf.splitlines():
                msg = json.loads(line)
                if 'error' in msg:
                    return msg.get('data') if msg['error'] == 'success' else None
    except (OSError, ValueError):
        return None
    return None


def running():
    return ipc('get_property', 'idle-active') is not None


def start():
    if running():
        return True
    if not shutil.which('mpv'):
        sys.exit('zorro-music: needs mpv (sudo apt install mpv mpv-mpris)')
    c = load_conf()
    prof = c['profile'] or firefox_profile()
    raw = [f'cookies-from-browser=firefox:{prof}'] if prof else []
    args = ['mpv', '--no-video', '--idle=yes', '--force-window=no', '--no-terminal',
            f'--input-ipc-server={SOCK}', '--ytdl-format=bestaudio/best',
            f'--volume={int(c["volume"])}', '--title=zorro-music',
            '--term-playing-msg=', '--audio-display=no']
    if YTDLP:
        args.append(f'--script-opts=ytdl_hook-ytdl_path={YTDLP}')
    if raw:
        args.append('--ytdl-raw-options=' + ','.join(raw))
    SOCK.unlink(missing_ok=True)
    subprocess.Popen(args, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):
        time.sleep(0.1)
        if running():
            return True
    return False


def target(what, rest):
    c = load_conf()
    if what == 'likes':
        if not c['user']:
            sys.exit('zorro-music: set your SoundCloud name first ("user" in ' + str(CONF) + ')')
        return f'https://soundcloud.com/{c["user"]}/likes'
    if what == 'search':
        return 'ytdl://scsearch25:' + ' '.join(rest)     # mpv hands only ytdl:// and links to yt-dlp
    if what == 'fav':
        name = ' '.join(rest).lower()
        f = next((f for f in c['favourites'] if f.get('name', '').lower() == name), None)
        if not f:
            sys.exit(f'zorro-music: no favourite called {name!r}')
        return f['url']
    return what                        # a link


def status():
    if not running():
        return {'running': False}
    meta = ipc('get_property', 'metadata') or {}
    title = ipc('get_property', 'media-title') or ''
    return {'running': True, 'idle': bool(ipc('get_property', 'idle-active')),
            'playing': ipc('get_property', 'pause') is False,
            'title': meta.get('title') or title, 'artist': meta.get('artist') or meta.get('uploader') or '',
            'position': ipc('get_property', 'time-pos') or 0, 'duration': ipc('get_property', 'duration') or 0,
            'index': ipc('get_property', 'playlist-pos'), 'count': ipc('get_property', 'playlist-count'),
            'volume': ipc('get_property', 'volume')}


def main():
    a = sys.argv[1:]
    if not a or a[0] in ('-h', '--help'):
        print(__doc__.strip())
        return
    cmd = a[0]
    if cmd == 'play' and len(a) >= 2:
        if not start():
            sys.exit('zorro-music: mpv did not start')
        ipc('loadfile', target(a[1], a[2:]), 'replace')
        ipc('set_property', 'pause', False)
    elif cmd == 'toggle':
        if running():
            ipc('cycle', 'pause')
    elif cmd in ('play', 'pause') and len(a) == 1:      # without a target: resume / pause
        ipc('set_property', 'pause', cmd == 'pause')
    elif cmd == 'next':
        ipc('playlist-next')
    elif cmd == 'prev':
        ipc('playlist-prev')
    elif cmd == 'stop':
        ipc('stop')                        # stops; mpv stays ready (idle) for the next play
    elif cmd == 'status':
        print(json.dumps(status()))
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == '__main__':
    main()
