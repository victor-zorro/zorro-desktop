                update_conf('lights', kbd=level)
            box.add(radios(list(KBD_LEVELS.items()), cur, kbd))
            box.add(note('Fn + Space changes it too. The level is kept after standby and restart.'))
            box.footer(self.light_msg)
            return box

    app = Gtk.Application(application_id='org.zorro.settings')
    app.connect('activate', lambda a: (a.get_active_window() or Win(a)).present())
    app.run([])


# ---- main --------------------------------------------------------------------------------

def main():
    a = sys.argv[1:]
    if a[:1] == ['key'] and len(a) == 2 and a[1] in KEYS:
        KEYS[a[1]]()
    elif a[:1] == ['keyd']:
        cmd_keyd()
    elif a[:1] == ['morse'] and len(a) >= 2:                # blink once, e.g. zmorse
        set_led(DOT_LED, 'off')
        time.sleep(1)
        play_morse(' '.join(a[1:]), MORSE_UNIT)
        if 'dot' in load_conf().get('lights', {}):
            apply_lights()
        else:
            set_led(DOT_LED, 'on')
    elif a[:1] == ['osd'] and len(a) >= 3:
        osd(a[1], None if a[2] == '-' else int(a[2]), ' '.join(a[3:]))
    elif not a:
        cmd_app()
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == '__main__':
    main()
