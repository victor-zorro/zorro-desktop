        def mic_test(self):
            def fn():
                import tempfile
                wav = tempfile.mktemp(suffix='.wav', prefix='zorro-mic-')
                GLib.idle_add(self.hw_msg.set_text, '● Recording 3 seconds: say something…')
                p = subprocess.Popen(['pw-record', wav], stderr=subprocess.DEVNULL)
                time.sleep(3)
                p.terminate()
                p.wait()
                GLib.idle_add(self.hw_msg.set_text, '▶ Playing it back…')
                run('pw-play', wav, timeout=8)
                try:
                    os.unlink(wav)
                except OSError:
                    pass
                return 'Microphone test done: did you hear yourself?'
            self.hw_do('…', fn)

