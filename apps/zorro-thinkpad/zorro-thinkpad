        def fx_checker(self, w, cr):
            a = w.get_allocation()
            cr.rectangle(0, 0, a.width, a.height)
            cr.clip()
            cr.set_source_rgb(0.80, 0.80, 0.83)
            cr.paint()
            cr.set_source_rgb(0.62, 0.62, 0.66)
            for y in range(0, a.height, 16):
                for x in range(0, a.width, 16):
                    if (x // 16 + y // 16) % 2:
                        cr.rectangle(x, y, 16, 16)
            cr.fill()
            return False

