'''


def style_osd(screen):
    """indicator look; the level bar's opacity follows the zorro-fx setting (live)"""
    from gi.repository import GLib, Gtk
    css = Gtk.CssProvider()
    css.load_from_data(OSD_CSS)
    Gtk.StyleContext.add_provider_for_screen(screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    if not zorro_fx:
        return
    bar = Gtk.CssProvider()
    Gtk.StyleContext.add_provider_for_screen(screen, bar, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    last = [None]

    def update():
        data = zorro_fx.bar_css()
        if data != last[0]:
            last[0] = data
            bar.load_from_data(data)
        return True
    update()
    GLib.timeout_add(500, update)


def find_event_device(name):
    for ev in sorted(Path('/sys/class/input').glob('event*')):
        try:
            if (ev / 'device' / 'name').read_text().strip() == name:
                return Path('/dev/input') / ev.name
        except OSError:
            pass
    return None


def cmd_keyd():
    import threading
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, GLib, Gtk

    # one keyd per session: a live socket means another one runs
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.connect(str(SOCK))
        sys.exit('zorro-thinkpad keyd: already running')
    except (ConnectionRefusedError, FileNotFoundError):
        pass
    try:
        SOCK.unlink()
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    srv.bind(str(SOCK))
    os.chmod(SOCK, 0o600)

    style_osd(Gdk.Screen.get_default())

    class Indicator(Gtk.Window):
        """the box at the bottom centre; the window around it is the 'spill' margin where
        particles drift out. Clicks go through it. Without a compositor the window shows a
        still image of the screen behind it (taken just before it appears)."""
        def __init__(self):
            super().__init__(type=Gtk.WindowType.POPUP)
            screen = self.get_screen()
            self.composited = bool(screen.is_composited() and screen.get_rgba_visual())
            if self.composited:
                self.set_visual(screen.get_rgba_visual())
                self.set_app_paintable(True)
                self.connect('draw', self.clear_bg)
            self.set_accept_focus(False)
            outer = Gtk.Box()
            box = Gtk.Box(spacing=14, hexpand=True, vexpand=True)
            box.get_style_context().add_class('zosd')
            outer.add(box)
            self.snow = Snow(outer, radius=14, inner=box)
            self.icon = Gtk.Image()
            self.icon.set_pixel_size(28)
            box.add(self.icon)
            self.bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER, hexpand=True)
            self.bar.set_size_request(200, -1)
            box.add(self.bar)
            self.label = Gtk.Label(xalign=0)
            box.add(self.label)
            self.add(outer)
            outer.show_all()
            self.hide_id = None
            self.geom = None
            self.connect('realize', self.click_through)

        @staticmethod
        def click_through(w):
            import cairo
            w.get_window().input_shape_combine_region(cairo.Region(), 0, 0)

        def clear_bg(self, _w, cr):
            cr.set_operator(0)          # CLEAR: transparent around the box
            cr.paint()
            cr.set_operator(2)          # OVER
            return False

        def show_level(self, icon, value, text):
            self.icon.set_from_icon_name(icon or 'dialog-information-symbolic', Gtk.IconSize.DIALOG)
            self.icon.set_pixel_size(28)
            if value is None:
                self.bar.hide()
                self.label.set_text(text)
            else:
                self.bar.show()
                self.bar.set_fraction(max(0, min(100, value)) / 100)
                self.label.set_text(text or f'{value}%')
                self.label.set_width_chars(5 if not text else -1)
            s = zorro_fx.settings() if zorro_fx else {}
            self.snow.update_spill() if zorro_fx else None
            spill = int(s.get('spill', 0))
            self.resize(1, 1)
            _, nat = self.get_preferred_size()
            disp = Gdk.Display.get_default()
            mon = disp.get_primary_monitor() or disp.get_monitor(0)
            g = mon.get_geometry()
            x = g.x + (g.width - nat.width) // 2
            y = g.y + g.height - (nat.height - 2 * spill) - 90 - spill
            geom = (x, y, nat.width, nat.height)
            if not self.composited and geom != self.geom:
                if self.get_visible():
                    self.hide()             # take the picture without ourselves in it
                    while Gtk.events_pending():
                        Gtk.main_iteration_do(False)
                self.snow.backdrop, self.snow.backdrop_at = self.grab_behind(*geom)
            self.geom = geom
            self.move(x, y)
            self.show()
            if self.hide_id:
                GLib.source_remove(self.hide_id)
            self.hide_id = GLib.timeout_add(int(s.get('osd_seconds', 1.5) * 1000), self.done)

        @staticmethod
        def grab_behind(x, y, w, h):
            """the screen under (x, y, w, h), clipped to the screen; (pixbuf, offset)"""
            root = Gdk.get_default_root_window()
            rw, rh = root.get_width(), root.get_height()
            x0, y0 = max(0, x), max(0, y)
            x1, y1 = min(rw, x + w), min(rh, y + h)
            if x1 <= x0 or y1 <= y0:
                return None, (0, 0)
            return Gdk.pixbuf_get_from_window(root, x0, y0, x1 - x0, y1 - y0), (x0 - x, y0 - y)

        def done(self):
            self.hide()
            self.hide_id = None
            self.geom = None                # next time: a fresh picture of the screen
            return False

    ind = Indicator()

    def on_msg(fd, _cond):
        try:
            data = srv.recv(4096)
            m = json.loads(data)
            ind.show_level(m.get('icon'), m.get('value'), m.get('text', ''))
        except (OSError, ValueError):
            pass
        return True
    GLib.io_add_watch(srv.fileno(), GLib.IO_IN, on_msg)

    # keys that X cannot deliver: read the ThinkPad Extra Buttons device directly
    def evdev_reader():
        fmt = 'llHHi'
        size = struct.calcsize(fmt)
        warned = False
        while True:
            dev = find_event_device(EXTRA_BUTTONS)
            try:
                with open(dev, 'rb', buffering=0) as fh:
                    warned = False
                    while True:
                        data = fh.read(size)
                        if len(data) < size:
                            break
                        _, _, typ, code, val = struct.unpack(fmt, data)
                        if typ == 1 and val == 1 and code in EVDEV_KEYS:
                            name = EVDEV_KEYS[code]
                            threading.Thread(target=KEYS[name], daemon=True).start()
            except (OSError, TypeError) as e:
                if not warned:
                    print(f'zorro-thinkpad keyd: cannot read {dev}: {e} '
                          '(run apps/zorro-thinkpad/install.sh)', file=sys.stderr)
                    warned = True
                time.sleep(30)
    threading.Thread(target=evdev_reader, daemon=True).start()
    threading.Thread(target=dot_loop, daemon=True).start()

    # Fn+Space: the firmware changes the keyboard light and pokes brightness_hw_changed
    hw = KBD_LED / 'brightness_hw_changed'
    if hw.exists():
        fh = open(hw)
        fh.read()

        def on_kbd(_fd, _cond):
            fh.seek(0)
            try:
                lvl = int(fh.read().strip() or 0)
            except ValueError:
                return True
            mx = int((KBD_LED / 'max_brightness').read_text())
            words = {0: 'Keyboard light off', 1: 'Keyboard light low', 2: 'Keyboard light high'}
            update_conf('lights', kbd=lvl)          # remembered for login and resume
            ind.show_level('keyboard-brightness-symbolic', round(lvl * 100 / mx) if lvl else None,
                           words.get(lvl, f'Keyboard light {lvl}'))
            return True
        GLib.io_add_watch(fh.fileno(), GLib.IO_PRI | GLib.IO_ERR, on_kbd)

    # saved light settings: now, and again after every resume (firmware resets the LEDs)
    from gi.repository import Gio
    apply_lights()

    def on_sleep(_conn, _sender, _path, _iface, _signal, params):
        if not params.unpack()[0]:                      # False = just woke up
            GLib.timeout_add(1500, lambda: apply_lights() and False)
    try:
        Gio.bus_get_sync(Gio.BusType.SYSTEM, None).signal_subscribe(
            'org.freedesktop.login1', 'org.freedesktop.login1.Manager', 'PrepareForSleep',
            '/org/freedesktop/login1', None, Gio.DBusSignalFlags.NONE, on_sleep)
    except GLib.Error as e:
        print(f'zorro-thinkpad keyd: no resume signal: {e.message}', file=sys.stderr)

    Gtk.main()


# ---- power: TLP settings (written by the root helper) + battery state ---------------------

HELPER = '/usr/local/libexec/zorro-thinkpad-helper'
BAT = Path('/sys/class/power_supply/BAT0')
PROFILES = {'low-power': 'Battery saver', 'balanced': 'Balanced', 'performance': 'Performance'}
CHARGE_PRESETS = {'long': ('Long battery life: charge to 80% (starts below 75%)', 75, 80),
                  'full': ('Full: charge to 100% (starts below 95%)', 95, 100)}


def tlp_settings():
    """the TLP values in effect: /etc/tlp.conf, then /etc/tlp.d/*.conf in order"""
    vals = {}
    files = [Path('/etc/tlp.conf')] + sorted(Path('/etc/tlp.d').glob('*.conf'))
    for fn in files:
        try:
            for line in fn.read_text().splitlines():
                m = re.match(r'\s*([A-Z0-9_]+)\s*=\s*"?([^"#]*?)"?\s*$', line)
                if m:
                    vals[m.group(1)] = m.group(2)
        except OSError:
            pass
    return vals


def sysread(p, default=''):
    try:
        return Path(p).read_text().strip()
    except OSError:
        return default


def battery_text():
    if not BAT.exists():
        return 'No battery found'
    cap, status = sysread(BAT / 'capacity', '?'), sysread(BAT / 'status', '?')
    now = sysread(BAT / 'energy_full') or sysread(BAT / 'charge_full')
    new = sysread(BAT / 'energy_full_design') or sysread(BAT / 'charge_full_design')
    health = f'{int(now) * 100 // int(new)}%' if now and new else '?'
    cycles = sysread(BAT / 'cycle_count', '?')
    lo = sysread(BAT / 'charge_control_start_threshold', '?')
    hi = sysread(BAT / 'charge_control_end_threshold', '?')
    return (f'{cap}%  ·  {status.lower()}  ·  health {health} of new  ·  {cycles} charge cycles\n'
            f'Charges when below {lo}%, stops at {hi}%')


# ---- hardware check -----------------------------------------------------------------------

FP_VENDORS = {'06cb': 'Synaptics', '27c6': 'Goodix', '138a': 'Validity', '147e': 'UPEK',
              '10a5': 'FPC', '1c7a': 'EgisTec', '2808': 'FocalTech', '04f3:0c': 'Elan'}
SOUNDS = Path('/usr/share/sounds/freedesktop/stereo')


def driver_of(sysdev):
    try:
        return Path(os.path.realpath(Path(sysdev) / 'driver')).name
    except OSError:
        return '?'


def cameras():
    """[(dev, name, driver, is_ir)]: capture nodes only"""
    out = []
    for d in sorted(Path('/sys/class/video4linux').glob('video*')):
        dev = f'/dev/{d.name}'
        fmts = run('v4l2-ctl', '-d', dev, '--list-formats')
        if "'" not in fmts:
            continue                     # metadata node
        ir = 'GREY' in fmts and 'YUYV' not in fmts and 'MJPG' not in fmts
        out.append((dev, sysread(d / 'name').split(':')[0], driver_of(d / 'device'), ir))
    return out


def audio_state(which):
    """(volume %, muted, name) of the default sink / source"""
    out = run('wpctl', 'get-volume', f'@DEFAULT_AUDIO_{which}@')
    m = re.search(r'([\d.]+)', out)
    name = ''
    insp = run('wpctl', 'inspect', f'@DEFAULT_AUDIO_{which}@')
    n = re.search(r'node\.description = "([^"]+)"', insp) or re.search(r'node\.nick = "([^"]+)"', insp)
    if n:
        name = n.group(1)
    return (round(float(m.group(1)) * 100) if m else None), '[MUTED]' in out, name


def bt_state():
    show = run('bluetoothctl', 'show')
    if 'Controller' not in show:
        return None
    powered = 'Powered: yes' in show
    devs = []
    for line in run('bluetoothctl', 'devices', 'Paired').splitlines():
        p = line.split(' ', 2)
        if len(p) == 3 and p[0] == 'Device':
            info = run('bluetoothctl', 'info', p[1])
            devs.append((p[1], p[2], 'Connected: yes' in info))
    return {'powered': powered, 'paired': devs}


def input_names():
    return re.findall(r'N: Name="([^"]+)"', sysread('/proc/bus/input/devices'))


def hardware_rows(ui):
    """the device list; ui supplies the actions. Runs in a thread (some checks are slow)."""
    rows = []
    lsusb = run('lsusb')
    lspci = run('lspci')

    cams = cameras()
    rgb = [c for c in cams if not c[3]]
    ir = [c for c in cams if c[3]]
    if rgb:
        dev, name, drv, _ = rgb[0]
        detail = f'{name} · {dev} · driver {drv}'
        if ir:
            detail += f'\nInfrared camera found too ({ir[0][0]}): usable for face unlock later'
        rows.append(('camera-web-symbolic', 'Webcam', 'ok', detail,
                     [('Preview', lambda d=dev: ui.webcam(d))]))
    else:
        rows.append(('camera-web-symbolic', 'Webcam', 'warn',
                     'No camera found. Check the BIOS (Security → I/O Port Access → Camera).', []))

    vol, muted, name = audio_state('SOURCE')
    if vol is None:
        rows.append(('audio-input-microphone-symbolic', 'Microphone', 'warn', 'No microphone found', []))
    else:
        rows.append(('microphone-disabled-symbolic' if muted else 'audio-input-microphone-symbolic',
                     'Microphone', 'warn' if muted else 'ok',
                     f'{name} · {"MUTED" if muted else f"on, level {vol}%"}',
                     [('Unmute' if muted else 'Mute', ui.mic_toggle),
                      ('Test: record 3 s', ui.mic_test)]))

    vol, muted, name = audio_state('SINK')
    if vol is None:
        rows.append(('audio-speakers-symbolic', 'Speakers', 'warn', 'No sound output found', []))
    else:
        rows.append(('audio-speakers-symbolic', 'Speakers', 'warn' if muted else 'ok',
                     f'{name} · {"MUTED" if muted else f"volume {vol}%"}',
                     [('Test: left / right', ui.speaker_test)]))

    bt = bt_state()
    usb_bt = next((l.split(' ', 6)[-1] for l in lsusb.splitlines() if 'Bluetooth' in l), 'adapter')
    if bt is None:
        rows.append(('bluetooth-symbolic', 'Bluetooth', 'warn',
                     'No Bluetooth controller (switched off with F8 / airplane mode?)', []))
    else:
        detail = f'{usb_bt} · {"on" if bt["powered"] else "off"}'
        if bt['powered']:
            detail += ' · ' + (f'{len(bt["paired"])} paired' if bt['paired'] else 'nothing paired yet')
        acts = [('Turn off' if bt['powered'] else 'Turn on', lambda p=bt['powered']: ui.bt_power(not p))]
        if bt['powered']:
            acts.append(('Scan & pair…', ui.bt_scan))
        rows.append(('bluetooth-active-symbolic' if bt['powered'] else 'bluetooth-disabled-symbolic',
                     'Bluetooth', 'ok' if bt['powered'] else 'off', detail, acts))
        for mac, dname, conn in bt['paired']:
            rows.append((None, f'    {dname}', 'ok' if conn else 'off',
                         f'    {mac} · {"connected" if conn else "not connected"}',
                         [('Disconnect' if conn else 'Connect',
                           lambda m=mac, c=conn: ui.bt_cmd('disconnect' if c else 'connect', m)),
                          ('Forget', lambda m=mac: ui.bt_cmd('remove', m))]))
        for mac, dname in ui.bt_found:
            rows.append((None, f'    {dname}', 'off', f'    {mac} · found nearby',
                         [('Pair & connect', lambda m=mac: ui.bt_pair(m))]))

    wifi = next((l for l in run('nmcli', '-t', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'dev').splitlines()
                 if ':wifi:' in l), None)
    wcard = next((l.split(': ', 1)[-1] for l in lspci.splitlines() if 'Network controller' in l), '')
    if wifi:
        dev, _, state, conn = wifi.split(':', 3)
        sig = next((l.split(':')[1] for l in run('nmcli', '-t', '-f', 'ACTIVE,SIGNAL', 'dev',
                                                     'wifi').splitlines() if l.startswith('yes:')), '')
        ok = state == 'connected'
        rows.append(('network-wireless-symbolic', 'Wi-Fi', 'ok' if ok else 'off',
                     f'{wcard} · driver {driver_of(f"/sys/class/net/{dev}/device")}\n'
                     + (f'connected to {conn}, signal {sig}%' if ok else state),
                     [('Connections…', lambda: spawn(['nm-connection-editor']))]))
    else:
        rows.append(('network-wireless-offline-symbolic', 'Wi-Fi', 'warn', 'No Wi-Fi adapter', []))

    modem = next((l.split(': ', 1)[-1] for l in lspci.splitlines()
                  if 'modem' in l.lower() or 'Cellular' in l), None)
    if modem:
        mm = shutil.which('mmcli')
        rows.append(('network-cellular-symbolic', 'Mobile data (LTE)', 'ok' if mm else 'warn',
                     f'{modem}\n' + ('ModemManager installed' if mm else
                                     'Needs ModemManager: comes with the LTE tab (next step)'), []))

    if shutil.which('lpstat'):
        printers = [l.split()[1] for l in run('lpstat', '-p').splitlines() if l.startswith('printer ')]
        rows.append(('printer-symbolic', 'Printer', 'ok' if printers else 'off',
                     ('Printers: ' + ', '.join(printers)) if printers else 'No printer added yet',
                     [('Add printer…', lambda: spawn(['xdg-open', 'http://localhost:631/admin']))]))
    else:
        rows.append(('printer-symbolic', 'Printer', 'warn',
                     'Printing is not installed: sudo apt install cups (then Add printer here)', []))

    names = input_names()
    touch = next((n for n in names if 'Touch System' in n or 'Touchscreen' in n), None)
    rows.append(('input-touchpad-symbolic', 'Touchscreen', 'ok' if touch else 'off',
                 touch or 'none', []))
    pads = [n for n in names if 'TouchPad' in n or 'TrackPoint' in n]
    rows.append(('input-mouse-symbolic', 'Touchpad and TrackPoint', 'ok' if pads else 'warn',
                 ' · '.join(pads) or 'not found', []))

    fp = None
    for l in lsusb.splitlines():
        m = re.search(r'ID ([0-9a-f]{4}):([0-9a-f]{4})', l)
        if m and (m.group(1) in FP_VENDORS or f'{m.group(1)}:{m.group(2)[:2]}' in FP_VENDORS):
            fp = l.split(m.group(0), 1)[1].strip() or FP_VENDORS.get(m.group(1))
    if fp:
        have = shutil.which('fprintd-enroll')
        rows.append(('auth-fingerprint-symbolic', 'Fingerprint', 'ok' if have else 'warn',
                     f'{fp}\n' + ('fprintd installed' if have else
                                  'Reader found; needs fprintd (next step: enroll + use for login)'),
                     []))
    else:
        rows.append(('auth-fingerprint-symbolic', 'Fingerprint', 'warn',
                     'No fingerprint reader found. If this ThinkPad has one (in the power button), '
                     'switch it on in the BIOS: Security → I/O Port Access → Fingerprint Reader.',
                     []))
    return rows


