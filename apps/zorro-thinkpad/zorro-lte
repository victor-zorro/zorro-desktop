#!/usr/bin/python3 -I
"""zorro-lte: wake the built-in Intel XMM7360 LTE modem and show its state (run as root).

The modem stays silent (and the kernel logs "iosm: msg timeout") until it is started over
its RPC control port /dev/wwan0xmmrpc0 and Lenovo's FCC lock is answered. That part uses
the RPC code of the xmm7360-pci project (xmm7360/, see NOTICE).

  zorro-lte wake       start the modem's services, FCC unlock, radio on
  zorro-lte status     wake, then ask over AT: SIM, operator, signal, registration
  zorro-lte pin [--remember]   enter the SIM PIN (hidden; once per start, or stored root-only)
  zorro-lte up [APN]   wake, attach, connect mobile data on wwan0 (APN: from the operator
                       database by the SIM's network code when not given)
  zorro-lte down       mobile data off (wwan0 down)
  zorro-lte reset      restart the modem (ACPI / bus reset); wake does it by itself
  zorro-lte diag       PCI state, ports and the kernel's modem messages
Wi-Fi and Ethernet stay preferred: the mobile default route has a high metric.
"""
import ipaddress
import os
import re
import select
import subprocess
import signal
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), 'xmm7360'))
IFACE = 'wwan0'
METRIC = 1500                       # Wi-Fi ~600, Ethernet ~100: those win while they are up
PROVIDERS = '/usr/share/mobile-broadband-provider-info/serviceproviders.xml'
PIN_FILE = '/etc/zorro-lte/pin'          # optional, root only (zorro-lte pin --remember)


class Timeout(Exception):
    pass


def step(seconds):
    def on_alarm(*_):
        raise Timeout()
    signal.signal(signal.SIGALRM, on_alarm)
    signal.alarm(seconds)


def ports():
    """the modem's RPC and AT ports (the number can change after a reset)"""
    import glob
    rpcs = sorted(glob.glob('/dev/wwan*xmmrpc0'))
    ats = sorted(glob.glob('/dev/wwan*at[0-9]'))
    return (rpcs[0] if rpcs else None), ats


def modem_pci():
    for d in glob_dirs('/sys/bus/pci/devices/*'):
        try:
            if open(f'{d}/vendor').read().strip() == '0x8086' and \
                    open(f'{d}/device').read().strip() == '0x7360':
                return d
        except OSError:
            pass
    return None


def glob_dirs(pattern):
    import glob
    return sorted(glob.glob(pattern))


def reset():
    """a real restart of the modem: unbind the driver, reset the device through ACPI
    (the firmware switches the modem's power off and on) or a bus reset, bind again"""
    dev = modem_pci()
    if not dev:
        print('!! no XMM7360 modem on the PCI bus')
        return False
    name = os.path.basename(dev)
    print(f'== resetting the modem ({name}; methods: '
          f'{open(f"{dev}/reset_method").read().strip()})')
    drv = os.path.realpath(f'{dev}/driver') if os.path.exists(f'{dev}/driver') else None
    if drv:
        with open(f'{drv}/unbind', 'w') as f:
            f.write(name)
        time.sleep(1)
    try:
        with open(f'{dev}/reset', 'w') as f:
            f.write('1')
    except OSError as e:
        print(f'   reset: {e.strerror}')
    time.sleep(3)
    with open('/sys/bus/pci/drivers/iosm/bind' if not drv else f'{drv}/bind', 'w') as f:
        f.write(name)
    for _ in range(60):                       # the modem boots its firmware: up to ~30 s
        time.sleep(1)
        if ports()[0]:
            time.sleep(5)
            print('== modem back')
            return True
    print('!! the modem did not come back. Switch the laptop fully off (not restart),\n'
          '   wait 10 seconds, switch on, and run  zorro-lte status  first thing.')
    return False


def answers(rpc_port, seconds=8):
    """does the modem answer on its RPC port at all?"""
    import rpc
    r = rpc.XMMRPC([rpc_port])
    step(seconds)
    try:
        r.execute('UtaMsSmsInit')
        return r
    except Timeout:
        os.close(r.fp)                  # let go of the port before a reset
        return None
    finally:
        signal.alarm(0)


def wake():
    import rpc
    port = ports()[0]
    if not port:
        print('!! no modem RPC port (/dev/wwan*xmmrpc0)')
        return None
    r = answers(port)
    if not r:
        print('   the modem does not answer: reset')
        if not reset():
            return None
        r = answers(ports()[0], 20)
        if not r:
            print('!! still no answer after the reset (see: zorro-lte diag)')
            return None
    step(30)
    try:
        for call in ('UtaMsCbsInit', 'UtaMsNetOpen', 'UtaMsCallCsInit',
                     'UtaMsCallPsInitialize', 'UtaMsSsInit', 'UtaMsSimOpenReq'):
            step(30)
            r.execute(call)
        step(30)
        rpc.do_fcc_unlock(r)           # challenge-response, nothing stored in the modem
        step(60)
        rpc.UtaModeSet(r, 1)           # radio on (leaves the FCC "flight mode")
        signal.alarm(0)
        print('\n== modem awake, FCC unlocked, radio on')
        time.sleep(2)
        auto_unlock()
        return r
    except Timeout:
        print('\n!! the modem did not answer within the time limit')
    except Exception as e:             # noqa: BLE001 - report, don't crash
        print(f'\n!! {type(e).__name__}: {e}')
    signal.alarm(0)
    return None


def diag():
    dev = modem_pci()
    print(f'== PCI: {dev or "no XMM7360 found"}')
    if dev:
        drv = os.path.realpath(f'{dev}/driver') if os.path.exists(f'{dev}/driver') else 'none'
        print(f'   driver {os.path.basename(drv)}, power '
              f'{open(f"{dev}/power/runtime_status").read().strip()}')
    rpc_port, ats = ports()
    print(f'== ports: {rpc_port}, {", ".join(ats) or "no AT ports"}')
    log = subprocess.run(['dmesg'], capture_output=True, text=True).stdout.splitlines()
    lines = [ln for ln in log if re.search(r'iosm|wwan|7360', ln, re.I)]
    print('== kernel messages (last 25):')
    for ln in lines[-25:]:
        print('   ' + ln)


def at(fd, cmd, wait=4.0):
    os.write(fd, (cmd + '\r').encode())
    out, end = b'', time.time() + wait
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.3)
        if r:
            out += os.read(fd, 4096)
            if out.rstrip().endswith((b'OK', b'ERROR')) or b'CME ERROR' in out:
                break
    return out.decode(errors='replace').strip().replace('\r', ' ').replace('\n', ' ')


def status():
    fd = at_port()
    if fd is None:
        print('== no AT port answers')
        return
    try:
        for cmd in ('ATI', 'AT+CGMR', 'AT+CFUN?', 'AT+CPIN?', 'AT+COPS?', 'AT+CSQ',
                    'AT+CREG?', 'AT+CEREG?', 'AT+CMGF?'):
            print(f'   {cmd:12} {at(fd, cmd)}')
        m = re.search(r'(\d{5})\d{5,}', at(fd, 'AT+CIMI'))   # SIM id: the network code only
        print(f'   {"network":12} {m.group(1) if m else "? (unlock the SIM first)"}')
    finally:
        os.close(fd)

def at_port():
    """the AT port that answers 'OK' (on the T14: wwan0at1; wwan0at0 stays mute)"""
    for port in ports()[1]:
        try:
            fd = os.open(port, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
        except OSError:
            continue
        if 'OK' in at(fd, 'AT', 4):
            return fd
        os.close(fd)
    return None


def ask(cmd, wait=6):
    """one AT command on the port that answers"""
    fd = at_port()
    if fd is None:
        return ''
    try:
        return at(fd, cmd, wait)
    finally:
        os.close(fd)


def sim_state():
    m = re.search(r'\+CPIN: ([A-Z ]+)', ask('AT+CPIN?'))
    return m.group(1).strip() if m else '?'


def unlock(pin, from_file=False):
    """enter the SIM PIN once (never retried: three wrong PINs block the SIM)"""
    if not re.fullmatch(r'\d{4,8}', pin or ''):
        print('!! a PIN is 4 to 8 digits')
        return False
    out = ask(f'AT+CPIN="{pin}"', 10)
    time.sleep(2)
    if sim_state() == 'READY':
        print('== SIM unlocked')
        return True
    print('!! the SIM did not accept the PIN. Careful: after 3 wrong PINs it needs the PUK.')
    if from_file:
        os.remove(PIN_FILE)                 # never try a wrong stored PIN again
        print(f'   the stored PIN was wrong and is removed ({PIN_FILE})')
    if 'ERROR' in out:
        print(f'   modem: {out}')
    return False


def pin_command(remember=False):
    import getpass
    st = sim_state()
    if st == 'READY':
        print('== the SIM is unlocked already')
        return True
    if st != 'SIM PIN':
        print(f'!! SIM state: {st}' + (' (needs the PUK: use a phone)' if 'PUK' in st else ''))
        return False
    pin = getpass.getpass('SIM PIN (not shown): ').strip()
    if not unlock(pin):
        return False
    if remember:
        os.makedirs(os.path.dirname(PIN_FILE), mode=0o700, exist_ok=True)
        fd = os.open(PIN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(pin + '\n')
        print(f'== PIN stored for automatic unlock (root only: {PIN_FILE})')
    return True


def auto_unlock():
    """after wake: a stored PIN unlocks the SIM by itself"""
    if sim_state() == 'SIM PIN' and os.path.exists(PIN_FILE):
        with open(PIN_FILE) as f:
            unlock(f.read().strip(), from_file=True)


def sim_network():
    """MCC+MNC of the SIM (first digits of the IMSI) and the brand on the SIM (SPN)"""
    m = re.search(r'(\d{6})\d{4,}', ask('AT+CIMI'))
    spn = re.search(r'\+CSPN: "([^"]*)"', ask('AT+CSPN?'))
    return (m.group(1) if m else None), (spn.group(1).strip() if spn else '')


def apn_candidates(imsi6, spn=''):
    """internet APNs for this SIM from mobile-broadband-provider-info, most likely first:
    the provider named like the SIM's brand, then the network's main provider, then others"""
    import xml.etree.ElementTree as ET
    try:
        root = ET.parse(PROVIDERS).getroot()
    except (OSError, ET.ParseError):
        return []
    found = []
    for mnc_len in (2, 3):
        mcc, mnc = imsi6[:3], imsi6[3:3 + mnc_len]
        for prov in root.iter('provider'):
            gsm = prov.find('gsm')
            if gsm is None or not any(n.get('mcc') == mcc and n.get('mnc') == mnc
                                      for n in gsm.findall('network-id')):
                continue
            name = prov.findtext('name') or ''
            rank = 0 if spn and (spn.lower() in name.lower() or name.lower() in spn.lower()) \
                else 1 if prov.get('primary') == 'true' else 2
            for a in gsm.findall('apn'):
                use = a.find('usage')
                if use is None or use.get('type') == 'internet':
                    found.append((rank, len(found), a.get('value'), name))
        if found:
            break
    out, seen = [], set()
    for _, _, apn, name in sorted(found):
        if apn not in seen:
            seen.add(apn)
            out.append((apn, name))
    return out


def sh(*cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        print(f'   ({" ".join(cmd)}: {r.stderr.strip()})')
    return r.returncode == 0


def attach(r, apn):
    """attach with this APN; the IP address and DNS servers, or (None, None)"""
    import rpc
    r.execute('UtaMsCallPsAttachApnConfigReq', rpc.pack_UtaMsCallPsAttachApnConfigReq(apn),
              is_async=True)
    res = r.execute('UtaMsNetAttachReq', rpc.pack_UtaMsNetAttachReq(), is_async=True)
    _, st = rpc.unpack('nn', res['body'])
    if st == 0xffffffff:                        # not ready yet: wait for the network
        print('   waiting for the network...')
        while not r.attach_allowed:
            r.pump()
        res = r.execute('UtaMsNetAttachReq', rpc.pack_UtaMsNetAttachReq(), is_async=True)
        _, st = rpc.unpack('nn', res['body'])
        if st == 0xffffffff:
            return None, None
    return rpc.get_ip(r)


def up(apn=None):
    import rpc
    r = wake()
    if not r:
        return False
    time.sleep(2)
    if sim_state() != 'READY':
        print(f'!! SIM: {sim_state()}. Unlock it first:  zorro-lte pin')
        return False
    for _ in range(30):                     # registration takes a few seconds after unlock
        if re.search(r'\+CEREG: \d,[15]', ask('AT+CEREG?')):
            break
        time.sleep(1)
    if apn:
        tries = [(apn, 'given')]
    else:
        imsi6, spn = sim_network()
        tries = apn_candidates(imsi6, spn)[:3] if imsi6 else []
        print(f'== SIM network {imsi6[:5] if imsi6 else "?"}, brand {spn or "?"}; '
              f'APNs to try: {", ".join(a for a, _ in tries) or "none known"}')
        if not tries:
            print('!! give the APN, e.g.  zorro-lte up internet')
            return False
    ip = dns = None
    try:
        for a, name in tries:
            step(90)
            print(f'   trying APN {a} ({name})')
            ip, dns = attach(r, a)
            if ip:
                break
        if not ip:
            print('!! no IP address from the network: wrong APN? try  zorro-lte up <APN>')
            return False
        r.execute('UtaRPCPsConnectToDatachannelReq', rpc.pack_UtaRPCPsConnectToDatachannelReq())
        r.execute('UtaMsCallPsConnectReq', rpc.pack_UtaMsCallPsConnectReq(), is_async=True)
    except Timeout:
        print('!! the modem did not answer within the time limit')
        return False
    finally:
        signal.alarm(0)
    print(f'== connected: {ip}  DNS {", ".join(str(d) for d in dns["v4"]) or "-"}')
    sh('ip', 'addr', 'flush', 'dev', IFACE)
    sh('ip', 'addr', 'add', f'{ipaddress.ip_address(ip)}/32', 'dev', IFACE)
    sh('ip', 'link', 'set', IFACE, 'up')
    sh('ip', 'route', 'replace', 'default', 'dev', IFACE, 'metric', str(METRIC))
    if dns['v4'] and sh('resolvectl', 'dns', IFACE, *[str(d) for d in dns['v4']]):
        sh('resolvectl', 'domain', IFACE, '~.')
    print(f'== mobile data on {IFACE} (Wi-Fi and Ethernet stay first while they are up)')
    return True


def down():
    sh('ip', 'route', 'del', 'default', 'dev', IFACE)
    sh('ip', 'addr', 'flush', 'dev', IFACE)
    sh('ip', 'link', 'set', IFACE, 'down')
    sh('resolvectl', 'revert', IFACE)
    print('== mobile data off')
    return True


def main():
    if os.geteuid() != 0:
        sys.exit('run with sudo')
    a = sys.argv[1:]
    if a == ['wake']:
        sys.exit(0 if wake() else 1)
    elif a == ['status']:
        wake()
        time.sleep(2)
        status()
    elif a[:1] == ['up'] and len(a) <= 2:
        sys.exit(0 if up(a[1] if len(a) == 2 else None) else 1)
    elif a == ['down']:
        sys.exit(0 if down() else 1)
    elif a[:1] == ['pin'] and a[1:] in ([], ['--remember']):
        if not wake():
            sys.exit(1)
        sys.exit(0 if pin_command('--remember' in a) else 1)
    elif a == ['reset']:
        sys.exit(0 if reset() else 1)
    elif a == ['diag']:
        diag()
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == '__main__':
    main()
