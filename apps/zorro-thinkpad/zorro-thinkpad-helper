#!/usr/bin/python3 -I
"""zorro-thinkpad-helper: the few things of the ThinkPad app that need root.
Installed root-owned in /usr/local/libexec, run through pkexec (polkit: the active local
session may run it without a password). Only these fixed verbs, every value validated:

  power AC_PROFILE BAT_PROFILE START STOP   power mode on charger / battery + charge
                                            thresholds -> /etc/tlp.d/20-zorro-thinkpad.conf,
                                            then 'tlp start' applies it right away
  fullcharge                                charge to 100% once (until unplugged)
  greeter-look JSON                         login / lock screen look -> /etc/zorro-dm/look.json
                                            (only known keys, numbers clamped, colours checked)
  cable IFACE                               a wired port the Debian installer gave to ifupdown
                                            (/etc/network/interfaces): its lines commented out,
                                            NetworkManager restarted, so it manages the cable and
                                            prefers it over Wi-Fi (zorro-net-helper, asks a password)
  dicts LANG ...                            spell-check dictionaries: exactly these installed
                                            (from the fixed list DICTS; the others removed)
"""
import json
import re
import os
import subprocess
import sys

CONF = '/etc/tlp.d/20-zorro-thinkpad.conf'
PROFILES = ('low-power', 'balanced', 'performance')
TLP = '/usr/sbin/tlp'
os.environ['PATH'] = '/usr/sbin:/usr/bin:/sbin:/bin'


def die(msg):
    print(f'zorro-thinkpad-helper: {msg}', file=sys.stderr)
    sys.exit(2)


def power(ac, bat, start, stop):
    if ac not in PROFILES or bat not in PROFILES:
        die('profile must be one of ' + ', '.join(PROFILES))
    try:
        start, stop = int(start), int(stop)
    except ValueError:
        die('thresholds must be numbers')
    if not (0 <= start < stop <= 100 and stop >= 50):
        die('need 0 <= START < STOP <= 100 and STOP >= 50')
    text = ('# written by the ThinkPad app (zorro-thinkpad); overrides 10-battery.conf\n'
            f'PLATFORM_PROFILE_ON_AC={ac}\n'
            f'PLATFORM_PROFILE_ON_BAT={bat}\n'
            f'START_CHARGE_THRESH_BAT0={start}\n'
            f'STOP_CHARGE_THRESH_BAT0={stop}\n')
    tmp = CONF + '.tmp'
    with open(tmp, 'w') as fh:
        fh.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, CONF)
    sys.exit(subprocess.run([TLP, 'start']).returncode)


LOOK_FILE = '/etc/zorro-dm/look.json'
ANIMALS = ('bluewhale', 'whale', 'rightwhale', 'vaquita', 'hammerhead', 'whaleshark', 'sawfish',
           'turtle', 'hawksbill', 'manta', 'dugong', 'seahorse', 'otter', 'random')
LOOK_NUM = {   # key: (min, max)
    'density': (0.3, 3), 'size': (0.2, 3), 'swim_speed': (0.1, 5), 'pass_seconds': (10, 300),
    'gap_seconds': (0, 300), 'far': (0, 1), 'snow_amount': (0, 2000), 'snow_speed': (0, 10),
    'snow_size': (0.2, 6), 'snow_alpha': (0, 4), 'grain': (0, 4), 'scratches': (0, 4),
    'dust': (0, 4), 'scanlines': (0, 3), 'vignette': (0, 1.5), 'flicker': (0, 4),
    'chroma': (0, 8), 'glitch_rate': (0, 6), 'glitch_strength': (0, 3),
    'cblur': (0, 4), 'bloom': (0, 4), 'bg_strength': (0, 3), 'bg_speed': (0, 5),
    'bg_aberration': (0, 4), 'fps': (5, 60),
}
CBLUR_MODES = ('lens', 'prism', 'glow')
BACKGROUNDS = ('deep', 'waves', 'streaks', 'black')
LOOK_COLOUR = ('line_colour', 'snow_colour')
LOOK_BOOL = ('bars', 'crt', 'clock')


def greeter_look(text):
    if len(text) > 8000:
        die('look too long')
    try:
        raw = json.loads(text)
    except ValueError:
        die('look is not JSON')
    if not isinstance(raw, dict):
        die('look must be an object')
    out = {}
    for k, v in raw.items():
        if k == 'animal' and v in ANIMALS:
            out[k] = v
        elif k == 'cblur_mode' and v in CBLUR_MODES:
            out[k] = v
        elif k == 'background' and v in BACKGROUNDS:
            out[k] = v
        elif k in LOOK_NUM and isinstance(v, (int, float)) and not isinstance(v, bool):
            lo, hi = LOOK_NUM[k]
            out[k] = min(hi, max(lo, float(v)))
        elif k in LOOK_COLOUR and isinstance(v, str) and re.fullmatch(r'#[0-9a-fA-F]{6}', v):
            out[k] = v
        elif k in LOOK_BOOL and isinstance(v, bool):
            out[k] = v
    os.makedirs(os.path.dirname(LOOK_FILE), exist_ok=True)
    tmp = LOOK_FILE + '.tmp'
    with open(tmp, 'w') as fh:
        json.dump(out, fh, indent=2)
    os.chmod(tmp, 0o644)
    os.replace(tmp, LOOK_FILE)
    sys.exit(0)


# spell-check dictionaries the Zorro app can add or remove (Desktop → Languages)
DICTS = {'en-GB': 'hunspell-en-gb', 'en-US': 'hunspell-en-us', 'nl': 'hunspell-nl',
         'de': 'hunspell-de-de', 'fr': 'hunspell-fr', 'es': 'hunspell-es', 'it': 'hunspell-it',
         'pt': 'hunspell-pt-pt'}


def dicts(langs):
    if not langs or any(x not in DICTS for x in langs):
        die('dicts: languages from ' + ' '.join(DICTS))
    want = {DICTS[x] for x in langs}
    have = set(subprocess.run(['dpkg-query', '-W', '-f', '${Package} ${db:Status-Abbrev}\n',
                               *DICTS.values()], capture_output=True, text=True).stdout.split('\n'))
    have = {ln.split()[0] for ln in have if ln.strip().endswith('ii')}
    env = dict(os.environ, DEBIAN_FRONTEND='noninteractive')
    add, drop = sorted(want - have), sorted((set(DICTS.values()) & have) - want)
    rc = 0
    if add:
        print('installing', *add, flush=True)
        rc |= subprocess.run(['apt-get', 'install', '-y', '--no-install-recommends', *add], env=env).returncode
    if drop:
        print('removing', *drop, flush=True)
        rc |= subprocess.run(['apt-get', 'remove', '-y', *drop], env=env).returncode
    sys.exit(rc)


def cable(iface):
    """hand a wired port from ifupdown to NetworkManager"""
    if not re.fullmatch(r'(en|eth)[a-z0-9]{1,14}', iface) or not os.path.isdir(f'/sys/class/net/{iface}'):
        die('not a wired port: ' + iface)
    path = '/etc/network/interfaces'
    try:
        lines = open(path).read().splitlines(keepends=True)
    except OSError as e:
        die(str(e))
    word = re.compile(r'(^|\s)' + re.escape(iface) + r'(\s|$)')
    if not any(word.search(ln) and not ln.lstrip().startswith('#') for ln in lines):
        sys.exit(0)                                     # not there: nothing to do
    subprocess.run(['ifdown', '--force', iface], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    backup = path + '.before-zorro'
    if not os.path.exists(backup):
        with open(backup, 'w') as fh:
            fh.writelines(lines)
    out, mine = [], False
    for ln in lines:
        indented = ln[:1] in (' ', '\t') and ln.strip()
        if word.search(ln) and not ln.lstrip().startswith('#'):
            mine = ln.split()[:1] == ['iface']          # its option lines (address, gateway) follow
            out.append('# zorro: NetworkManager manages this now: ' + ln)
        elif mine and indented and not ln.lstrip().startswith('#'):
            out.append('# zorro: NetworkManager manages this now: ' + ln)
        else:
            mine = mine and bool(indented)
            out.append(ln)
    tmp = path + '.zorro-tmp'
    with open(tmp, 'w') as fh:
        fh.writelines(out)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    sys.exit(subprocess.run(['systemctl', 'restart', 'NetworkManager']).returncode)


def main():
    a = sys.argv[1:]
    # installed twice: zorro-look-helper may only write the login look (asks a password,
    # since it writes to /etc); zorro-thinkpad-helper does power, without asking
    if os.path.basename(sys.argv[0]) == 'zorro-look-helper':
        if a[:1] == ['greeter-look'] and len(a) == 2:
            greeter_look(a[1])
        die('usage: greeter-look JSON')
    if os.path.basename(sys.argv[0]) == 'zorro-net-helper':      # asks a password: network setup
        if a[:1] == ['cable'] and len(a) == 2:
            cable(a[1])
        die('usage: cable IFACE')
    if os.path.basename(sys.argv[0]) == 'zorro-lang-helper':     # asks a password: installs
        if a[:1] == ['dicts']:
            dicts(a[1:])
        die('usage: dicts LANG ...')
    if a[:1] == ['power'] and len(a) == 5:
        power(*a[1:])
    elif a == ['fullcharge']:
        sys.exit(subprocess.run([TLP, 'fullcharge', 'BAT0']).returncode)
    else:
        die('usage: power AC BAT START STOP | fullcharge')


if __name__ == '__main__':
    main()
