<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>zorro-desktop</vendor>
  <action id="org.zorro.thinkpad.helper">
    <description>Change ThinkPad power mode and battery charge limits</description>
    <message>The ThinkPad app wants to change the power settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/zorro-thinkpad-helper</annotate>
  </action>
  <action id="org.zorro.thinkpad.look">
    <description>Change the login and lock screen look</description>
    <message>The Zorro app wants to change the login screen look</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/zorro-look-helper</annotate>
  </action>
  <action id="org.zorro.thinkpad.lang">
    <description>Add or remove spell-check dictionaries</description>
    <message>The Zorro app wants to install or remove spell-check dictionaries</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/zorro-lang-helper</annotate>
  </action>
  <action id="org.zorro.thinkpad.lte">
    <description>Use the built-in LTE modem (start, SIM PIN, mobile data)</description>
    <message>The Zorro app wants to use the LTE modem</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/zorro-lte/zorro-lte</annotate>
  </action>
</policyconfig>
