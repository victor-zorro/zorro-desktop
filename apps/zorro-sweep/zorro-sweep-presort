#!/usr/bin/env python3
"""Pre-sort for Sweep in Obsidian: for every note at the top of a vault (and directly in its
top-level folders), the 3 folders of that vault closest in meaning (with their scores), from zorro-search's index.
Written as "suggest" into the Obsidian plugin's data.json, where Sweep (laptop and phone)
lights that notebook up as the best match. Only vaults that have the plugin.

zorro-search runs this after each index update; by hand: zorro-sweep-presort [-v]"""
import json
import os
import sys
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(HERE))
import gi                                       # noqa: E402
gi.require_version('GLib', '2.0')
from sweeplib import Meaning, attach_dir, state_file, vaults  # noqa: E402


MIN = 0.08                     # least likeness for a suggestion (after centring)


def folders(vault):
    att = attach_dir(vault)
    return sorted(f for f in vault.iterdir()
                  if f.is_dir() and not f.name.startswith(('.', '_')) and f != att)


def presort(vault, meaning):
    data = state_file(vault)
    if data.parent.name not in ('sweep-or-keep', 'zorro-sweep'):   # no plugin in this vault
        return None
    meaning.set_vault(vault)                     # measured from the vault's average note
    dests = [(f, meaning.centre(f)) for f in folders(vault)]
    dests = [(f, c) for f, c in dests if c is not None]
    suggest = {}
    if len(dests) > 1:
        notes = list(vault.glob('*.md'))
        for f, _ in dests:
            notes += f.glob('*.md')
        for p in notes:
            v = meaning.of(p)
            if v is None:
                continue
            own = p.parent
            top = sorted(((float(v @ c), f) for f, c in dests if f != own), key=lambda t: -t[0])[:3]
            top = [(sc, f) for sc, f in top if sc >= MIN]      # too far from a notebook: not suggested
            if top:                              # the plugin mixes these with its own matching
                suggest[p.relative_to(vault).as_posix()] = [[f.relative_to(vault).as_posix(), round(sc, 3)]
                                                            for sc, f in top]
    try:
        st = json.loads(data.read_text())
    except (OSError, ValueError):
        st = {}
    if st.get('suggest') == suggest:
        return len(suggest)
    st['suggest'] = suggest
    tmp = data.with_name('data.json.tmp')
    tmp.write_text(json.dumps(st, indent=2, ensure_ascii=False))
    os.replace(tmp, data)
    return len(suggest)


def main():
    loud = '-v' in sys.argv
    meaning = Meaning()
    if not meaning.ok:
        print('zorro-sweep-presort: no zorro-search index yet', file=sys.stderr)
        return 1
    for v in vaults():
        n = presort(Path(v), meaning)
        if loud and n is not None:
            print(f'{Path(v).name}: {n} notes with a best match')
    return 0


if __name__ == '__main__':
    sys.exit(main())
