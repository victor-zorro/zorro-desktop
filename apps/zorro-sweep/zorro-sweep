            return False
        f = self.v.path / name
        f.mkdir(exist_ok=True)
        self.find_dests()
        d = next(x for x in self.dests if x['path'] == f)
        self.send(p, d)
        return True

    # ---- notebooks: make, rename, delete ------------------------------------------------------
