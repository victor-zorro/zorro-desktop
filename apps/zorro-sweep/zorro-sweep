            self.nb_list.remove(c)
        for d in self.dests:
            if not d['path']:
                continue
            row = Gtk.Box(spacing=8, margin=6)
            lab = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
            lab.set_markup(f'{GLib.markup_escape_text(d["name"])}\n<small>{d["sub"]} · '
