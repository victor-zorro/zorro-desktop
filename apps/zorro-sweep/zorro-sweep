# ---- vaults and notes ----------------------------------------------------------------------
def vaults():
    try:
        v = json.loads(OBSIDIAN_JSON.read_text())['vaults'].values()
        return [Path(x['path']) for x in v if Path(x['path']).is_dir()]
    except (OSError, ValueError, KeyError):
        return []


def attach_dir(vault):
    try:
        sub = json.loads((vault / '.obsidian/app.json').read_text()).get('attachmentFolderPath', '')
    except (OSError, ValueError):
        sub = ''
    sub = sub.strip('/') if sub and not sub.startswith('.') else ''
    return vault / sub if sub else vault


def front(text):
    """(front matter dict of simple key: value lines, body)"""
    meta = {}
    if text.startswith('---\n'):
        end = text.find('\n---', 4)
        if end > 0:
            for ln in text[4:end].splitlines():
                k, _, v = ln.partition(':')
                if v:
                    meta[k.strip()] = v.strip()
            text = text[end + 4:].lstrip('\n')
    return meta, text


def refs(text):
    """the file names a note links to or embeds (lower case, no folders)"""
    out = set()
    for a, b in LINKS.findall(text):
        name = a or urllib.parse.unquote(b)
        if '://' in name:
            continue
        out.add(Path(name.strip()).name.lower())
    return out


def when(meta, path):
    for k in ('created', 'date'):
        try:
            return datetime.fromisoformat(meta[k][:16]).timestamp()
        except (KeyError, ValueError):
            pass
    return path.stat().st_mtime


def ago(ts):
    days = (time.time() - ts) / 86400
    if days < 1:
        return 'today'
    if days < 60:
        return f'{int(days)} days ago'
    if days < 730:
        return f'{int(days / 30.4)} months ago'
    return f'{int(days / 365.25)} years ago'


def markup(body, limit=7000):
    """a rough Pango rendering of markdown, enough to recognise a note"""
    out = []
    for ln in body[:limit].splitlines():
        ln = re.sub(r'<[^>]+>', '', ln)
        ln = re.sub(r'!\[\[[^\]]*\]\]|!\[[^\]]*\]\([^)]*\)', '', ln)
        if not ln.strip():
            if out and out[-1] != GAP:
                out.append(GAP)
            continue
        e = GLib.markup_escape_text(ln)
        e = re.sub(r'\[\[([^\]|]+)\|([^\]]+)\]\]', r'\2', e)
        e = re.sub(r'\[\[([^\]]+)\]\]', r'<span foreground="#19e6ff">\1</span>', e)
        e = re.sub(r'\[([^\]]+)\]\(([^)]+)\)', r'<span foreground="#19e6ff">\1</span>', e)
        e = re.sub(r'\*\*(.+?)\*\*|__(.+?)__', lambda m: f'<b>{m[1] or m[2]}</b>', e)
        e = re.sub(r'(?<![\w*])\*(?!\s)(.+?)\*(?!\w)', r'<i>\1</i>', e)
        e = re.sub(r'`([^`]+)`', r'<tt>\1</tt>', e)
        e = re.sub(r'^(\s*)[-*+] \[ \] ', r'\1☐ ', e)
        e = re.sub(r'^(\s*)[-*+] \[[xX]\] ', r'\1☑ ', e)
        e = re.sub(r'^(\s*)[-*+] ', r'\1•  ', e)
        h = re.match(r'^(#{1,6}) (.*)', e)
        if h:
            e = f'<span size="{"x-large" if len(h[1]) == 1 else "large"}" weight="bold">{h[2]}</span>'
        if re.fullmatch(r'\s*(-{3,}|\*{3,})\s*', ln):
            e = '<span foreground="#6f7079">────────</span>'
        out.append(e)
    while out and out[-1] == GAP:
        out.pop()
    text = '\n'.join(out).strip()
    if len(body) > limit:
        text += '\n<span foreground="#6f7079">…</span>'
    return text or '<span foreground="#6f7079">(empty note)</span>'


class Vault:
    """the vault being swept: its notes, its pictures and who uses them"""

    def __init__(self, path):
        self.path = path
        self.state_file = STATE_DIR / (re.sub(r'[^\w.-]+', '_', path.name) + '.json')
        try:
            st = json.loads(self.state_file.read_text())
        except (OSError, ValueError):
            st = {}
        self.kept = set(st.get('kept', []))      # names relative to the vault
        self.stays = set(st.get('stays', []))    # kept and sorted: stays where it is
        # this round's kept notes, sorted once there are ROUND of them (older kept notes, from
        # before rounds existed, make up the first round)
        self.batch = st.get('batch', sorted(self.kept - self.stays))
        self.stats = {'deleted': 0, 'moved': 0, **st.get('stats', {})}
        self.files = {}                          # lower-case name: path, for pictures and pdfs
        self.uses = {}                           # lower-case name: set of notes that link to it
        for p in self.path.rglob('*'):
            rel = p.relative_to(self.path)
            if rel.parts[0].startswith('.') or not p.is_file():
                continue
            if p.suffix.lower() == '.md':
                for r in refs(self.read(p)):
                    self.uses.setdefault(r, set()).add(p)
            else:
                self.files.setdefault(p.name.lower(), p)
        self.notes = sorted((p for p in self.path.glob('*.md')), key=self.age)

    @staticmethod
    def read(p):
        try:
            return p.read_text(errors='replace')
        except OSError:
            return ''

    def age(self, p):
        return when(front(self.read(p)[:600])[0], p)

    def save(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        live = {p.name for p in self.path.glob('*.md')}
        tmp = self.state_file.with_suffix('.tmp')
        tmp.write_text(json.dumps({'kept': sorted(self.kept & live), 'stays': sorted(self.stays & live),
                                   'batch': [b for b in self.batch if b in live],
                                   'stats': self.stats}, indent=0))
        os.replace(tmp, self.state_file)

    def to_scan(self):
        return [p for p in self.notes if p.exists() and p.name not in self.kept]

    def sorted_count(self):
        return self.stats['moved'] + len(self.stays)

    @staticmethod
    def left_in(path):
        """notes still to scan in a vault, from its saved progress"""
        try:
            st = json.loads((STATE_DIR / (re.sub(r'[^\w.-]+', '_', path.name) + '.json')).read_text())
        except (OSError, ValueError):
            st = {}
        done = set(st.get('kept', [])) | set(st.get('stays', []))
        return sum(1 for p in path.glob('*.md') if p.name not in done)

    def attachments(self, note, text):
        return [self.files[r] for r in refs(text) if r in self.files and self.files[r].exists()]

    def only_mine(self, note, f):
        return self.uses.get(f.name.lower(), set()) <= {note}

    def forget(self, note, text):
        for r in refs(text):
            self.uses.get(r, set()).discard(note)

    def learn(self, note, text):
        for r in refs(text):
            self.uses.setdefault(r, set()).add(note)


def free_name(path):
    if not path.exists():
        return path
    for i in range(2, 1000):
        p = path.with_name(f'{path.stem} {i}{path.suffix}')
        if not p.exists():
            return p
    raise OSError(f'no free name for {path}')


def move(src, dst, ops):
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(src), str(dst))
    ops.append(('mv', src, dst))


def obsidian_open():
    return subprocess.run(['pgrep', '-x', 'obsidian'], capture_output=True).returncode == 0


def set_vault_path(old, new):
    """Obsidian's vault list: point a vault at a new folder (new=None: take it off the list).
    Only while Obsidian is closed: it writes this file itself."""
    d = json.loads(OBSIDIAN_JSON.read_text())
    for k, v in list(d['vaults'].items()):
        if Path(v['path']) == old:
            if new is None:
                del d['vaults'][k]
            else:
                v['path'] = str(new)
    tmp = OBSIDIAN_JSON.with_suffix('.zorro-tmp')
    tmp.write_text(json.dumps(d))
    os.replace(tmp, OBSIDIAN_JSON)


def undo_ops(ops):
    for op in reversed(ops):
        if op[0] == 'mkdir':
            shutil.rmtree(op[1]) if op[1].is_dir() and not any(op[1].iterdir()) else None
        elif op[0] == 'vaultpath':
            set_vault_path(op[2], op[1])
        elif op[0] == 'mv':
            op[1].parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(op[2]), str(op[1]))
        elif op[0] == 'cp':
            op[1].unlink(missing_ok=True)
        elif op[0] == 'write':
            op[1].write_text(op[2])


# ---- the meaning of notes (the search app's index) -------------------------------------------
class Meaning:
    """note vectors from zorro-search's index: a note is the mean of its pieces, a notebook the
    mean of its notes. Without the index there are simply no suggestions."""

    def __init__(self):
        self.ok = False
        try:
            import numpy as np
            self.np = np
            meta = json.loads((INDEX / 'meta.json').read_text())
            vecs = np.load(INDEX / 'vecs.npy').astype(np.float32)
            if len(meta) != len(vecs):
                return
        except Exception:               # noqa: BLE001 - no index, no numpy: no suggestions
            return
        rows = {}
        for i, m in enumerate(meta):
            rows.setdefault(m['p'], []).append(i)
        self.note = {p: self.unit(vecs[ix].mean(0)) for p, ix in rows.items()}
        self.ok = True

    def unit(self, v):
        n = self.np.linalg.norm(v)
        return v / n if n else v

    def of(self, path):
        return self.note.get(str(path)) if self.ok else None

    def centre(self, folder, flat=False):
        if not self.ok:
            return None
        pre = str(folder) + '/'
        vs = [v for p, v in self.note.items() if p.startswith(pre) and (not flat or '/' not in p[len(pre):])]
        return self.unit(self.np.mean(vs, 0)) if vs else None


# ---- the window ------------------------------------------------------------------------------
class Sweep(Gtk.Window):
    def __init__(self, vault):
        super().__init__(title='Sweep notes')
        self.set_default_size(1180, 820)
        self.set_icon_name('edit-clear-all')
        self.v = Vault(vault)
        self.meaning = Meaning()
        self.mode = 'sweep'
        self.dx = self.dy = 0.0            # how far the card is dragged
        self.drag = None                   # (x, y) where the drag started
        self.wheel_at = 0.0                # touchpad swipe: last scroll event
        self.scroll = 0.0                  # the preview, scrolled down
        self.fly = None                    # (start, from dx, to dx, to dy, then)
        self.enter_at = time.monotonic()   # new card zooms in
        self.toast, self.toast_at = '', 0.0
        self.undo = []
        self.skipped = set()
        self.hover = None                  # Sort: the notebook under the card
        self.card = None                   # cached rendering of the current note
        self.banner = None                 # (title, sub, start): round start / round done
        self.undo_rect = None              # the undo button under the card (x, y, w, h)
        self.undo_hot = False
        self.nb_win = None                 # the Notebooks window, when open
        self.dests = []
        self.find_dests()

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        top = Gtk.Box(spacing=6, margin=10)
        self.b_sweep = Gtk.RadioButton(label='Keep or delete', draw_indicator=False)
        self.b_sort = Gtk.RadioButton(label='Sort into notebooks', group=self.b_sweep, draw_indicator=False)
        for b, m in ((self.b_sweep, 'sweep'), (self.b_sort, 'sort')):
            b.connect('toggled', lambda b, m=m: b.get_active() and self.set_mode(m))
            top.add(b)
        self.count = Gtk.Label(xalign=1, hexpand=True)
        top.add(self.count)
        self.pick = Gtk.ComboBoxText()
        self.pick.set_tooltip_text('Which notebook (vault) to sweep')
        self.pick_paths = []
        self.fill_pick()
        self.pick.connect('changed', lambda c: self.change_vault())
        top.add(self.pick)
        nb = Gtk.Button(label='Notebooks')
        nb.set_tooltip_text('Make, rename or delete notebooks')
        nb.connect('clicked', lambda b: self.notebooks())
        top.add(nb)
        box.add(top)

        self.area = Gtk.DrawingArea(vexpand=True, can_focus=True)
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                             Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK |
                             Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.area.connect('draw', self.draw_bg)
        self.snow = None
        try:                                # the theme's particles (apps/zorro-fx)
            sys.path.insert(0, str(HERE.parent / 'zorro-fx'))
            import zorro_fx
            self.snow = zorro_fx.Snow(self.area, radius=0, profile='overlay')
        except Exception:                   # noqa: BLE001 - without it: just dark
            pass
        self.area.connect('draw', self.draw)
        self.area.connect('button-press-event', self.press)
        self.area.connect('motion-notify-event', self.motion)
        self.area.connect('button-release-event', self.release)
        self.area.connect('scroll-event', self.wheel)
        box.add(self.area)
        self.add(box)
        self.connect('key-press-event', self.key)
        self.connect('destroy', lambda w: (self.v.save(), Gtk.main_quit()))
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, 800)
        self.show_all()
        self.area.grab_focus()
        if len(self.v.batch) >= ROUND:     # a full round waits to be sorted
            self.b_sort.set_active(True)
        self.next_card()
        GLib.timeout_add(16, self.tick)

    def fill_pick(self):
        self.pick_paths = sorted(vaults(), key=lambda p: p.name.lower())
        self.pick.remove_all()
        for p in self.pick_paths:
            n = Vault.left_in(p) if p != self.v.path else len(self.v.to_scan())
            self.pick.append_text(f'{p.name} · {n} to scan')
        if self.v.path in self.pick_paths:
            self.pick.set_active(self.pick_paths.index(self.v.path))

    def change_vault(self):
        i = self.pick.get_active()
        if i < 0 or self.pick_paths[i] == self.v.path:
            return
        self.v.save()
        self.v = Vault(self.pick_paths[i])
        self.undo.clear()
        self.skipped.clear()
        self.fly = None
        self.find_dests()
        self.say(f'sweeping {self.v.path.name}')
        want = self.b_sort if len(self.v.batch) >= ROUND else self.b_sweep
        if want.get_active():
            self.next_card()
        else:
            want.set_active(True)
        self.area.grab_focus()

    # ---- what is shown -------------------------------------------------------------------
    def find_dests(self):
        """other vaults, and the folders in this one"""
        out = []
        for f in sorted(self.v.path.iterdir()):
            if f.is_dir() and not f.name.startswith(('.', '_')) and f != attach_dir(self.v.path):
                out.append({'name': f.name, 'sub': 'folder in ' + self.v.path.name, 'path': f, 'vault': False})
        for vp in sorted(vaults()):
            if vp != self.v.path:
                out.append({'name': vp.name, 'sub': 'vault', 'path': vp, 'vault': True})
        for d in out:
            d['vec'] = self.meaning.centre(d['path'])
            d['n'] = sum(1 for p in d['path'].rglob('*.md')
                         if not any(x.startswith('.') for x in p.relative_to(d['path']).parts))
        out.append({'name': 'Stays in ' + self.v.path.name, 'sub': 'keep it where it is', 'path': None,
                    'vault': False, 'vec': None, 'stay': True})
        out.append({'name': '+ New folder', 'sub': 'in ' + self.v.path.name, 'path': None,
                    'vault': False, 'vec': None, 'new': True})
        self.dests = out

    def queue(self):
        live = [p for p in self.v.notes if p.exists()]
        if self.mode == 'sweep':
            return [p for p in live if p.name not in self.v.kept and p not in self.skipped]
        todo = [p for p in live if p.name in self.v.kept and p.name not in self.v.stays
                and p not in self.skipped]
        if self.v.batch:                    # this round's notes
            b = set(self.v.batch)
            return [p for p in todo if p.name in b]
        return todo

    def next_card(self):
        q = self.queue()
        if not q and self.skipped:          # all seen: the skipped ones come round again
            self.skipped.clear()
            q = self.queue()
        if not q and self.mode == 'sort' and not self.fly:      # round sorted: next round
            if self.v.batch:
                n = len(self.v.batch)
                self.v.batch = []
                self.v.save()
                self.banner = (f'ROUND {self.round() - 1} DONE', f'{n} notes sorted · on to the next {ROUND}',
                               time.monotonic())
            if self.v.to_scan():
                self.b_sweep.set_active(True)
                return
        if not q and self.mode == 'sweep' and self.v.batch and not self.fly:   # nothing left
            self.banner = ('LAST ROUND', 'sort the last ones you kept', time.monotonic())
            self.b_sort.set_active(True)
            return
        self.dx = self.dy = self.scroll = 0.0
        self.hover = None
        self.enter_at = time.monotonic()
        self.card = self.load(q[0]) if q else None
        self.left = len(q)
        self.update_count()
        self.area.queue_draw()

    def round(self):
        return self.v.sorted_count() // ROUND + 1

    def update_count(self):
        left = len(self.v.to_scan())
        st = self.v.stats
        self.count.set_text(f'{left} left to scan · {st["deleted"]} deleted · {self.v.sorted_count()} sorted')
        i = self.pick.get_active()
        if 0 <= i < len(self.pick_paths) and self.pick_paths[i] == self.v.path:
            self.pick.get_model()[i][0] = f'{self.v.path.name} · {left} to scan'

    def load(self, path):
        text = self.v.read(path)
        meta, body = front(text)
        pics = [f for f in self.v.attachments(path, text) if IMG.search(f.name)]
        pix = None
        for f in pics[:3]:
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(f), 560, 240, True)
                break
            except GLib.Error:
                pass
        n_att = len(self.v.attachments(path, text))
        sub = ago(when(meta, path))
        if n_att:
            sub += f' · {n_att} attachment{"s" if n_att > 1 else ""}'
        words = len(body.split())
        sub += f' · {words} word{"s" if words != 1 else ""}'
        card = {'path': path, 'title': path.stem, 'sub': sub, 'markup': markup(body), 'pix': pix,
                'scores': {}}
        vec = self.meaning.of(path)
        if vec is not None:
            for i, d in enumerate(self.dests):
                if d['vec'] is not None:
                    card['scores'][i] = float(vec @ d['vec'])
        card['best'] = max(card['scores'], key=card['scores'].get) if card['scores'] else None
        return card

    def set_mode(self, m):
        if m != self.mode:
            self.mode = m
            self.skipped.clear()
            self.fly = None
            self.next_card()
            self.area.grab_focus()

    def say(self, text):
        self.toast, self.toast_at = text, time.monotonic()

    # ---- actions -------------------------------------------------------------------------
    def keep(self, p):
        self.v.kept.add(p.name)
        if p.name not in self.v.batch:
            self.v.batch.append(p.name)
        self.undo.append(('keep', p))
        self.v.save()
        n = len(self.v.batch)
        if n >= ROUND:                      # a full hand: now sort them
            self.banner = (f'ROUND {self.round()}', f'{n} kept · now sort them into notebooks',
                           time.monotonic())
            self.b_sort.set_active(True)
        else:
            self.say(f'kept · {n} of {ROUND}')

    def delete(self, p):
        text = self.v.read(p)
        trash = self.v.path / '.trash'
        ops = []
        try:
            for f in self.v.attachments(p, text):
                if self.v.only_mine(p, f):
                    move(f, free_name(trash / f.name), ops)
            move(p, free_name(trash / p.name), ops)
        except OSError as e:
            undo_ops(ops)
            self.say(f'could not delete: {e}')
            return
        self.v.forget(p, text)
        self.v.stats['deleted'] += 1
        self.v.save()
        self.undo.append(('delete', p, ops, text))
        self.say('deleted · Ctrl+Z brings it back')

    def send(self, p, d):
        """move a kept note to a folder or another vault (pictures go along)"""
        text = self.v.read(p)
        ops = []
        try:
            if not d['vault']:                       # a folder here: links keep working
                move(p, free_name(d['path'] / p.name), ops)
            else:
                adir = attach_dir(d['path'])
                new = text
                for f in self.v.attachments(p, text):
                    dst = adir / f.name
                    if dst.exists() and dst.stat().st_size == f.stat().st_size:
                        continue
                    dst = free_name(dst)
                    if dst.name != f.name:
                        new = new.replace(f.name, dst.name)
                    if self.v.only_mine(p, f):
                        move(f, dst, ops)
                    else:
                        dst.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(f, dst)
                        ops.append(('cp', dst))
                target = free_name(d['path'] / p.name)
                move(p, target, ops)
                if new != text:
                    ops.append(('write', target, text))
                    target.write_text(new)
        except OSError as e:
            undo_ops(ops)
            self.say(f'could not move: {e}')
            return
        if d['vault']:
            self.v.forget(p, text)
        self.v.kept.discard(p.name)
        self.v.stats['moved'] += 1
        d['n'] = d.get('n', 0) + 1
        self.undo.append(('send', p, ops, text, d))
        self.v.save()
        self.say(f'→ {d["name"]}')

    def stay(self, p):
        self.v.stays.add(p.name)
        self.undo.append(('stay', p))
        self.v.save()
        self.say(f'stays in {self.v.path.name}')

    def new_folder(self, p):
        dlg = Gtk.Dialog(title='New folder', transient_for=self, modal=True)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Create and move', Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        e = Gtk.Entry(activates_default=True, margin=12, placeholder_text='folder name')
        dlg.get_content_area().add(e)
        dlg.show_all()
        ok = dlg.run() == Gtk.ResponseType.OK
        name = e.get_text().strip().strip('/.').replace('/', '-')
        dlg.destroy()
        if not ok or not name:
            return False
        f = self.v.path / name
        f.mkdir(exist_ok=True)
        self.find_dests()
        d = next(x for x in self.dests if x['path'] == f)
        self.send(p, d)
        return True

    # ---- notebooks: make, rename, delete ------------------------------------------------------
    def ask_name(self, title, button, text=''):
        dlg = Gtk.Dialog(title=title, transient_for=self, modal=True)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, button, Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        e = Gtk.Entry(activates_default=True, margin=12, text=text, placeholder_text='name')
        dlg.get_content_area().add(e)
        dlg.show_all()
        ok = dlg.run() == Gtk.ResponseType.OK
        name = e.get_text().strip().strip('/.').replace('/', '-')
        dlg.destroy()
        return name if ok and name else None

    def message(self, text, secondary='', buttons=Gtk.ButtonsType.OK):
        m = Gtk.MessageDialog(transient_for=self, modal=True, text=text, secondary_text=secondary,
                              buttons=buttons)
        r = m.run()
        m.destroy()
        return r

    def refresh(self, say):
        self.find_dests()
        self.fill_pick()
        self.say(say)
        self.next_card()
        if self.nb_win:
            self.nb_fill()

    def nb_new(self):
        name = self.ask_name(f'New notebook in {self.v.path.name}', 'Make')
        if not name:
            return
        f = self.v.path / name
        if f.exists():
            self.message(f'There is already a "{name}".')
            return
        f.mkdir()
        self.undo.append(('folder', name, [('mkdir', f)], False))
        self.refresh(f'new notebook: {name}')

    def nb_rename(self, d):
        old = d['path']
        if d['vault'] and obsidian_open():
            self.message('Close Obsidian first', f'"{old.name}" is a vault: Obsidian keeps a list of its '
                         'vaults and writes it while it runs. Close Obsidian, then rename again.\n\n'
                         'Obsidian Sync stays connected; the online copy keeps its old name (rename it in '
                         'Obsidian: Settings → Sync → Manage).')
            return
        name = self.ask_name(f'Rename "{old.name}"', 'Rename', old.name)
        if not name or name == old.name:
            return
        new = old.with_name(name)
        if new.exists():
            self.message(f'There is already a "{name}".')
            return
        ops = []
        try:
            move(old, new, ops)
            if d['vault']:
                set_vault_path(old, new)
                ops.append(('vaultpath', old, new))
        except OSError as e:
            undo_ops(ops)
            self.message('Could not rename', str(e))
            return
        self.undo.append(('folder', f'{old.name} → {name}', ops, d['vault']))
        self.refresh(f'renamed to {name}')

    def nb_delete(self, d):
        if d['vault']:
            return self.vault_delete(d)
        f = d['path']
        notes = [p for p in f.rglob('*.md')]
        dlg = Gtk.Dialog(title=f'Delete "{f.name}"', transient_for=self, modal=True)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Delete notebook', Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_border_width(14)
        box.add(Gtk.Label(xalign=0, label=f'"{f.name}", a folder in {self.v.path.name}, '
                                          f'{len(notes)} note{"s" if len(notes) != 1 else ""}.'))
        back = Gtk.RadioButton(label=f'Its notes go back to {self.v.path.name}, to sweep again')
        gone = Gtk.RadioButton(label='Delete its notes too', group=back)
        if notes:
            box.add(back)
            box.add(gone)
        box.add(Gtk.Label(xalign=0, wrap=True, max_width_chars=60, label=(
            'Obsidian Sync takes this along: the notebook also goes from the online copy and your phone. '
            'Deleted notes go to the vault\'s .trash folder on this laptop, and Undo brings it all back.')))
        dlg.show_all()
        ok = dlg.run() == Gtk.ResponseType.OK
        to_trash = gone.get_active()
        dlg.destroy()
        if not ok:
            return
        trash = self.v.path / '.trash'
        ops = []
        try:
            for p in notes:
                move(p, free_name((trash if to_trash else self.v.path) / p.name), ops)
            move(f, free_name(trash / f.name), ops)          # the rest: pictures, empty folders
        except OSError as e:
            undo_ops(ops)
            self.message('Could not delete', str(e))
            return
        self.undo.append(('folder', f'deleted {f.name}', ops, False))
        self.v = Vault(self.v.path)
        self.refresh(f'deleted {f.name}')

    def vault_delete(self, d):
        f = d['path']
        n = d.get('n', 0)
        dlg = Gtk.Dialog(title=f'Delete vault "{f.name}"', transient_for=self, modal=True)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Delete', Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_border_width(14)
        box.add(Gtk.Label(xalign=0, label=f'"{f.name}" is a vault of its own, {n} notes. Delete it from:'))
        here = Gtk.CheckButton(label='This laptop (to the Trash, you can still get it back from there)',
                               active=True)
        obs = Gtk.CheckButton(label="Obsidian's list of vaults", active=True)
        web = Gtk.CheckButton(label='Online (Obsidian Sync) and so also from your phone', active=True)
        for w in (here, obs, web):
            box.add(w)
        warn = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
        box.add(warn)

        def check(*a):
            need = here.get_active() or obs.get_active()
            busy = need and obsidian_open()
            warn.set_markup('<span foreground="#ff2a4a">Close Obsidian first (it is open), then press '
                            'Delete.</span>' if busy else
                            ('Online: Obsidian has no way for other apps to do this, so after Delete you '
                             'get the 3 clicks to do it in Obsidian.' if web.get_active() else ''))
        for w in (here, obs, web):
            w.connect('toggled', check)
        check()
        dlg.show_all()
        while True:
            r = dlg.run()
            if r != Gtk.ResponseType.OK:
                dlg.destroy()
                return
            check()
            if (here.get_active() or obs.get_active()) and obsidian_open():
                continue
            break
        h, o, w = here.get_active(), obs.get_active(), web.get_active()
        dlg.destroy()
        done = []
        try:
            if o:
                set_vault_path(f, None)
                done.append("off Obsidian's list")
            if h:
                Gio.File.new_for_path(str(f)).trash(None)
                done.append('in the Trash')
        except (OSError, GLib.Error) as e:
            self.message('Could not delete everything', str(e))
        self.refresh(f'{f.name}: ' + ', '.join(done) if done else 'nothing deleted')
        if w:
            r = self.message(f'Now the online copy of "{f.name}"', (
                '1. Open Obsidian (any vault).\n'
                '2. Settings → Sync → next to "Remote vault": Manage.\n'
                f'3. Press the trash icon next to "{f.name}" and confirm.\n\n'
                'On your phone, Obsidian keeps its own copy: there, in the vault switcher, '
                f'Manage vaults → "{f.name}" → Delete.'), Gtk.ButtonsType.OK_CANCEL)
            if r == Gtk.ResponseType.OK:
                subprocess.Popen(['xdg-open', 'obsidian://open'], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)

    def tile_menu(self, d, ev):
