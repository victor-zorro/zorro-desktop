    def message(self, text, secondary='', buttons=Gtk.ButtonsType.OK):
        m = Gtk.MessageDialog(transient_for=self, modal=True, text=text, secondary_text=secondary,
                              buttons=buttons)
        r = m.run()
        m.destroy()
        return r

    def refresh(self, say):
        self.find_dests()
        self.fill_pick()
        self.say(say)
        self.next_card()
        if self.nb_win:
            self.nb_fill()

    def nb_new(self):
        name = self.ask_name(f'New notebook in {self.v.path.name}', 'Make')
        if not name:
            return
        f = self.v.path / name
        if f.exists():
            self.message(f'There is already a "{name}".')
            return
        f.mkdir()
        self.undo.append(('folder', name, [('mkdir', f)], False))
        self.refresh(f'new notebook: {name}')

    def nb_rename(self, d):
        old = d['path']
        if d['vault'] and obsidian_open():
            self.message('Close Obsidian first', f'"{old.name}" is a vault: Obsidian keeps a list of its '
                         'vaults and writes it while it runs. Close Obsidian, then rename again.\n\n'
                         'Obsidian Sync stays connected; the online copy keeps its old name (rename it in '
                         'Obsidian: Settings → Sync → Manage).')
            return
        name = self.ask_name(f'Rename "{old.name}"', 'Rename', old.name)
        if not name or name == old.name:
            return
        new = old.with_name(name)
        if new.exists():
            self.message(f'There is already a "{name}".')
            return
        ops = []
        try:
            move(old, new, ops)
            if d['vault']:
                set_vault_path(old, new)
                ops.append(('vaultpath', old, new))
        except OSError as e:
            undo_ops(ops)
            self.message('Could not rename', str(e))
            return
        self.undo.append(('folder', f'{old.name} → {name}', ops, d['vault']))
        self.refresh(f'renamed to {name}')

    def nb_delete(self, d):
        if d['vault']:
            return self.vault_delete(d)
        f = d['path']
        notes = [p for p in f.rglob('*.md')]
        dlg = Gtk.Dialog(title=f'Delete "{f.name}"', transient_for=self, modal=True)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Delete notebook', Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_border_width(14)
        box.add(Gtk.Label(xalign=0, label=f'"{f.name}", a folder in {self.v.path.name}, '
                                          f'{len(notes)} note{"s" if len(notes) != 1 else ""}.'))
        back = Gtk.RadioButton(label=f'Its notes go back to {self.v.path.name}, to sweep again')
        gone = Gtk.RadioButton(label='Delete its notes too', group=back)
        if notes:
            box.add(back)
            box.add(gone)
        box.add(Gtk.Label(xalign=0, wrap=True, max_width_chars=60, label=(
            'Obsidian Sync takes this along: the notebook also goes from the online copy and your phone. '
            'Deleted notes go to the vault\'s .trash folder on this laptop, and Undo brings it all back.')))
        dlg.show_all()
        ok = dlg.run() == Gtk.ResponseType.OK
        to_trash = gone.get_active()
        dlg.destroy()
        if not ok:
            return
        trash = self.v.path / '.trash'
        ops = []
        try:
            for p in notes:
                move(p, free_name((trash if to_trash else self.v.path) / p.name), ops)
            move(f, free_name(trash / f.name), ops)          # the rest: pictures, empty folders
        except OSError as e:
            undo_ops(ops)
            self.message('Could not delete', str(e))
            return
        self.undo.append(('folder', f'deleted {f.name}', ops, False))
        self.v = Vault(self.v.path)
        self.refresh(f'deleted {f.name}')

    def vault_delete(self, d):
        f = d['path']
        n = d.get('n', 0)
        dlg = Gtk.Dialog(title=f'Delete vault "{f.name}"', transient_for=self, modal=True)
        dlg.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'Delete', Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_border_width(14)
        box.add(Gtk.Label(xalign=0, label=f'"{f.name}" is a vault of its own, {n} notes. Delete it from:'))
        here = Gtk.CheckButton(label='This laptop (to the Trash, you can still get it back from there)',
                               active=True)
        obs = Gtk.CheckButton(label="Obsidian's list of vaults", active=True)
        web = Gtk.CheckButton(label='Online (Obsidian Sync) and so also from your phone', active=True)
        for w in (here, obs, web):
            box.add(w)
        warn = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
        box.add(warn)

        def check(*a):
            need = here.get_active() or obs.get_active()
            busy = need and obsidian_open()
            warn.set_markup('<span foreground="#ff2a4a">Close Obsidian first (it is open), then press '
                            'Delete.</span>' if busy else
                            ('Online: Obsidian has no way for other apps to do this, so after Delete you '
                             'get the 3 clicks to do it in Obsidian.' if web.get_active() else ''))
        for w in (here, obs, web):
            w.connect('toggled', check)
        check()
        dlg.show_all()
        while True:
            r = dlg.run()
            if r != Gtk.ResponseType.OK:
                dlg.destroy()
                return
            check()
            if (here.get_active() or obs.get_active()) and obsidian_open():
                continue
            break
        h, o, w = here.get_active(), obs.get_active(), web.get_active()
        dlg.destroy()
        done = []
        try:
            if o:
                set_vault_path(f, None)
                done.append("off Obsidian's list")
            if h:
                Gio.File.new_for_path(str(f)).trash(None)
                done.append('in the Trash')
        except (OSError, GLib.Error) as e:
            self.message('Could not delete everything', str(e))
        self.refresh(f'{f.name}: ' + ', '.join(done) if done else 'nothing deleted')
        if w:
            r = self.message(f'Now the online copy of "{f.name}"', (
                '1. Open Obsidian (any vault).\n'
                '2. Settings → Sync → next to "Remote vault": Manage.\n'
                f'3. Press the trash icon next to "{f.name}" and confirm.\n\n'
                'On your phone, Obsidian keeps its own copy: there, in the vault switcher, '
                f'Manage vaults → "{f.name}" → Delete.'), Gtk.ButtonsType.OK_CANCEL)
            if r == Gtk.ResponseType.OK:
                subprocess.Popen(['xdg-open', 'obsidian://open'], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)

    def tile_menu(self, d, ev):
        m = Gtk.Menu()
        for label, fn in (('Rename…', self.nb_rename), ('Delete…', self.nb_delete)):
            it = Gtk.MenuItem(label=label)
            it.connect('activate', lambda i, fn=fn: fn(d))
            m.append(it)
        m.show_all()
        m.attach_to_widget(self.area)
        m.popup_at_pointer(ev)

    def notebooks(self):
        """a small window listing the notebooks, to make, rename or delete them"""
        if self.nb_win:
            self.nb_win.present()
            return
        w = Gtk.Window(title='Notebooks', transient_for=self, default_width=520, default_height=420)
        w.connect('destroy', lambda x: setattr(self, 'nb_win', None))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=14)
        sc = Gtk.ScrolledWindow(vexpand=True)
        self.nb_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        sc.add(self.nb_list)
        box.add(sc)
        new = Gtk.Button(label=f'+ New notebook (a folder in {self.v.path.name})')
        new.connect('clicked', lambda b: self.nb_new())
        box.add(new)
        w.add(box)
        self.nb_win = w
        self.nb_fill()
        w.show_all()

    def nb_fill(self):
        for c in self.nb_list.get_children():
            self.nb_list.remove(c)
        for d in self.dests:
            if not d['path']:
                continue
            row = Gtk.Box(spacing=8, margin=6)
            lab = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
            lab.set_markup(f'{GLib.markup_escape_text(d["name"])}\n<small>{d["sub"]} · '
                           f'{d.get("n", 0)} notes</small>')
            row.add(lab)
            for label, fn in (('Rename', self.nb_rename), ('Delete', self.nb_delete)):
                b = Gtk.Button(label=label)
                b.connect('clicked', lambda b, fn=fn, d=d: fn(d))
                row.add(b)
            self.nb_list.add(row)
        self.nb_list.show_all()

    def do_undo(self):
        if not self.undo:
            self.say('nothing to undo')
            return
        u = self.undo.pop()
        if u[0] == 'folder':                # notebook made / renamed / deleted
            if u[3] and obsidian_open():
                self.undo.append(u)
                self.say('close Obsidian first, then undo')
                return
            try:
                undo_ops(u[2])
            except OSError as e:
                self.say(f'could not undo: {e}')
                return
            self.v = Vault(self.v.path)
            self.find_dests()
            self.fill_pick()
            self.say('undone')
            self.next_card()
            return
        p = u[1]
        try:
            if u[0] == 'keep':
                self.v.kept.discard(p.name)
                if p.name in self.v.batch:
                    self.v.batch.remove(p.name)
            elif u[0] == 'stay':
                self.v.stays.discard(p.name)
            else:
                undo_ops(u[2])
                self.v.learn(p, u[3])
                if u[0] == 'send':
                    self.v.kept.add(p.name)
                    self.v.stats['moved'] -= 1
                    u[4]['n'] = u[4].get('n', 1) - 1
                else:
                    self.v.stats['deleted'] -= 1
            if u[0] in ('send', 'stay') and p.name not in self.v.batch:
                self.v.batch.append(p.name)
            self.banner = None
        except OSError as e:
            self.say(f'could not undo: {e}')
            return
        self.v.save()
        self.skipped.discard(p)
        want = 'sort' if u[0] in ('send', 'stay') else 'sweep'
        if want != self.mode:
            (self.b_sort if want == 'sort' else self.b_sweep).set_active(True)
        # bring that note back on top
        if p in self.v.notes:
            self.v.notes.remove(p)
        self.v.notes.insert(0, p)
        self.say('undone')
        self.next_card()
        # the card comes back from where it went
        W, H = self.area.get_allocated_width(), self.area.get_allocated_height()
        fx, fy = {'keep': (-W, 0), 'delete': (W, 0)}.get(u[0], (0, 0))
        if u[0] in ('send', 'stay'):
            i = next((j for j, d in enumerate(self.dests)
                      if (d.get('stay') if u[0] == 'stay' else d is u[4])), None)
            if i is not None:
                tx, ty = self.tile_rects()[i][:2]
                cx, cy = self.card_rect()[:2]
                fx, fy = tx - cx, ty - cy
        if self.card and (fx or fy):
            self.dx, self.dy = fx, fy
            self.fly = (time.monotonic(), fx, 0, 0, None)

    def decide(self, what, dest=None):
        """fly the card off, then act"""
        if not self.card or self.fly:
            return
        p = self.card['path']
        W = self.area.get_allocated_width()
        if what == 'keep':
            self.fly = (time.monotonic(), self.dx, -W, self.dy, lambda: self.keep(p))
        elif what == 'delete':
            self.fly = (time.monotonic(), self.dx, W, self.dy, lambda: self.delete(p))
        elif what == 'skip':
            self.skipped.add(p)
            self.fly = (time.monotonic(), self.dx, self.dx, -self.area.get_allocated_height(), lambda: None)
        elif what == 'dest':
            d = self.dests[dest]
            if d.get('new'):
                if not self.new_folder(p):
                    self.dx = self.dy = 0
                    return
                self.next_card()
                return
            act = (lambda: self.stay(p)) if d.get('stay') else (lambda: self.send(p, d))
            x, y = self.tile_rects()[dest][:2]
            cx, cy = self.card_rect()[:2]
            k = 1 - LIFTED                  # it lands small, its grab point shifted along
            self.fly = (time.monotonic(), self.dx, x - cx - self.grab[0] * k, y - cy - self.grab[1] * k, act)

    # ---- input ---------------------------------------------------------------------------
    def key(self, w, ev):
        k = Gdk.keyval_name(ev.keyval)
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        if ctrl and k in ('z', 'Z'):
            self.do_undo()
        elif k == 'BackSpace':
            self.do_undo()
        elif k == 'Escape':
            self.destroy()
        elif not self.card:
            return False
        elif k in ('o', 'O'):
            self.open_obsidian(self.card['path'])
        elif k in ('space', 'Down'):
            self.decide('skip')
        elif k in ('plus', 'equal', 'KP_Add'):
            self.zoom_by(1.25)
        elif k in ('minus', 'KP_Subtract'):
            self.zoom_by(1 / 1.25)
        elif k in ('0', 'KP_0') and (ctrl or self.mode == 'sweep'):
            self.zoom_by(1 / self.zoom)
        elif k in ('Page_Down',):
            self.scroll += 300
        elif k in ('Page_Up',):
            self.scroll = max(0, self.scroll - 300)
        elif self.mode == 'sweep' and k == 'Left':
            self.decide('keep')
        elif self.mode == 'sweep' and k == 'Right':
            self.decide('delete')
        elif self.mode == 'sort' and k in ('Return', 'KP_Enter') and self.card['best'] is not None:
            self.decide('dest', self.card['best'])
        elif self.mode == 'sort' and len(k) == 1 and k.isdigit() and 0 < int(k) <= len(self.dests):
            self.decide('dest', int(k) - 1)
        else:
            return False
        self.area.queue_draw()
        return True

    def press(self, w, ev):
        self.area.grab_focus()
        r = self.undo_rect
        if ev.button == 1 and r and r[0] <= ev.x <= r[0] + r[2] and r[1] <= ev.y <= r[1] + r[3]:
            if not self.fly:
                self.do_undo()
            return True
        if ev.button == 1 and self.card and not self.fly:
            x, y, cw, ch = self.card_rect()
            if abs(ev.x - x) < cw / 2 and abs(ev.y - y) < ch / 2:
                self.drag = (ev.x - self.dx, ev.y - self.dy)
                self.grab = (ev.x - x - self.dx, ev.y - y - self.dy)
            elif self.mode == 'sort':           # a click on a notebook
                t = self.tile_at(ev.x, ev.y)
                if t is not None:
                    self.decide('dest', t)
        if ev.button == 3 and self.mode == 'sort':      # right-click a notebook: its menu
            t = self.tile_at(ev.x, ev.y)
            if t is not None and self.dests[t]['path']:
                self.tile_menu(self.dests[t], ev)
                return True
        if ev.type == Gdk.EventType._2BUTTON_PRESS and self.card:
            self.open_obsidian(self.card['path'])
        return True

    def motion(self, w, ev):
        r = self.undo_rect
        hot = bool(r and r[0] <= ev.x <= r[0] + r[2] and r[1] <= ev.y <= r[1] + r[3])
        if hot != self.undo_hot:
            self.undo_hot = hot
            self.area.queue_draw()
        if self.drag:
            self.pointer = (ev.x, ev.y)
            self.dx = ev.x - self.drag[0]
            self.dy = (ev.y - self.drag[1]) if self.mode == 'sort' else (ev.y - self.drag[1]) * 0.25
            if self.mode == 'sort':
                self.hover = self.tile_at(ev.x, ev.y)
            self.area.queue_draw()
        return True

    def release(self, w, ev):
        if not self.drag:
            return True
        self.drag = None
        self.let_go()
        return True

    def let_go(self):
        if self.mode == 'sweep':
            if self.dx < -SWIPE:
                return self.decide('keep')
            if self.dx > SWIPE:
                return self.decide('delete')
        elif self.hover is not None:
            return self.decide('dest', self.hover)
        self.fly = (time.monotonic(), self.dx, 0, 0, None)     # spring back

    def zoom_by(self, f):
        z = max(1.0, min(4.0, self.zoom * f))
        if abs(z - self.zoom) > 0.001:
            self.scroll *= z / self.zoom
            self.zoom = z
            self.say(f'zoom {round(z * 100)} %' if z > 1 else 'zoom normal')
            self.area.queue_draw()

    def pinch(self, w, ev):
        """two fingers apart / together on the touchpad: zoom the preview"""
        if ev.type != Gdk.EventType.TOUCHPAD_PINCH or not self.card:
            return False
        if ev.phase == Gdk.TouchpadGesturePhase.BEGIN:
            self.pinch_from = self.zoom
        elif ev.phase == Gdk.TouchpadGesturePhase.UPDATE:
            self.zoom_by(getattr(self, 'pinch_from', self.zoom) * ev.scale / self.zoom)
        return True

    def wheel(self, w, ev):
        ok, dx, dy = ev.get_scroll_deltas()
        if ev.state & Gdk.ModifierType.CONTROL_MASK and self.card:     # Ctrl + scroll: zoom
            if not ok:
                dy = {Gdk.ScrollDirection.UP: -1, Gdk.ScrollDirection.DOWN: 1}.get(ev.direction, 0)
            if dy:
                self.zoom_by(1.12 ** (-dy if not ok else -dy * 0.6))
            return True
        if not ok:                              # a mouse wheel: up / down / left / right
            d = ev.direction
            dx = {Gdk.ScrollDirection.LEFT: -1, Gdk.ScrollDirection.RIGHT: 1}.get(d, 0)
            dy = {Gdk.ScrollDirection.UP: -1, Gdk.ScrollDirection.DOWN: 1}.get(d, 0)
            if dx and self.mode == 'sweep' and self.card:
                self.decide('keep' if dx < 0 else 'delete')
                return True
            self.scroll = max(0, self.scroll + dy * 60)
            self.area.queue_draw()
            return True
        # touchpad: two fingers sideways move the card, up/down scrolls the preview
        if self.mode == 'sweep' and self.card and not self.fly and (abs(dx) > abs(dy) or self.dx):
            self.dx += dx * 14
            self.wheel_at = time.monotonic()
        else:
            self.scroll = max(0, self.scroll + dy * 30)
        self.area.queue_draw()
        return True

    def open_obsidian(self, p):
        url = 'obsidian://open?vault={}&file={}'.format(
            urllib.parse.quote(self.v.path.name), urllib.parse.quote(str(p.relative_to(self.v.path))))
        subprocess.Popen(['xdg-open', url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ---- animation -----------------------------------------------------------------------
    def tick(self):
        now = time.monotonic()
        busy = False
        if self.dx and not self.drag and not self.fly and self.wheel_at and now - self.wheel_at > 0.18:
            self.wheel_at = 0
            self.let_go()
        if self.fly:
            t0, fx, tx, ty, then = self.fly
            k = min(1.0, (now - t0) / (0.22 if then else 0.18))
            e = 1 - (1 - k) ** 3
            self.dx = fx + (tx - fx) * e
            self.dy = self.dy + (ty - self.dy) * e if then else self.dy * (1 - e)
            busy = True
            if k >= 1:
                self.fly = None
                if then:
                    then()
                    self.next_card()
                else:
                    self.dx = self.dy = 0
        if self.banner and now - self.banner[2] > 2.6:
            self.banner = None
            self.area.queue_draw()
        up = self.mode == 'sort' and (self.drag or (self.fly and self.fly[4]))
        target = 1.0 if up else 0.0
        if abs(self.lift - target) > 0.002:     # picking up / putting down: shrink or grow
            self.lift += (target - self.lift) * 0.22
            busy = True
        else:
            self.lift = target
        if busy or self.drag or self.banner or now - self.enter_at < 0.3 or now - self.toast_at < 2.2:
            self.area.queue_draw()
        return True

    # ---- layout --------------------------------------------------------------------------
    def card_rect(self, base=False):
        W, H = self.area.get_allocated_width(), self.area.get_allocated_height()
        if self.mode == 'sort':
            cw = min(560, W - 2 * 250)
        else:
            cw = min(700, W - 80)
        if not base and self.zoom > 1:      # zoomed in: wider, up to the whole window
            cw = min(W - 40, cw * min(self.zoom, 2.4))
        ch = H - 180                       # room for the score above, undo + keys below
        return W / 2, 62 + ch / 2, max(cw, 300), max(ch, 300)

    def tile_layout(self):
        """Sort: the notebooks scattered left and right of the card, each its own form, bigger
        when it holds more notes: [x, y, r, shape, tilt, (rx, ry)], kept while nothing changes"""
        W, H = self.area.get_allocated_width(), self.area.get_allocated_height()
        cx, cy, cw, ch = self.card_rect(base=True)
        key = (W, H, cw, tuple((d['name'], d.get('n')) for d in self.dests))
        if getattr(self, '_layout', None) and self._layout[0] == key:
            return self._layout[1]
        bands = ((20, cx - cw / 2 - 24), (cx + cw / 2 + 24, W - 20))
        top, bot = 64, H - 56
        rows = max(1, math.ceil(len(self.dests) / 2))
        tiles = []
        for i, d in enumerate(self.dests):
            rnd = random.Random(zlib.crc32(d['name'].encode()))
            n = d.get('n')
            if d['path']:
                r = min(88, 50 + 15 * math.log10((n or 0) + 1))
                shape = SHAPES[i % len(SHAPES)]
            else:                               # "stays" and "+ new": small dashed rings
                r, shape = 46, 'ring'
            rx, ry = (r * 1.45, r * 0.8) if shape == 'pill' else (r, r)
            b = bands[i % 2]
            x = rnd.uniform(b[0] + rx, max(b[0] + rx, b[1] - rx))
            y = top + (bot - top) * ((i // 2 + rnd.uniform(0.2, 0.8)) / rows)
            tiles.append([x, y, r, shape, rnd.uniform(-0.3, 0.3), (rx, ry), b])
        for _ in range(240):                    # push apart until nothing overlaps
            calm = True
            for i, a in enumerate(tiles):
                for c in tiles[i + 1:]:
                    dx, dy = c[0] - a[0], c[1] - a[1]
                    dist = math.hypot(dx, dy) or 0.01
                    need = max(a[5]) * 1.08 + max(c[5]) * 1.08 + 16
                    if dist < need:
                        calm = False
                        push = (need - dist) / 2
                        a[0] -= dx / dist * push
                        a[1] -= dy / dist * push
                        c[0] += dx / dist * push
                        c[1] += dy / dist * push
            for t in tiles:                     # stay in its band, on the screen
                (rx, ry), b = t[5], t[6]
                t[0] = min(max(t[0], b[0] + rx), max(b[0] + rx, b[1] - rx))
                t[1] = min(max(t[1], top + ry), max(top + ry, bot - ry))
            if calm:
                break
        self._layout = (key, tiles)
        return tiles

    def tile_rects(self):
        """(centre x, centre y, w, h) of every notebook"""
        return [(t[0], t[1], 2 * t[5][0], 2 * t[5][1]) for t in self.tile_layout()]

    def shape_path(self, cr, t, grow=1.0):
        """the outline of a notebook's form around its centre"""
        x, y, r, shape, tilt = t[:5]
        r *= grow
        cr.save()
        cr.translate(x, y)
        cr.rotate(tilt if shape not in ('circle', 'ring') else 0)
        cr.new_path()
        if shape in ('circle', 'ring'):
            cr.arc(0, 0, r, 0, 2 * math.pi)
        elif shape == 'pill':
            w, h = r * 1.45, r * 0.8
            cr.arc(-w + h, 0, h, math.pi / 2, 3 * math.pi / 2)
            cr.arc(w - h, 0, h, -math.pi / 2, math.pi / 2)
            cr.close_path()
        else:
            k = {'hex': 6, 'oct': 8}.get(shape)
            for j in range(96 if not k else k):
                a = 2 * math.pi * j / (96 if not k else k)
                if k:
                    rr = r * (1.06 if k == 6 else 1.03)
                    a += math.pi / k
                elif shape == 'blob':
                    rr = r * (1 + 0.07 * math.sin(3 * a + tilt * 9) + 0.04 * math.sin(5 * a))
                else:                           # squircle / diamond: superellipses
                    e = 4.0 if shape == 'squircle' else 1.5
                    c, s_ = math.cos(a), math.sin(a)
                    rr = r * (0.97 if e == 4 else 1.2) / ((abs(c) ** e + abs(s_) ** e) ** (1 / e))
                px, py = rr * math.cos(a), rr * math.sin(a)
                (cr.line_to if j else cr.move_to)(px, py)
            cr.close_path()
        cr.restore()

    def tile_at(self, x, y):
        if not hasattr(self, '_hit'):
            self._hit = cairo.Context(cairo.ImageSurface(cairo.FORMAT_A8, 1, 1))
        for i, t in enumerate(self.tile_layout()):
            self.shape_path(self._hit, t, 1.05)
            if self._hit.in_fill(x, y):
                return i
        return None

    # ---- drawing -------------------------------------------------------------------------
    def draw_bg(self, w, cr):
        cr.set_source_rgb(*BG)
        cr.paint()

    def text(self, cr, s, x, y, size=10, rgb=FG, a=1.0, bold=False, mono=True, align=None, width=None):
        # layouts are kept between frames: the screen redraws 60 times a second while moving
        cache = self.__dict__.setdefault('_layouts', {})
        key = (s, size, bold, mono, int(width or 0))
        hit = cache.get(key)
        if hit:
            lay, tw, th = hit
            PangoCairo.update_layout(cr, lay)
        else:
            lay = text_layout(cr)
            fd = Pango.FontDescription(f'{"DejaVu Sans Mono" if mono else "DejaVu Sans"} {size}')
            if bold:
                fd.set_weight(Pango.Weight.BOLD)
            lay.set_font_description(fd)
            if width:
                lay.set_width(int(width * Pango.SCALE))
                lay.set_ellipsize(Pango.EllipsizeMode.END)
            lay.set_text(s, -1)
            tw, th = lay.get_pixel_size()
            if len(cache) > 400:
                cache.clear()
            cache[key] = (lay, tw, th)
        if align == 'center':
            x -= tw / 2
        elif align == 'right':
            x -= tw
        cr.set_source_rgba(*rgb, a)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, lay)
        return tw, th

    def frame(self, cr, x, y, w, h, line=(1, 1, 1), a=0.16, fill=0.62):
        cr.rectangle(x, y, w, h)
        cr.set_source_rgba(0, 0, 0, fill)
        cr.fill_preserve()
        cr.set_source_rgba(*line, a)
        cr.set_line_width(1)
        cr.stroke()
        cr.set_source_rgba(*FG, 0.7)             # corner ticks, like the lock screen
        for px, py, sx, sy in ((x, y, 1, 1), (x + w, y + h, -1, -1)):
            cr.move_to(px + 10 * sx, py)
            cr.line_to(px, py)
            cr.line_to(px, py + 10 * sy)
            cr.stroke()

    def draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        now = time.monotonic()
        if self.mode == 'sort':
            self.draw_tiles(cr)
        if not self.card:
            msg = ('Every note is seen. Kept notes are waiting under Sort.' if self.mode == 'sweep'
                   else 'Nothing to sort. Keep notes first under Keep or delete.')
            self.text(cr, msg, W / 2, H / 2 - 10, 12, DIM, align='center')
        else:
            self.draw_card(cr, now)
        if self.card and self.drag and self.hover is not None and self.mode == 'sort':
            d = self.dests[self.hover]          # held over a notebook: say which, above the card
            ch = self.card_rect()[3] * (1 - (1 - LIFTED) * (self.lift * (2 - self.lift)))
            y = self.pointer[1] - self.grab[1] * LIFTED - ch / 2 - 26
            label = ('→ ' + d['name']) if not d.get('new') else d['name']
            for off, rgb, a in ((-1.5, RED, 0.6), (1.5, CYAN, 0.6), (0, FG, 1)):
                self.text(cr, label, self.pointer[0] + off, y, 11, rgb, a, bold=True, align='center')
        # bottom line: what the keys do
        hint = ('← keep   → delete   space skip   + − zoom   O open in Obsidian   Ctrl+Z undo' if self.mode == 'sweep'
                else 'drag onto a notebook   1-9 or Enter (best match)   space skip   + − zoom   Ctrl+Z undo')
        self.text(cr, hint, W / 2, H - 30, 9, DIM, align='center')
        self.draw_score(cr, W)
        self.draw_undo(cr, W, H)
        if now - self.toast_at < 2.2 and self.toast and not self.banner:
            a = min(1, (2.2 - (now - self.toast_at)) / 0.5)
            self.text(cr, self.toast, W / 2, 30, 9, FG, a, align='center')
        if self.banner:
            self.draw_banner(cr, W, H, now)
        return False

    def score_counts(self):
        """the numbers of the score bar; counted once per card, not on every frame (each count
        looks at every note on disk)"""
        if getattr(self, '_counts', None) is None:
            v = self.v
            left = len(v.to_scan())
            live = {p.name for p in v.path.glob('*.md')}
            todo = {p.name for p in self.queue()} | {p.name for p in self.skipped} \
                if self.mode == 'sort' else set()
            self._counts = {'left': left, 'todo': len(todo),
                            'total': left + v.stats['deleted'] + v.stats['moved']
                            + len((v.kept | v.stays) & live)}
        return self._counts

    def draw_score(self, cr, W):
        """round, the pips of this round, how much of the vault is scanned"""
        v = self.v
        sort = self.mode == 'sort'
        self.text(cr, f'ROUND {self.round()}', 24, 8, 12, FG, bold=True)
        self.text(cr, 'SORT' if sort else 'KEEP OR DELETE', 24, 28, 8, CYAN if sort else DIM)
        # pips: sweep = kept so far this round; sort = sorted of this round
        c = self.score_counts()
        if sort:
            n = max(len(v.batch), 1) if v.batch else c['todo']
            done = n - c['todo'] if v.batch else 0
        else:
            n, done = ROUND, min(len(v.batch), ROUND)
        n = max(n, 1)
        gap = 22 if n <= 20 else max(6, 440 / n)
        x0 = W / 2 - gap * (n - 1) / 2
        for i in range(n):
            cr.new_sub_path()
            cr.arc(x0 + i * gap, 22, 6 if gap >= 16 else 2.5, 0, 2 * math.pi)
            if i < done:
                cr.set_source_rgba(*(GREEN if sort else CYAN), 0.95)
                cr.fill()
            else:
                cr.set_source_rgba(*FG, 0.35)
                cr.set_line_width(1)
                cr.stroke()
        # the whole vault: scanned / total
        left, total = c['left'], c['total']
        frac = 1 - left / total if total else 1
        self.text(cr, f'{left} to scan', W - 24, 8, 12, FG, bold=True, align='right')
        self.text(cr, f'{frac * 100:.0f}% of {total} scanned', W - 24, 28, 8, DIM, align='right')
        cr.rectangle(24, 46, W - 48, 2)
        cr.set_source_rgba(*FG, 0.12)
        cr.fill()
        cr.rectangle(24, 46, (W - 48) * frac, 2)
        cr.set_source_rgba(*CYAN, 0.9)
        cr.fill()

    def draw_undo(self, cr, W, H):
        """the undo button under the card, saying what it takes back"""
        if not self.undo:
            self.undo_rect = None
            return
        u = self.undo[-1]
        if u[0] == 'folder':
            what, name = 'notebook', u[1]
        else:
            what = {'keep': 'kept', 'delete': 'deleted', 'stay': 'stays'}.get(u[0]) or '→ ' + u[4]['name']
            name = u[1].stem
        name = name if len(name) <= 34 else name[:33] + '…'
        label = f'undo   {what} · {name}'
        lay = text_layout(cr)
        lay.set_font_description(Pango.FontDescription('DejaVu Sans Mono 9'))
        lay.set_text(label, -1)
        tw = lay.get_pixel_size()[0]
        w, h = tw + 54, 30
        x, y = W / 2 - w / 2, H - 82
        self.undo_rect = (x, y, w, h)
        hot = self.undo_hot
        self.frame(cr, x, y, w, h, CYAN if hot else (1, 1, 1), 0.7 if hot else 0.2, 0.6)
        # a turning-back arrow
        ax, ay = x + 20, y + h / 2
        cr.set_line_width(1.6)
        cr.set_source_rgba(*(CYAN if hot else FG), 0.95)
        cr.arc_negative(ax, ay, 6, math.pi * 1.75, math.pi * 0.75)
        cr.stroke()
        tx, ty = ax + 6 * math.cos(math.pi * 1.75), ay + 6 * math.sin(math.pi * 1.75)
        cr.move_to(tx - 4, ty - 1)
        cr.line_to(tx, ty)
        cr.line_to(tx + 1, ty - 4)
        cr.stroke()
        cr.set_source_rgba(*(FG if hot else DIM), 1)
        cr.move_to(x + 36, y + (h - lay.get_pixel_size()[1]) / 2)
        PangoCairo.show_layout(cr, lay)

    def draw_banner(self, cr, W, H, now):
        t = now - self.banner[2]
        a = min(1, t / 0.15, (2.6 - t) / 0.4)
        cr.rectangle(0, 0, W, H)
        cr.set_source_rgba(*BG, 0.75 * a)
        cr.fill()
        title, sub = self.banner[:2]
        j = 6 if t < 0.35 or int(t * 9) % 7 == 0 else 0     # a glitch now and then
        import random
        for dx, rgb, aa in ((-3 - random.random() * j, RED, 0.6), (3 + random.random() * j, CYAN, 0.6),
                            (0, FG, 1)):
            self.text(cr, title, W / 2 + dx, H / 2 - 50, 34, rgb, a * aa, bold=True, align='center')
        self.text(cr, sub, W / 2, H / 2 + 6, 11, DIM, a, align='center')

    def draw_card(self, cr, now):
        c = self.card
        cx, cy, cw, ch = self.card_rect()
        grow = min(1, (now - self.enter_at) / 0.25)
        scale = 0.94 + 0.06 * (1 - (1 - grow) ** 3)
        small = 1 - (1 - LIFTED) * (self.lift * (2 - self.lift))   # eased
        scale *= small
        p = max(-1, min(1, self.dx / SWIPE)) if self.mode == 'sweep' else 0
        cr.save()
        # shrink around the point where it is held, so it stays under the finger / pointer
        cr.translate(cx + self.dx + self.grab[0] * (1 - small), cy + self.dy + self.grab[1] * (1 - small))
        cr.rotate(self.dx * 0.00045 if self.mode == 'sweep' else 0)
        cr.scale(scale, scale)
        cr.push_group()
        x, y = -cw / 2, -ch / 2
        edge = RED if p > 0 else CYAN
        self.frame(cr, x, y, cw, ch, edge if abs(p) > 0.05 else (1, 1, 1), 0.16 + 0.6 * abs(p), 0.72)
        cr.set_source_surface(self.contents(cw, ch), x, y)
        cr.paint()
        # the stamp while swiping
        if abs(p) > 0.15:
            word, col = ('DELETE', RED) if p > 0 else ('KEEP', CYAN)
            cr.save()
            cr.translate(x + (cw - 150 if p > 0 else 150), y + 120)
            cr.rotate(-0.25 if p > 0 else 0.25)
            a = min(1, (abs(p) - 0.15) / 0.6)
            for off, rgb in ((-2, RED), (2, CYAN), (0, col)):   # the glitch split
                self.text(cr, word, off, -14, 26, rgb, a * (0.5 if off else 1), bold=True, align='center')
            cr.restore()
        cr.pop_group_to_source()
        fade = 1.0
        if self.fly and self.fly[4]:
            fade = max(0, 1 - (now - self.fly[0]) / 0.22)
        cr.paint_with_alpha(fade * (0.4 + 0.6 * grow))
        cr.restore()

    def contents(self, cw, ch):
        """the note drawn flat into a picture once (cheap to redraw, and clipping text in a
        tilted card goes wrong on some X servers)"""
        c = self.card
        key = (id(c), int(self.scroll), cw, ch, self.zoom)
        if c.get('surf_key') == key:
            return c['surf']
        s = cairo.ImageSurface(cairo.FORMAT_ARGB32, int(cw), int(ch))
        cr = cairo.Context(s)
        pad = 26
        self.text(cr, c['title'], pad, 20, 15, FG, width=cw - 2 * pad)
        self.text(cr, c['sub'], pad, 50, 9, DIM, width=cw - 2 * pad)
        top = 80
        cr.rectangle(1, top, cw - 2, ch - top - 1)
        cr.clip()
        lay = text_layout(cr)
        size = 10.5 if c['words'] > 60 or c['pix'] else (14 if c['words'] > 15 else 17)
        lay.set_font_description(Pango.FontDescription(f'DejaVu Sans {size * self.zoom:.1f}'))
        lay.set_width(int((cw - 2 * pad) * Pango.SCALE))
        lay.set_wrap(Pango.WrapMode.WORD_CHAR)
        try:
            lay.set_markup(c['markup'], -1)
        except GLib.Error:
            lay.set_text(re.sub(r'<[^>]+>', '', c['markup']), -1)
        lh = lay.get_pixel_size()[1] if c['markup'].strip() else 0
        # pictures: as big as the card allows; with little text they share the free room
        room = ch - top - 24
        free = max(room * 0.45, room - lh - 20) / max(1, len(c['pix'])) - 12
        sizes = []
        for p in c['pix']:
            pw, ph_ = p.get_width(), p.get_height()
            k = min((cw - 2 * pad) / pw, max(free, 160) / ph_, 4.0) * self.zoom
            k = min(k, (cw - 2 * pad) / pw)             # never wider than the card
            sizes.append((pw * k, ph_ * k, k))
        ph = sum(h + 12 for _, h, _ in sizes)
        most = max(0, ph + lh + 30 - (ch - top))        # scrolled no further than the end
        if self.scroll > most:
            self.scroll = most
        oy = top - int(self.scroll)
        for p, (w, h, k) in zip(c['pix'], sizes):
            x = pad + (cw - 2 * pad - w) / 2
            if p.get_has_alpha():                       # a logo on see-through: light backing
                cr.rectangle(x, oy, w, h)
                cr.set_source_rgba(1, 1, 1, 0.85)
                cr.fill()
            cr.save()
            cr.translate(x, oy)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, p, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_GOOD)
            cr.paint_with_alpha(0.92)
            cr.restore()
            oy += h + 12
        cr.set_source_rgba(*FG, 0.92)
        cr.move_to(pad, oy)
        PangoCairo.show_layout(cr, lay)
        if ph + lh - self.scroll > ch - top:            # more below: fade the bottom out
            cr.reset_clip()
            cr.set_operator(cairo.OPERATOR_DEST_OUT)
            g = cairo.LinearGradient(0, ch - 60, 0, ch - 1)
            g.add_color_stop_rgba(0, 0, 0, 0, 0)
            g.add_color_stop_rgba(1, 0, 0, 0, 1)
            cr.rectangle(0, ch - 60, cw, 60)
            cr.set_source(g)
            cr.fill()
        c['surf'], c['surf_key'] = s, key
        return s

    def draw_tiles(self, cr):
        best = self.card['best'] if self.card else None
        scores = self.card['scores'] if self.card else {}
        for i, t in enumerate(self.tile_layout()):
            d = self.dests[i]
            x, y, r = t[0], t[1], t[2]
            hot = i == self.hover
            grow = 1.08 if hot else 1.0
            line = CYAN if (i == best or hot) else (1, 1, 1)
            if hot or i == best:                # a soft glow around the hot one
                self.shape_path(cr, t, grow * 1.06)
                cr.set_source_rgba(*CYAN, 0.10 if hot else 0.05)
                cr.set_line_width(8)
                cr.stroke()
            self.shape_path(cr, t, grow)
            cr.set_source_rgba(*(CYAN if hot else (0, 0, 0)), 0.14 if hot else 0.6)
            cr.fill_preserve()
            cr.set_source_rgba(*line, 0.85 if hot else (0.6 if i == best else 0.22))
            cr.set_line_width(1.2)
            if t[3] == 'ring':
                cr.set_dash([5, 5])
            cr.stroke()
            cr.set_dash([])
            # the words, upright whatever the tilt
            w = t[5][0] * (1.45 if t[3] != 'pill' else 1.5)
            lay = text_layout(cr)
            fd = Pango.FontDescription('DejaVu Sans Mono 10')
            fd.set_weight(Pango.Weight.BOLD)
            lay.set_font_description(fd)
            lay.set_text(max(d['name'].split() or [''], key=len), -1)
            long = lay.get_pixel_size()[0]
            if long > w:                        # a long word: smaller, rather than cut in two
                fd.set_size(int(max(7.5, 10 * w / long) * Pango.SCALE))
                lay.set_font_description(fd)
            lay.set_width(int(w * Pango.SCALE))
            lay.set_wrap(Pango.WrapMode.WORD)
            lay.set_height(-2)
            lay.set_ellipsize(Pango.EllipsizeMode.END)
            lay.set_alignment(Pango.Alignment.CENTER)
            lay.set_text(d['name'], -1)
            nh = lay.get_pixel_size()[1]
            ty = y - nh / 2 - 4
            self.text(cr, f'{i + 1}', x, ty - 18, 8, CYAN if hot else DIM, align='center')
            cr.set_source_rgba(*FG, 1)
            cr.move_to(x - w / 2, ty)
            PangoCairo.show_layout(cr, lay)
            sub = d['sub'] if not d.get('n') else f'{d["n"]} notes'
            if d.get('vault'):
                sub = 'vault · ' + sub
            self.text(cr, 'best match' if i == best else sub, x, ty + nh + 3, 8,
                      CYAN if i == best else DIM, align='center', width=w)
            s = scores.get(i)
            if s is not None:                   # how close in meaning: a thin bar
                k = max(0.0, min(1.0, (s - 0.70) / 0.2))
                bw = min(w, r * 1.1)
                cr.rectangle(x - bw / 2, ty + nh + 20, bw, 2)
                cr.set_source_rgba(1, 1, 1, 0.08)
                cr.fill()
                cr.rectangle(x - bw / 2, ty + nh + 20, bw * k, 2)
                cr.set_source_rgba(*(CYAN if i == best else DIM), 0.9)
                cr.fill()

def pick_vault(arg):
    if arg:
        return Path(arg).expanduser().resolve()
    vs = vaults()
    for v in vs:
        if v.name == 'Notes':
            return v
    if vs:
        return max(vs, key=lambda v: sum(1 for _ in v.glob('*.md')))
    sys.exit('no Obsidian vault found')


def main():
    args = sys.argv[1:]
    if args and args[0] in ('-h', '--help'):
        print(__doc__.strip())
        return
    vault = pick_vault(args[1] if args[:1] == ['--vault'] and len(args) > 1 else None)
    if not vault.is_dir():
        sys.exit(f'no such vault: {vault}')
    Sweep(vault)
    Gtk.main()


if __name__ == '__main__':
    main()
