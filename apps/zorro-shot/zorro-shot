#!/usr/bin/python3
"""zorro-shot: screenshot overlay for the Openbox desktop.

  zorro-shot            freeze the screen, then pick: drag = region, click = window,
                        Space = whole screen; then Enter / double-click saves, Ctrl+C copies,
                        Esc cancels.
  zorro-shot --region   same, starts in region mode (Fn+PrtSc)
  zorro-shot --window   the active window right away, no overlay (Alt+PrtSc)
  zorro-shot --full     the whole screen right away

Saved to ~/Pictures/Screenshots/YYYY-MM-DD_HH-MM-SS.png and copied to the clipboard.
"""
import argparse
import os
import re
import select
import subprocess
import sys
import tempfile
import time
from pathlib import Path

OUT_DIR = Path.home() / 'Pictures' / 'Screenshots'
SELF = os.path.realpath(__file__)


# ---- X helpers (xprop / xwininfo, no extra Python modules) -------------------------

def xprop(args):
    p = subprocess.run(['xprop', *args], capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else ''


def ints(text):
    return [int(x, 0) for x in re.findall(r'0x[0-9a-fA-F]+|-?\d+', text)]


def window_rect(wid):
    """(x, y, w, h) of a client window including its Openbox frame, or None"""
    info = subprocess.run(['xwininfo', '-id', str(wid)], capture_output=True, text=True).stdout
    if 'IsViewable' not in info:
        return None
    g = {k: int(v) for k, v in re.findall(
        r'(Absolute upper-left X|Absolute upper-left Y|Width|Height):\s+(-?\d+)', info)}
    if len(g) < 4:
        return None
    ext = ints(xprop(['-id', str(wid), '_NET_FRAME_EXTENTS']).partition('=')[2]) or [0, 0, 0, 0]
    left, right, top, bottom = (ext + [0, 0, 0, 0])[:4]
    return (g['Absolute upper-left X'] - left, g['Absolute upper-left Y'] - top,
            g['Width'] + left + right, g['Height'] + top + bottom)


def visible_windows():
    """window rects on the current desktop, topmost first"""
    stack = ints(xprop(['-root', '_NET_CLIENT_LIST_STACKING']).partition('#')[2])
    cur = ints(xprop(['-root', '_NET_CURRENT_DESKTOP']).partition('=')[2])
    cur = cur[0] if cur else 0
    out = []
    for wid in reversed(stack):
        p = xprop(['-id', str(wid), '_NET_WM_DESKTOP', '_NET_WM_STATE', '_NET_WM_WINDOW_TYPE'])
        desk = re.search(r'_NET_WM_DESKTOP\(CARDINAL\) = (\d+)', p)
        if desk and int(desk.group(1)) not in (cur, 0xFFFFFFFF):
            continue
        if '_NET_WM_STATE_HIDDEN' in p or '_NET_WM_WINDOW_TYPE_DESKTOP' in p:
            continue
        r = window_rect(wid)
        if r and r[2] > 1 and r[3] > 1:
            out.append(r)
    return out


def active_window_rect():
    a = ints(xprop(['-root', '_NET_ACTIVE_WINDOW']).partition('#')[2])
    return window_rect(a[0]) if a and a[0] else None


# ---- saving -------------------------------------------------------------------------

def grab_screen():
    fd, path = tempfile.mkstemp(prefix='zorro-shot-', suffix='.png',
                                dir=os.environ.get('XDG_RUNTIME_DIR'))
    os.close(fd)
    if subprocess.run(['maim', '-u', path]).returncode:   # -u: without the mouse pointer
        sys.exit('zorro-shot: maim failed')
    return path


def to_clipboard(path, temp=False):
    """the clipboard gets the picture AND the file: chat apps and web pages take the picture,
    file managers and upload fields the file. A small process in the background serves it
    until something else is copied (then a temp file is removed)."""
    p = subprocess.Popen([sys.executable, SELF, '--serve', path] + (['--temp'] if temp else []),
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    if p.stdout.readline().strip() != 'ready':      # no python3-xlib: the picture only
        subprocess.run(['xclip', '-selection', 'clipboard', '-t', 'image/png', '-i', path],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    p.stdout.close()


def serve_clipboard(path, temp=False):
    """own the X clipboard and hand out image/png, text/uri-list and
    x-special/gnome-copied-files; big answers go in pieces (INCR)"""
    from urllib.parse import quote
    from Xlib import X, Xatom, display
    from Xlib.protocol import event
    try:
        d = display.Display()
        png = Path(path).read_bytes()
    except Exception:                                    # noqa: BLE001
        return
    uri = 'file://' + quote(str(Path(path).resolve()))
    atom = lambda n: d.intern_atom(n)                    # noqa: E731
    CLIP, TARGETS, TIMESTAMP, INCR = atom('CLIPBOARD'), atom('TARGETS'), atom('TIMESTAMP'), atom('INCR')
    data = {atom('image/png'): png,
            atom('text/uri-list'): (uri + '\r\n').encode(),
            atom('x-special/gnome-copied-files'): ('copy\n' + uri).encode()}
    win = d.screen().root.create_window(0, 0, 1, 1, 0, X.CopyFromParent,
                                        event_mask=X.PropertyChangeMask)
    win.change_property(Xatom.WM_NAME, Xatom.STRING, 8, b'zorro-shot clipboard')
    while True:                                          # a real timestamp for the selection
        e = d.next_event()
        if e.type == X.PropertyNotify:
            stamp = e.time
            break
    win.set_selection_owner(CLIP, stamp)
    d.flush()
    if d.get_selection_owner(CLIP) != win:
        return
    print('ready', flush=True)
    sys.stdout.close()
    # errors about a requestor that is gone arrive later, as events: not worth a message
    d.set_error_handler(lambda *_a: None)
    chunk = 65536
    pending = {}            # (requestor id, property): [type, bytes, offset, started]
    try:
        while True:
            if pending and not d.pending_events():
                # a requestor that stops taking pieces is given up after 30 s
                select.select([d.fileno()], [], [], 5)
                old = time.monotonic() - 30
                for k in [k for k, v in pending.items() if v[3] < old]:
                    del pending[k]
                if not d.pending_events():
                    continue
            e = d.next_event()
            if e.type == X.SelectionClear:
                break
            if e.type == X.DestroyNotify:                # a requestor closed mid-transfer
                for k in [k for k in pending if k[0] == e.window.id]:
                    del pending[k]
                continue
            if e.type == X.PropertyNotify and e.state == X.PropertyDelete:
                k = (e.window.id, e.atom)
                if k in pending:                         # the requestor took a piece: the next
                    typ, blob, off, _t = pending[k]
                    piece = blob[off:off + chunk]
                    e.window.change_property(e.atom, typ, 8, piece)
                    if piece:
                        pending[k] = [typ, blob, off + chunk, time.monotonic()]
                    else:
                        del pending[k]
                    d.flush()
                continue
            if e.type != X.SelectionRequest:
                continue
            prop = e.property or e.target
            ok = True
            try:
                if e.target == TARGETS:
                    e.requestor.change_property(prop, Xatom.ATOM, 32, [TARGETS, TIMESTAMP, *data])
                elif e.target == TIMESTAMP:
                    e.requestor.change_property(prop, Xatom.INTEGER, 32, [stamp])
                elif e.target in data:
                    blob = data[e.target]
                    if len(blob) > chunk * 3:
                        e.requestor.change_attributes(
                            event_mask=X.PropertyChangeMask | X.StructureNotifyMask)
                        e.requestor.change_property(prop, INCR, 32, [len(blob)])
                        pending[(e.requestor.id, prop)] = [e.target, blob, 0, time.monotonic()]
                    else:
                        e.requestor.change_property(prop, e.target, 8, blob)
                else:
                    ok = False
            except Exception:                            # noqa: BLE001
                ok = False
            e.requestor.send_event(event.SelectionNotify(
                time=e.time, requestor=e.requestor, selection=e.selection, target=e.target,
                property=prop if ok else X.NONE), event_mask=0)
            d.flush()
    except Exception:                                    # noqa: BLE001 - the X server went away
        pass
    finally:
        if temp:
            try:
                os.unlink(path)
            except OSError:
                pass


def finish(pixbuf, rect, save=True):
    x, y, w, h = clamp(rect, pixbuf.get_width(), pixbuf.get_height())
    sub = pixbuf.new_subpixbuf(x, y, w, h)
    if save:
        OUT_DIR.mkdir(parents=True, exist_ok=True)
        path = OUT_DIR / f"{time.strftime('%Y-%m-%d_%H-%M-%S')}.png"
        n = 1
        while path.exists():
            n += 1
            path = OUT_DIR / f"{time.strftime('%Y-%m-%d_%H-%M-%S')}-{n}.png"
        sub.savev(str(path), 'png', [], [])
        to_clipboard(str(path))
    else:
        tmpdir = Path(os.environ.get('XDG_RUNTIME_DIR') or tempfile.gettempdir()) / 'zorro-shot'
        tmpdir.mkdir(mode=0o700, exist_ok=True)
        tmp = tmpdir / f"Screenshot {time.strftime('%Y-%m-%d %H-%M-%S')}.png"
        sub.savev(str(tmp), 'png', [], [])
        to_clipboard(str(tmp), temp=True)               # removed when something else is copied
        path = None
    # the notification waits for a click, so it runs in its own process
    subprocess.Popen([sys.executable, SELF, '--notify', str(path or ''), f'{w}x{h}'],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def clamp(rect, maxw, maxh):
    x, y, w, h = (int(round(v)) for v in rect)
    if w < 0:
        x, w = x + w, -w
    if h < 0:
        y, h = y + h, -h
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(maxw, x + w), min(maxh, y + h)
    return x0, y0, max(1, x1 - x0), max(1, y1 - y0)


def cmd_notify(path, size):
    if not path:
        subprocess.run(['notify-send', '-a', 'Screenshot', '-i', 'edit-copy',
                        'Screenshot copied', f'{size} on the clipboard'])
        return
    p = subprocess.run(['notify-send', '-a', 'Screenshot', '-i', path,
                        '-A', 'open=Open', '-A', 'folder=Show in folder',
                        'Screenshot saved', f'{os.path.basename(path)}  ({size})\nAlso on the clipboard'],
                       capture_output=True, text=True)
    act = p.stdout.strip()
    if act == 'open':
        subprocess.Popen(['xdg-open', path])
    elif act == 'folder':
        # any file manager (Nemo, Thunar, ...): open the folder with the file selected
        from urllib.parse import quote
        shown = subprocess.run(['dbus-send', '--session', '--print-reply',
                                '--dest=org.freedesktop.FileManager1', '/org/freedesktop/FileManager1',
                                'org.freedesktop.FileManager1.ShowItems',
                                f'array:string:file://{quote(path)}', 'string:'],
                               capture_output=True, timeout=10).returncode == 0
        if not shown:
            subprocess.Popen(['xdg-open', os.path.dirname(path)])


