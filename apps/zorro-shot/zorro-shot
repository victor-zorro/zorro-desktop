# ---- overlay background: the shared lock-screen look (apps/zorro-fx) -----------------------

# the one palette (apps/zorro-fx/zorro_style.py); plain values if it is missing
sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / 'zorro-fx'))
try:
    from zorro_style import CYAN, FG, FONT
except ImportError:
    CYAN, FG, FONT = (0.098, 0.902, 1.0), (0.847, 0.847, 0.871), 'DejaVu Sans Mono'


def load_snow():
    """the particle look, imported only for the overlay (it pulls in numpy: ~90 ms, and the
    clipboard / notification processes don't need it)"""
    sys.path.insert(0, str(Path(os.path.realpath(__file__)).parent.parent / 'zorro-fx'))
    try:
        import zorro_fx
        return zorro_fx.Snow
    except ImportError:                 # zorro-fx missing: a plain dark box
        return PlainBox


class PlainBox:
    def __init__(self, widget, radius=12, fps=30):
        self.backdrop = None
        widget.set_app_paintable(True)
        widget.connect('draw', self.draw)

    @staticmethod
    def draw(_w, cr):
        cr.set_source_rgba(0, 0, 0, 0.94)
        cr.paint()
        return False


def run_overlay(start_mode):
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

    import threading
    shot = grab_screen()
    # the window list takes ~30 xprop calls: read it while the overlay is being built
    windows = []
    finder = threading.Thread(target=lambda: windows.extend(visible_windows()), daemon=True)
    finder.start()
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file(shot)
    finally:
        os.unlink(shot)
    W, H = pixbuf.get_width(), pixbuf.get_height()
    Snow = load_snow()
    import cairo
    # the screenshot as cairo surfaces, made once (converting the pixbuf on every mouse move
    # was the slow part of drawing): the full picture, and the dimmed one behind the selection
    full = Gdk.cairo_surface_create_from_pixbuf(pixbuf, 1, None)
    dim = cairo.ImageSurface(cairo.FORMAT_RGB24, W, H)
    c = cairo.Context(dim)
    c.set_source_surface(full, 0, 0)
    c.paint()
    c.set_source_rgba(0, 0, 0, 0.45)
    c.paint()
    del c
    cursors = {}
    display = Gdk.Display.get_default()
    mon = display.get_primary_monitor() or display.get_monitor(0)
    prim = mon.get_geometry()

    HANDLE = 7

    class Overlay(Gtk.Window):
        def __init__(self):
            super().__init__(type=Gtk.WindowType.POPUP)
            self.move(0, 0)
            self.set_default_size(W, H)
            self.resize(W, H)
            self.mode = start_mode          # 'region' or 'window'
            self.sel = None                 # (x, y, w, h)
            self.hover = None               # window rect under the pointer
            self.drag = None                # ('new'|'move'|edge string, start x, y, sel at start)
            self.result = None

            ov = Gtk.Overlay()
            self.add(ov)
            self.area = Gtk.DrawingArea()
            self.area.set_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                                 | Gdk.EventMask.POINTER_MOTION_MASK)
            self.area.connect('draw', self.on_draw)
            self.area.connect('button-press-event', self.on_press)
            self.area.connect('button-release-event', self.on_release)
            self.area.connect('motion-notify-event', self.on_motion)
            ov.add(self.area)

            bar = Gtk.Box(spacing=4)
            bar.get_style_context().add_class('zshot-bar')
            self.mode_btns = {}
            group = None
            for key, label in (('screen', 'Screen'), ('window', 'Window'), ('region', 'Region')):
                b = Gtk.RadioButton.new_with_label_from_widget(group, label)
                b.set_mode(False)
                group = group or b
                b.connect('toggled', self.on_mode, key)
                self.mode_btns[key] = b
                bar.add(b)
            bar.add(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL, margin_start=6, margin_end=6))
            # the key on the button itself (it was only in a tooltip)
            for label, cb, tip in (('Copy  Ctrl+C', lambda b: self.done(save=False),
                                    'to the clipboard only, no file kept'),
                                   ('Save  Enter', lambda b: self.done(save=True),
                                    'to ~/Pictures/Screenshots, and on the clipboard'),
                                   ('Cancel  Esc', lambda b: self.cancel(), None)):
                b = Gtk.Button(label=label, tooltip_text=tip)
                if label.startswith('Save'):
                    b.get_style_context().add_class('suggested-action')
                b.connect('clicked', cb)
                bar.add(b)
            self.hint = Gtk.Label()
            self.hint.get_style_context().add_class('zshot-hint')
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            col.add(self.hint)
            col.add(bar)
            self.bar = col
            self.snow = [Snow(bar, radius=10), Snow(self.hint, radius=8)]
            ov.add_overlay(col)
            ov.connect('get-child-position', self.place_bar)

            css = Gtk.CssProvider()
            css.load_from_data(b'''
                .zshot-bar { background: none; padding: 6px; }       /* Snow paints the black */
                .zshot-hint { color: #d8d8de; background: none; padding: 4px 10px;
                              text-shadow: -1.2px 0 rgba(255,42,74,0.65), 1.2px 0 rgba(25,230,255,0.65); }
            ''')
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.connect('key-press-event', self.on_key)
            self.connect('realize', lambda w: w.get_window().set_cursor(
                Gdk.Cursor.new_from_name(display, 'crosshair')))
            self.show_all()
            self.mode_btns[self.mode].set_active(True)
            self.update_hint()
            GLib.idle_add(self.grab)

        def grab(self):
            seat = display.get_default_seat()
            for _ in range(20):         # Openbox may still hold the key that started us
                if seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True,
                             None, None, None) == Gdk.GrabStatus.SUCCESS:
                    break
                time.sleep(0.05)
            return False

        def place_bar(self, ov, child, alloc):
            if child is not self.bar:
                return False
            _, nat = child.get_preferred_size()
            alloc.width, alloc.height = nat.width, nat.height
            alloc.x = prim.x + (prim.width - nat.width) // 2
            # keep the bar out of the way of a selection at the bottom
            alloc.y = prim.y + prim.height - nat.height - 28
            if self.sel and self.sel[1] + self.sel[3] > alloc.y - 10:
                alloc.y = prim.y + 28
            return True

        # -- state
        def update_hint(self):
            if self.mode == 'window':
                t = 'Click a window to select it  ·  Esc cancels'
            elif self.sel:
                t = 'drag the edges to adjust  ·  Enter or double-click saves  ·  Ctrl+C copies'
                # (the size shows once, next to the selection)
            else:
                t = 'Drag to select an area  ·  click a window  ·  Space selects the whole screen'
            self.hint.set_text(t)

        def on_mode(self, btn, key):
            if not btn.get_active():
                return
            if key == 'screen':
                self.sel = (0, 0, W, H)
                self.mode = 'region'
            else:
                self.mode = key
                if key == 'window':
                    self.sel = None
            self.update_hint()
            self.area.queue_draw()
            self.bar.queue_resize()

        def window_at(self, x, y):
            finder.join()                   # ready long before the first click, in practice
            return next((r for r in windows
                         if r[0] <= x < r[0] + r[2] and r[1] <= y < r[1] + r[3]), None)

        def edge_at(self, x, y):
            if not self.sel:
                return None
            sx, sy, sw, sh = clamp(self.sel, W, H)
            near = lambda a, b: abs(a - b) <= HANDLE
            e = ''
            if sx - HANDLE <= x <= sx + sw + HANDLE and sy - HANDLE <= y <= sy + sh + HANDLE:
                e += 'n' if near(y, sy) else 's' if near(y, sy + sh) else ''
                e += 'w' if near(x, sx) else 'e' if near(x, sx + sw) else ''
                if not e and sx < x < sx + sw and sy < y < sy + sh:
                    return 'move'
            return e or None

        # -- mouse
        def on_press(self, _w, ev):
            if ev.button == 3:
                self.cancel()
                return True
            if ev.button != 1:
                return False
            if ev.type == Gdk.EventType._2BUTTON_PRESS:
                if self.sel:
                    self.done(save=True)
                return True
            if self.mode == 'window':
                r = self.window_at(ev.x, ev.y)
                if r:                       # selected; Enter / Save / double-click, or Ctrl+C / Copy
                    self.select(r)
                return True
            what = self.edge_at(ev.x, ev.y) or 'new'
            self.drag = (what, ev.x, ev.y, self.sel and clamp(self.sel, W, H))
            return True

        def on_motion(self, _w, ev):
            x, y = ev.x, ev.y
            if not self.drag:
                if self.mode == 'window' or not self.sel:
                    r = self.window_at(x, y)
                    if r != self.hover:
                        self.hover = r
                        self.area.queue_draw()
                e = self.edge_at(x, y) if self.mode == 'region' else None
                names = {'move': 'move', 'n': 'n-resize', 's': 's-resize', 'e': 'e-resize',
                         'w': 'w-resize', 'ne': 'ne-resize', 'nw': 'nw-resize',
                         'se': 'se-resize', 'sw': 'sw-resize'}
                name = names.get(e, 'crosshair')
                if name not in cursors:
                    cursors[name] = Gdk.Cursor.new_from_name(display, name)
                if getattr(self, 'cursor', None) != name:
                    self.cursor = name
                    self.get_window().set_cursor(cursors[name])
                return True
            what, x0, y0, s0 = self.drag
            if what == 'new':
                if abs(x - x0) > 3 or abs(y - y0) > 3:
                    self.sel = (x0, y0, x - x0, y - y0)
                    self.hover = None
            elif what == 'move':
                sx, sy, sw, sh = s0
                nx = min(max(0, sx + x - x0), W - sw)
                ny = min(max(0, sy + y - y0), H - sh)
                self.sel = (nx, ny, sw, sh)
            else:
                sx, sy, sw, sh = s0
                x1, y1 = sx + sw, sy + sh
                if 'w' in what:
                    sx = x
                if 'e' in what:
                    x1 = x
                if 'n' in what:
                    sy = y
                if 's' in what:
                    y1 = y
                self.sel = (sx, sy, x1 - sx, y1 - sy)
            self.update_hint()
            self.area.queue_draw()
            self.bar.queue_resize()
            return True

        def on_release(self, _w, ev):
            if ev.button != 1 or not self.drag:
                return False
            what = self.drag[0]
            self.drag = None
            if what == 'new' and (not self.sel or abs(self.sel[2]) <= 3 or abs(self.sel[3]) <= 3):
                # a click, not a drag: take the window under the pointer
                r = self.window_at(ev.x, ev.y)
                self.sel = r if r else None
                if r:
                    self.select(r)
                    return True
            if self.sel:
                self.sel = clamp(self.sel, W, H)
                self.mode_btns['region'].set_active(True)
            self.update_hint()
            self.area.queue_draw()
            return True

        def select(self, rect):
            """a window or the whole screen picked: it is selected (edges can still be dragged);
            Save / Enter / double-click or Copy / Ctrl+C take it"""
            self.sel = clamp(rect, W, H)
            self.hover = None
            self.mode_btns['region'].set_active(True)
            self.update_hint()
            self.area.queue_draw()

        # -- keys
        def on_key(self, _w, ev):
            k = Gdk.keyval_name(ev.keyval)
            ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
            if k == 'Escape':
                self.cancel()
            elif k in ('Return', 'KP_Enter'):
                self.done(save=True)
            elif k == 'space':
                self.select((0, 0, W, H))
            elif ctrl and k in ('c', 'C'):
                self.done(save=False)
            else:
                return False
            return True

        # -- drawing
        def on_draw(self, _w, cr):
            cr.set_source_surface(dim, 0, 0)
            cr.paint()
            rect = clamp(self.sel, W, H) if self.sel else self.hover
            if not rect:
                return False
            x, y, w, h = rect
            cr.save()
            cr.rectangle(x, y, w, h)
            cr.clip()
            cr.set_source_surface(full, 0, 0)
            cr.paint()
            cr.restore()
            cr.set_line_width(2)
            cr.set_dash([])
            if self.sel:
                cr.set_source_rgb(*CYAN)
                cr.rectangle(x + 1, y + 1, w - 2, h - 2)
                cr.stroke()
                for hx in (x, x + w / 2, x + w):
                    for hy in (y, y + h / 2, y + h):
                        if (hx, hy) != (x + w / 2, y + h / 2):
                            cr.rectangle(hx - 4, hy - 4, 8, 8)
                cr.fill()
                label = f'{w} × {h}'
                cr.select_font_face(FONT)
                cr.set_font_size(13)
                ext = cr.text_extents(label)
                lx, ly = x + 4, (y - 8 if y > 26 else y + h + 20)
                cr.set_source_rgba(0, 0, 0, 0.7)
                cr.rectangle(lx - 4, ly - ext.height - 5, ext.width + 10, ext.height + 10)
                cr.fill()
                cr.set_source_rgb(*FG)
                cr.move_to(lx + 1, ly)
                cr.show_text(label)
            else:                       # window under the pointer, before any drag
                cr.set_source_rgba(*CYAN, 0.9)
                cr.set_dash([6, 4])
                cr.rectangle(x + 1, y + 1, w - 2, h - 2)
                cr.stroke()
            return False

        # -- end
        def done(self, save):
            rect = self.sel or (0, 0, W, H)
            self.result = (rect, save)
            self.close_overlay()

        def cancel(self):
            self.result = None
            self.close_overlay()

        def close_overlay(self):
            display.get_default_seat().ungrab()
            self.destroy()
            Gtk.main_quit()

    win = Overlay()
    Gtk.main()
    if win.result:
        rect, save = win.result
        finish(pixbuf, rect, save)


def run_direct(which):
    import gi
    gi.require_version('GdkPixbuf', '2.0')
    from gi.repository import GdkPixbuf
    shot = grab_screen()
    try:
        pixbuf = GdkPixbuf.Pixbuf.new_from_file(shot)
    finally:
        os.unlink(shot)
    rect = (0, 0, pixbuf.get_width(), pixbuf.get_height())
    if which == 'window':
        rect = active_window_rect() or rect
    finish(pixbuf, rect)


def main():
    ap = argparse.ArgumentParser(prog='zorro-shot')
    g = ap.add_mutually_exclusive_group()
    g.add_argument('--region', action='store_true', help='overlay, region mode')
    g.add_argument('--window', action='store_true', help='active window, no overlay')
    g.add_argument('--full', action='store_true', help='whole screen, no overlay')
    g.add_argument('--notify', nargs=2, metavar=('FILE', 'SIZE'), help=argparse.SUPPRESS)
    g.add_argument('--serve', metavar='FILE', help=argparse.SUPPRESS)
    ap.add_argument('--temp', action='store_true', help=argparse.SUPPRESS)
    a = ap.parse_args()
    if a.serve:
        serve_clipboard(a.serve, a.temp)
    elif a.notify:
        cmd_notify(*a.notify)
    elif a.window:
        run_direct('window')
    elif a.full:
        run_direct('full')
    else:
        run_overlay('region')


if __name__ == '__main__':
    main()
