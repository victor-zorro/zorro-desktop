#!/usr/bin/python3
"""Open every page of the Settings apps once, in a private test screen, and measure it
(RULES.md: every page opens, fits one screen, has at most 8 controls).

  tools/check-pages            the table; exit 1 when a page fails to open
  tools/check-pages --strict   also exit 1 when a page is too tall or has too many controls

Needs Xvfb (apt install xvfb, or XVFB=/path/to/Xvfb). Nothing shows on your screen, and
the apps run with an empty test home, so none of your settings are read or changed.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RUNNER = ROOT / 'tools' / 'pages_runner.py'
MAX_HEIGHT, MAX_CONTROLS = 560, 8
DISPLAY = ':87'


def xvfb():
    return os.environ.get('XVFB') or shutil.which('Xvfb')


def run_pages(home):
    env = {k: v for k, v in os.environ.items() if k not in ('DISPLAY', 'WAYLAND_DISPLAY', 'DBUS_SESSION_BUS_ADDRESS')}
    run = Path(home) / 'run'
    run.mkdir(mode=0o700)
    env.update(HOME=home, XDG_RUNTIME_DIR=str(run), DISPLAY=DISPLAY, GDK_BACKEND='x11',
               XDG_CONFIG_HOME=f'{home}/.config', XDG_DATA_HOME=f'{home}/.local/share',
               XDG_STATE_HOME=f'{home}/.local/state', XDG_CACHE_HOME=f'{home}/.cache')
    screen = subprocess.Popen([xvfb(), DISPLAY, '-screen', '0', '1920x1080x24', '-nolisten', 'tcp'],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        time.sleep(1)
        out = subprocess.run(['dbus-run-session', sys.executable, str(RUNNER)], env=env,
                             capture_output=True, text=True, timeout=180)
    finally:
        screen.terminate()
        screen.wait(5)
    lines = [x for x in out.stdout.splitlines() if x.startswith('{')]
    return (json.loads(lines[-1]) if lines else None), out.stderr[-2000:]


def main():
    if not xvfb():
        print('Xvfb not found: apt install xvfb, or set XVFB=/path/to/Xvfb')
        return 2
    with tempfile.TemporaryDirectory(prefix='zorro-pages-') as home:
        result, err = run_pages(home)
    if result is None:
        print('the apps did not start:\n' + err)
        return 1
    bad = over = 0
    for p in result['pages']:
        marks = []
        if p.get('error'):
            bad += 1
            marks.append('DOES NOT OPEN: ' + p['error'])
        else:
            if p['height'] > MAX_HEIGHT:
                marks.append(f'too tall ({p["height"]} px)')
            if p['controls'] > MAX_CONTROLS:
                marks.append(f'{p["controls"]} controls')
            over += bool(marks)
        print(f'{p["app"]:8} {p["menu"]:9} {p["id"]:11} {p["title"][:26]:26} {"; ".join(marks) or "ok"}')
    print(f'{len(result["pages"])} pages: {bad} do not open, {over} over a design limit')
    return 1 if bad or ('--strict' in sys.argv and over) else 0


if __name__ == '__main__':
    sys.exit(main())
