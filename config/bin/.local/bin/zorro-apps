#!/usr/bin/env python3
"""zorro-apps: the extra apps you can add after the minimal setup (extras/apps.json).

  zorro-apps                   list them, with ✓ for installed
  zorro-apps --json            the same as JSON (for the Zorro settings app)
  zorro-apps install ID [FILE] install one (FILE: the download, for a manual app)

The install itself is extras/<id>/install.sh, run as you; it asks for your password when it
needs root. Settings → Desktop → Install apps does the same with tick boxes."""
import glob
import json
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(os.path.realpath(__file__)).parents[4]     # config/bin/.local/bin/zorro-apps
EXTRAS = REPO / 'extras'


def apps():
    out = []
    for a in json.loads((EXTRAS / 'apps.json').read_text())['apps']:
        a = dict(a)
        a['is_installed'] = os.path.exists(os.path.expanduser(a.get('installed', '/nonexistent')))
        a['script'] = str(EXTRAS / a['id'] / 'install.sh')
        if a.get('how') == 'manual' and a.get('file'):
            found = sorted(glob.glob(os.path.expanduser('~/Downloads/' + a['file'])), key=os.path.getmtime)
            a['found'] = found[-1] if found else None
        out.append(a)
    return out


def run(a, extra):
    """the install script, its output to ours and to ~/.cache/zorro-apps/ID.log; it keeps
    going when whoever reads our output goes away (Settings closed mid-install)"""
    log_dir = Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) / 'zorro-apps'
    log_dir.mkdir(parents=True, exist_ok=True)
    with open(log_dir / f"{a['id']}.log", 'wb') as log:
        p = subprocess.Popen([a['script'], *extra], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL)
        out = sys.stdout.buffer
        while True:
            chunk = os.read(p.stdout.fileno(), 4096)
            if not chunk:
                break
            log.write(chunk)
            log.flush()
            if out:
                try:
                    out.write(chunk)
                    out.flush()
                except (BrokenPipeError, OSError):
                    out = None              # nobody listens any more: the log still gets it
        return p.wait()


def main():
    args = sys.argv[1:]
    if args[:1] in (['-h'], ['--help']):
        print(__doc__.strip())
        return 0
    if args[:1] == ['--json']:
        print(json.dumps(apps()))
        return 0
    if args[:1] == ['install'] and len(args) >= 2:
        a = next((x for x in apps() if x['id'] == args[1]), None)
        if not a:
            print(f'zorro-apps: no app "{args[1]}" (see: zorro-apps)', file=sys.stderr)
            return 2
        return run(a, args[2:3])
    for a in apps():
        mark = '✓' if a['is_installed'] else ' '
        extra = f"  (download first: {a['download']})" if a.get('how') == 'manual' and not a['is_installed'] else ''
        print(f"{mark} {a['id']:16} {a['name']}: {a['about']} · {a['size']}{extra}")
    return 0


if __name__ == '__main__':
    sys.exit(main())
