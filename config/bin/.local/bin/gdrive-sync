#!/usr/bin/env bash
# Two-way sync of the folders in ~/.config/gdrive-sync/folders.list
#   gdrive-sync          sync all folders
#   gdrive-sync --resync force a fresh baseline (after errors or big changes)
set -uo pipefail
LIST="$HOME/.config/gdrive-sync/folders.list"
LOCAL_ROOT="$HOME/DriveOffline"
STATE="$HOME/.local/state/gdrive-sync"
mkdir -p "$LOCAL_ROOT" "$STATE"

fail=0
while IFS= read -r folder || [[ -n $folder ]]; do
  folder="${folder%/}"
  [[ -z $folder || $folder == \#* ]] && continue
  local_dir="$LOCAL_ROOT/$folder"
  marker="$STATE/$(printf '%s' "$folder" | sha1sum | cut -c1-16)"
  mkdir -p "$local_dir"

  extra=()
  if [[ ! -f $marker || ${1:-} == --resync ]]; then
    extra=(--resync)   # first run: build the baseline
  fi

  echo "==> $folder"
  if rclone bisync "gdrive:$folder" "$local_dir" "${extra[@]}" \
       --create-empty-src-dirs --drive-skip-gdocs \
       --resilient --recover --max-lock 2m \
       --conflict-resolve newer --conflict-loser num; then
    touch "$marker"
  else
    fail=1
    notify-send -u critical "Drive sync failed" "$folder — run: gdrive-sync --resync" 2>/dev/null || true
  fi
done < "$LIST"
exit $fail
