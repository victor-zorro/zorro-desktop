#!/usr/bin/env bash
# The free DaVinci Resolve on Linux can't open H.264/H.265 (phones, most cameras) or AAC
# audio. This makes an edit-friendly copy next to each file: DNxHR HQ video + PCM audio.
#   zresolve-convert clip1.mp4 clip2.mov ...   ->  clip1_resolve.mov ...
set -euo pipefail
[[ $# -gt 0 ]] || { echo "usage: zresolve-convert FILE..."; exit 1; }
for f in "$@"; do
  out="${f%.*}_resolve.mov"
  if [[ -e $out ]]; then echo "skip (exists): $out"; continue; fi
  echo "==> $out"
  ffmpeg -hide_banner -loglevel warning -stats -i "$f" \
    -c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p -c:a pcm_s16le "$out"
done
