#!/usr/bin/env bash
# WhatsApp Web in its own Firefox profile and window (class WhatsApp).
# Already open? Pull that window to the current desktop instead of starting a second one.
if command -v wmctrl >/dev/null && wmctrl -lx | awk '$3 ~ /\.WhatsApp$/ {f=1} END {exit !f}'; then
  exec wmctrl -x -R WhatsApp
fi
P="$HOME/.local/share/firefox-whatsapp"
mkdir -p "$P"
cat > "$P/user.js" <<'PREFS'
user_pref("browser.startup.page", 1);
user_pref("browser.startup.homepage", "https://web.whatsapp.com");
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.tabs.warnOnClose", false);
PREFS
exec firefox --new-instance --class WhatsApp --profile "$P" https://web.whatsapp.com
