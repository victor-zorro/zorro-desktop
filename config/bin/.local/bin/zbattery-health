#!/usr/bin/env bash
# Battery health = full capacity now / design capacity, plus charge cycles
B=/sys/class/power_supply/BAT0
[[ -d $B ]] || exit 0
if   [[ -f $B/energy_full ]]; then now=$(<"$B/energy_full"); new=$(<"$B/energy_full_design")
elif [[ -f $B/charge_full ]]; then now=$(<"$B/charge_full"); new=$(<"$B/charge_full_design")
else exit 0; fi
cycles=$(cat "$B/cycle_count" 2>/dev/null || echo "?")
echo "Health   $(( now * 100 / new ))%  ($cycles cycles)"
