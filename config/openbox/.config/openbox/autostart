# Openbox autostart (shared across machines)
# Machine-specific items only start when the tool is installed.

gnome-keyring-daemon --start --components=secrets &
# Window theme, compositor (picom) and kitty opacity from the Zorro app; before the
# indicator below, which picks real or faked transparency when it starts
command -v zorro-settings >/dev/null && zorro-settings --apply-windows --login
# the second and third screen where you put them (System → Hardware → Screens)
command -v zorro-settings >/dev/null && zorro-settings --apply-screens
lxpolkit &
dunst &
# Lock before sleep and when the screen blanks: zorro lock screen, else LightDM's
if command -v zorro-lock >/dev/null; then
  xss-lock -l -- zorro-lock &
else
  xss-lock -- dm-tool lock &
fi

# ThinkPad: volume/brightness indicator + keys X cannot see (apps/zorro-thinkpad)
[ -d /sys/devices/platform/thinkpad_acpi ] && command -v zorro-thinkpad >/dev/null \
  && zorro-thinkpad keyd &

command -v spice-vdagent >/dev/null && spice-vdagent &   # VM only
(sleep 3 && "$HOME/.local/bin/google-apps") &
(sleep 4 && "$HOME/.local/bin/whatsapp") &
# Super tapped alone = Super+Space (the dial launcher); Super with other keys stays Super
command -v xcape >/dev/null && xcape -e 'Super_L=Super_L|space' &
# the Dialer stays loaded, so Super shows it at once (apps/zorro-dial)
command -v zorro-dial >/dev/null && zorro-dial --daemon &
# Same white Lucide icons on every window (Alt+Tab, window menu)
command -v zorro-winicons >/dev/null && zorro-winicons &
command -v zorro-winpos >/dev/null && zorro-winpos &      # windows reopen where they were
# Living wallpaper first, so the info circle lands on top of it
command -v zorro-wall >/dev/null && zorro-wall &
# Info circle (apps/zorro-orb) replaces conky; conky stays as fallback
if command -v zorro-orb >/dev/null; then
  (sleep 1 && zorro-orb) &
else
  (sleep 2 && conky -d) &
fi
