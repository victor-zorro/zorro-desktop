# Openbox autostart (shared across machines)
# Machine-specific items only start when the tool is installed.

gnome-keyring-daemon --start --components=secrets &
lxpolkit &
dunst &
# Lock before sleep and when the screen blanks: zorro lock screen, else LightDM's
if command -v zorro-lock >/dev/null; then
  xss-lock -l -- zorro-lock &
else
  xss-lock -- dm-tool lock &
fi

command -v spice-vdagent >/dev/null && spice-vdagent &   # VM only
(sleep 3 && "$HOME/.local/bin/google-apps") &
(sleep 4 && "$HOME/.local/bin/whatsapp") &
(sleep 2 && conky -d) &
