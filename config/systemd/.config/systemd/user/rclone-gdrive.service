[Unit]
Description=Google Drive (rclone mount at ~/GoogleDrive)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
  --vfs-cache-mode full --vfs-cache-max-age 72h --vfs-cache-max-size 20G \
  --dir-cache-time 5m --poll-interval 1m
ExecStop=/bin/fusermount3 -u %h/GoogleDrive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
